// Use a JSONC file for comments
{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",

  // Inherit all rules from the base .markdownlint.json file.
  // This is the recommended setup.
  "extends": "./.markdownlint.json",

  // Globs for files to lint are specified here for the CLI runner
  "globs": [
    "**/*.md"
  ],

  // Ignore node_modules, which is a default but good to be explicit
  "ignores": [
    "node_modules",
    "legacy",
    "README.md"
  ]
}
