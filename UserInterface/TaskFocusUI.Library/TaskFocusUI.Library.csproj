<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeSymbols>True</IncludeSymbols>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x86</Platforms>
    <!--<OutputType>Library</OutputType>-->
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned to 14.x because 15+ needs a commercial license. The known DoS advisories require attacker-controlled object graphs. TaskFocus maps a fixed set of application and display models. -->
    <PackageReference Include="AutoMapper" Version="14.0.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.23" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.23" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>