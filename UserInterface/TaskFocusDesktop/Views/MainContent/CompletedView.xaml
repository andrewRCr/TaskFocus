<UserControl x:Class="TaskFocusDesktop.Views.MainContent.CompletedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.MainContent" 
             xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:components="clr-namespace:TaskFocusDesktop.Views.Components" 
             xmlns:maincontent="clr-namespace:TaskFocusDesktop.ViewModels.MainContent" 
             d:DataContext="{d:DesignInstance Type=maincontent:CompletedViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Style="{StaticResource BaseMainContentViewStyle}">
    
    <Grid x:Name="MainGridBackground" 
          Focusable="True" 
          Background="Transparent" 
          PreviewMouseDown="MainGridBackground_PreviewMouseDown">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- view title -->
        <StackPanel Grid.Row="0"
                   Orientation="Horizontal"
                   Margin="10 10 0 15"
                   >

            <materialDesign:PackIcon Kind="Inbox"
                                    VerticalAlignment="Center"
                                    Margin="10 0 10 0"
                                    Foreground="{StaticResource ForegroundMainBrush}"
                                    Height="24"
                                    Width="24"
                                    />

            <TextBlock Style="{StaticResource HeaderTextStyle}"
                      VerticalAlignment="Center" Margin="0 2 0 0"
                      Text="COMPLETED" />

        </StackPanel>

        <WrapPanel Grid.Row="1" 
                   Margin="60 0 0 0"
                   Visibility="{Binding ShowEmptyTaskListTutorialText, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" >

            <materialDesign:Card  
                             materialDesign:ElevationAssist.Elevation="Dp6"
                             Width="800"
                             Padding="8"
                             Background="{StaticResource BackgroundLightGreyBrush}"
                             >
                <TextBlock TextWrapping="Wrap"
                           FontSize="16" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center"
                           utilities:TextBlockHelper.TrimRuns="True" >

                    <TextBlock.Inlines>
                        <Run Text="Completed tasks will appear here until deleted."/>
                        <LineBreak />
                        <Run Text="Adjust automatic deletion interval in Settings (current:  " />
                        <Run FontWeight="Bold" Text="{Binding CurrentDeletionIntervalSettingStr}" />
                        <Run  Text=")." />
                        <LineBreak />
                        <LineBreak />
                        <Run Text="Completed tasks will also remain displayed in other views, until cleaned up." />
                        <LineBreak />
                        <Run Text="Adjust automatic clean up interval in Settings (current:  " />
                        <Run FontWeight="Bold" Text="{Binding CurrentCleanUpIntervalSettingStr}" />
                        <Run Text=")." />
                    </TextBlock.Inlines>
                </TextBlock>

            </materialDesign:Card>

        </WrapPanel>

        <components:TaskItemContainerView Grid.Row="1"
                                          Margin="15 0 0 0"
                                          CanReorder="False"
                                          />

    </Grid>
</UserControl>
