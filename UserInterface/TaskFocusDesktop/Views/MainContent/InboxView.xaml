<UserControl x:Class="TaskFocusDesktop.Views.MainContent.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.MainContent" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:components="clr-namespace:TaskFocusDesktop.Views.Components"
             xmlns:viewmodels="clr-namespace:TaskFocusDesktop.ViewModels.MainContent" 
             xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities" 
             d:DataContext="{d:DesignInstance Type=viewmodels:InboxViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Style="{StaticResource BaseMainContentViewStyle}" >

    <Grid x:Name="MainGridBackground" 
          Focusable="True" 
          Background="Transparent" 
          PreviewMouseDown="MainGridBackground_PreviewMouseDown" >

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /> <!-- TEMPORARY FOR DEBUG LINES -->
        </Grid.RowDefinitions>

        <!-- view title -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="10 10 0 15"
                    >

            <materialDesign:PackIcon Kind="Inbox"
                                     VerticalAlignment="Center"
                                     Margin="10 0 10 0"
                                     Foreground="{StaticResource ForegroundMainBrush}"
                                     Height="24"
                                     Width="24"
                                     />

            <TextBlock Style="{StaticResource HeaderTextStyle}"
                       VerticalAlignment="Center" Margin="0 2 0 0"
                       Text="INBOX" />

        </StackPanel>

        <WrapPanel Grid.Row="1" 
                   Margin="60 0 0 0"
                   Visibility="{Binding ShowEmptyTaskListTutorialText, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" >

            <materialDesign:Card  
                             materialDesign:ElevationAssist.Elevation="Dp6"
                             Width="800"
                             Padding="12"
                             Background="{StaticResource BackgroundLightGreyBrush}"
                             >
                <TextBlock TextWrapping="Wrap"
                           FontSize="16" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center"
                           utilities:TextBlockHelper.TrimRuns="True" >

                    <TextBlock.Inlines>
                        <Run Text="Tasks that have not yet been assigned  "/>
                        <Run FontWeight="Bold" Text="both" />
                        <Run Text="  a Project  " />
                        <Run FontWeight="Bold" Text="and" />
                        <Run Text="  Context will appear here." />
                    </TextBlock.Inlines>
                </TextBlock>

            </materialDesign:Card>

        </WrapPanel>

        <ScrollViewer  Grid.Row="1"  
                       MaxHeight="{Binding MaxTaskScrollHeight}"
                       VerticalScrollBarVisibility="Disabled" >

            <!-- inbox tasks -->
            <components:TaskItemContainerView Grid.Row="1"
                                          Margin="15 0 0 0"
                                          CanReorder="True"
                                          OrderingIndex="{Binding OrderingIndex}"
                                          ContainerTasks="{Binding LocalTasks}"
                                          ListBoxHeight ="{Binding ListBoxHeight}"
                                          />

        </ScrollViewer>

        <!-- debug -->
        <!--<StackPanel Orientation="Vertical" Grid.Row="2"  >

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="AppWindowHeight: " />
                <TextBlock Text="{Binding AppWindowHeight}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="MaxTaskScrollHeight: " />
                <TextBlock Text="{Binding MaxTaskScrollHeight}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ListBoxHeight: " />
                <TextBlock Text="{Binding ListBoxHeight}" />
            </StackPanel>

        </StackPanel>-->

    </Grid>

</UserControl>
