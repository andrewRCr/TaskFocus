<UserControl x:Class="TaskFocusDesktop.Views.MainContent.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.MainContent" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:components="clr-namespace:TaskFocusDesktop.Views.Components"
             xmlns:viewmodels="clr-namespace:TaskFocusDesktop.ViewModels.MainContent" 
             d:DataContext="{d:DesignInstance Type=viewmodels:InboxViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Style="{StaticResource BaseMainContentViewStyle}" >

    <Grid x:Name="MainGridBackground" Focusable="True" Background="Transparent" PreviewMouseDown="MainGridBackground_PreviewMouseDown">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- view title -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="10 10 0 15"
                    >

            <materialDesign:PackIcon Kind="Inbox"
                                     VerticalAlignment="Center"
                                     Margin="10 0 10 0"
                                     Foreground="{StaticResource ForegroundMainBrush}"
                                     Height="24"
                                     Width="24"
                                     />

            <TextBlock Style="{StaticResource HeaderTextStyle}"
                       VerticalAlignment="Center" Margin="0 2 0 0"
                       Text="INBOX" />

        </StackPanel>


        <!-- inbox tasks -->
        <components:TaskItemContainerView Grid.Row="1"
                                          Margin="15 0 0 0"
                                          CanReorder="True"
                                          OrderingIndex="{Binding OrderingIndex}"
                                          />

        <!-- new task entry -->
        <!--<ListBox 
                 ItemsSource="{Binding Path=NewTaskList}"
                 ItemTemplate="{StaticResource NewTaskItem}"
                 SelectedItem="{Binding NewTask }"
                 Grid.Row="3" Grid.Column="0"
                 Grid.ColumnSpan="2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

        <Button Grid.Row="4" x:Name="AddTask" Content="Add" />-->

        <!-- manually call update of all view task data to API -->
        <!--<Button Grid.Row="5" Grid.Column="2" x:Name="UpdateAllPendingTaskData" Content="Sync" />-->


    </Grid>

</UserControl>
