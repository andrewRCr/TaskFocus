<UserControl x:Class="TaskFocusDesktop.Views.MainContent.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.MainContent" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:customControls="clr-namespace:TaskFocusDesktop.CustomControls" 
             xmlns:maincontent="clr-namespace:TaskFocusDesktop.ViewModels.MainContent" 
             xmlns:base="clr-namespace:TaskFocusDesktop.ViewModels.Base" 
             d:DataContext="{d:DesignInstance Type=maincontent:HomeViewModel}"
             Style="{StaticResource BaseMainContentViewStyle}"
             >

    <UserControl.Resources>
        <Style x:Key="messageTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Resources>
    
    <Grid>

        <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp6"
                             VerticalAlignment="Top"
                             Margin="0 50 0 0"
                             Width="400"
                             Height="200"
                             Padding="8"
                             Background="{StaticResource BackgroundLightGreyBrush}"
                             >

            <StackPanel Orientation="Vertical"
                        VerticalAlignment="Center">

                <TextBlock Style="{StaticResource messageTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" >
                    <TextBlock.Inlines>
                        <Run Text="Welcome to" />
                        <Run Text="TaskFocus" Foreground="{StaticResource ForegroundHighlightBrush}" />
                    </TextBlock.Inlines>
                </TextBlock>

                <StackPanel Orientation="Vertical"
                            Visibility="{Binding ShowPleaseWaitLoginMessage, 
                            Converter={StaticResource BooleanToVisibilityConverter}, 
                            FallbackValue=Collapsed}" >

                    <TextBlock FontSize="14"                
                               Margin="0 4 0 0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" >
                        Logging you in, please wait...
                        <LineBreak />
                    </TextBlock>

                    <customControls:LoadingSpinner 
                                    EllipseSize="4" 
                                    HorizontalAlignment="Center" 
                                    Margin="4 8 4 4" 
                                    Height="20" 
                                    Width="20"/>

                </StackPanel>

            </StackPanel>

        </materialDesign:Card>

    </Grid>
</UserControl>
