<UserControl x:Class="TaskFocusDesktop.Views.MainContent.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.MainContent" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:customControls="clr-namespace:TaskFocusDesktop.CustomControls" 
             xmlns:maincontent="clr-namespace:TaskFocusDesktop.ViewModels.MainContent" 
             xmlns:base="clr-namespace:TaskFocusDesktop.ViewModels.Base" 
             d:DataContext="{d:DesignInstance Type=maincontent:HomeViewModel}"
             Style="{StaticResource BaseMainContentViewStyle}"
             xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities" 
             >

    <UserControl.Resources>
        <Style x:Key="messageTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
        </Style>
    </UserControl.Resources>
    
    <Grid>
    
        <StackPanel Orientation="Vertical"
                    Width="400"
                    Height="300"
                    VerticalAlignment="Top"
                    Margin="0 50 0 0"
                    >
            <TextBlock Text="NOT AUTHENTICATED" 
                       Style="{StaticResource HeaderTextStyle}"
                       HorizontalAlignment="Left"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ForegroundHighlightBrush}"
                       />

            <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp6"
                             VerticalAlignment="Top"
                             Margin="0 3 0 0"
                             Width="400"
                             Height="100"
                             Padding="8"
                             Background="{StaticResource BackgroundLightGreyBrush}"
                             >

                <StackPanel Orientation="Vertical"
                        VerticalAlignment="Center">

                    <!--<TextBlock Style="{StaticResource messageTextStyle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" >
                        <TextBlock.Inlines>
                            <Run Text="Welcome to" />
                            <Run Text="TaskFocus" Foreground="{StaticResource ForegroundHighlightBrush}" />
                        </TextBlock.Inlines>
                    </TextBlock>-->

                    <StackPanel Orientation="Vertical"
                            Visibility="{Binding ShowPleaseWaitLoginMessage, 
                            Converter={StaticResource BooleanToVisibilityConverter}, 
                            FallbackValue=Collapsed}" >

                        <TextBlock FontSize="14"                
                               Margin="0 4 0 0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" >
                        Logging you in, please wait...
                        <LineBreak />
                        </TextBlock>

                        <customControls:LoadingSpinner 
                                    EllipseSize="4" 
                                    HorizontalAlignment="Center" 
                                    Margin="4 8 4 4" 
                                    Height="20" 
                                    Width="20"/>

                    </StackPanel>

                    <StackPanel Orientation="Vertical"
                            Visibility="{Binding ShowPleaseWaitLoginMessage, 
                                         Converter={StaticResource InvertableBooleanToVisibilityConverter}, 
                                         ConverterParameter=Inverted, FallbackValue=Visible}" >

                        <TextBlock FontSize="14"                
                               Margin="0 10 0 0"
                               Visibility="{Binding ShowNotAuthenticatedMessage, 
                                            Converter={StaticResource BooleanToVisibilityConverter},
                                            FallbackValue=Visible}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" 
                               
                               utilities:TextBlockHelper.TrimRuns="True" TextAlignment="Center">

                            <TextBlock.Inlines>
                                <Run Text="Please log in to continue." />
                                <LineBreak />
                                <Run Text="New user? Click  " />

                                <Hyperlink Style="{StaticResource HyperLinkStyle}"
                                        NavigateUri="https://taskfocus.azurewebsites.net/register"
                                        RequestNavigate="Hyperlink_RequestNavigate" >here</Hyperlink>

                                <Run Text="  to register." />
                                <LineBreak />
                            </TextBlock.Inlines>

                        </TextBlock>

                    </StackPanel>

                </StackPanel>

            </materialDesign:Card>

            <StackPanel Orientation="Vertical"
                        Margin="0 10 0 0"
                        Visibility="{Binding ShowNotAuthenticatedMessage, 
                                     Converter={StaticResource BooleanToVisibilityConverter},
                                     FallbackValue=Visible}" >

                <Button Style="{StaticResource HyperlinkStyleButton}"
                        HorizontalAlignment="Center"
                        Visibility="{Binding ShowForgotPasswordToggle,
                                     Converter={StaticResource BooleanToVisibilityConverter},
                                     FallbackValue=Visible}"
                        Content="Forgot password?"
                        Foreground="{StaticResource ForegroundMainBrush}"
                        Command="{Binding ToggleShowForgotPasswordInput}"
                       />

                <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp6"
                             VerticalAlignment="Top"
                             Margin="0 10 0 0"
                             Width="400"
                             Height="100"
                             Padding="8"
                             Background="{StaticResource BackgroundLightGreyBrush}" 
                                     Visibility="{Binding ShowForgotPasswordInput, 
                                     Converter={StaticResource BooleanToVisibilityConverter},
                                     FallbackValue=Visible}">

                    <StackPanel Orientation="Vertical">

                        <Grid Margin="0 10 0 0">
                            
                            <TextBox x:Name="forgotPasswordEmailInput"
                                     Text="{Binding ForgotPasswordEmailAddress}"
                                     Width="200" 
                                     Height="25"
                                     VerticalAlignment="Top"
                                     Margin="0 5 0 0" />

                            <TextBlock x:Name="EmailInputPlaceholderText" 
                                       IsHitTestVisible="False"
                                       Text="Email Address" 
                                       FontSize="14"
                                       Foreground="{StaticResource ForegroundSecondaryBrush}"                           
                                       Padding="0 0 0 0"
                                       Margin="0 8 0 0" Width="200" Height="25" >

                                <TextBlock.Style>
                                    <Style>
                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=DataContext.ForgotPasswordEmailAddress, 
                                                                 Converter={StaticResource IsNullConverterInstance}, 
                                                                 ConverterParameter=IsNullOrWhiteSpace}" Value="False" >
                                                <DataTrigger.Setters>
                                                    <Setter Property="TextBlock.Visibility" Value="Hidden"/>
                                                </DataTrigger.Setters>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding ElementName=forgotPasswordEmailInput, Path=IsKeyboardFocusWithin}" Value="True" >
                                                <DataTrigger.Setters>
                                                    <Setter Property="TextBlock.Visibility" Value="Hidden"/>
                                                </DataTrigger.Setters>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>

                        </Grid>

                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Content="SEND RESET LINK"
                                Command="{Binding RequestSubmitForgotPasswordForm}"
                                Margin="0 8 0 0"
                                Width="150"
                                Foreground="{StaticResource ForegroundHighlightBrush}"
                            />
                    </StackPanel>

                </materialDesign:Card>

            </StackPanel>

            <TextBlock Text="{Binding FeedbackMessage}"
                       HorizontalAlignment="Center"
                       Margin="0 3 0 0"
                       >
                
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource ForegroundMainBrush}" />
                                                  
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFeedbackError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorRedBrush}" />
                        </DataTrigger>

                            <DataTrigger Binding="{Binding IsFeedbackError}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource ForegroundMainBrush}" />
                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </TextBlock.Style>
                
            </TextBlock>
        </StackPanel>
       

    </Grid>
</UserControl>
