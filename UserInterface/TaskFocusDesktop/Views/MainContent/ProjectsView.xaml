                        <components:TaskCollectionView CollectionId="{Binding Id}" 
                                                   IsProjectCollection="True"
                                                   CollectionName="{Binding ProjectName}"
                                                   CollectionTasks="{Binding DataContext.LocalTasks, 
                                                                     RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />

                    </DataTemplate>
                
                
                
                </ListBox.ItemTemplate>
            </ListBox>-->

    


    </Grid>
</UserControl>
