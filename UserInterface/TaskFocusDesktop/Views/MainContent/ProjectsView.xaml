<UserControl x:Class="TaskFocusDesktop.Views.MainContent.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.MainContent"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:components="clr-namespace:TaskFocusDesktop.Views.Components"
             xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities" 
             xmlns:maincontent="clr-namespace:TaskFocusDesktop.ViewModels.MainContent" 
             d:DataContext="{d:DesignInstance Type=maincontent:ProjectsViewModel}"
             d:DesignHeight="450" d:DesignWidth="800"
             Style="{StaticResource BaseMainContentViewStyle}" >

    <Grid x:Name="MainGridBackground" 
          Focusable="True" 
          Background="Transparent" 
          PreviewMouseDown="MainGridBackground_PreviewMouseDown">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- tutorialTextShown view title -->
        <StackPanel Grid.Row="0"
                    Visibility="{Binding ShowNoFocusedProjectTutorialText, 
                                         Converter={StaticResource BooleanToVisibilityConverter}, 
                                         FallbackValue=Collapsed}"
                    Orientation="Horizontal"
                    Margin="10 10 0 15" >
            
        </StackPanel>

        <WrapPanel Grid.Row="1"
                   Margin="60 0 0 0"
                   Visibility="{Binding ShowNoFocusedProjectTutorialText, 
                                        Converter={StaticResource BooleanToVisibilityConverter}, 
                                        FallbackValue=Collapsed}" >

            <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp6"
                                 Width="800"
                                 Padding="12"
                                 Background="{StaticResource BackgroundLightGreyBrush}" >
                
                <TextBlock TextWrapping="Wrap"
                   FontSize="16" 
                   HorizontalAlignment="Center" 
                   TextAlignment="Center"
                   utilities:TextBlockHelper.TrimRuns="True" >

                    <TextBlock.Inlines>
                        <Run Text="Group related or dependent tasks by creating and assigning  "/>
                        <Run FontWeight="Bold" Text="Projects" />
                        <Run Text=", which will appear here." />
                    </TextBlock.Inlines>
                </TextBlock>

            </materialDesign:Card>

        </WrapPanel>

        <Expander IsExpanded="True" Margin="0" 
                  Background="Transparent"
                  Visibility="{Binding ShowNoFocusedProjectTutorialText, 
                               Converter={StaticResource InvertableBooleanToVisibilityConverter}, 
                               ConverterParameter=Inverted, FallbackValue=Collapsed}" >

            <Expander.Header>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ClipboardText"
                                             VerticalAlignment="Center"
                                             Margin="0 0 0 0"
                                             Foreground="{StaticResource ForegroundMainBrush}"
                                             Height="24"
                                             Width="24" />

                    <TextBlock Text="{Binding FocusedProjectName}" 
                               Style="{StaticResource HeaderTextStyle}"
                               VerticalAlignment="Center"
                               Margin="10 0 0 0" />
                </StackPanel>

            </Expander.Header>

            <ScrollViewer Grid.Row="1"  
                          MaxHeight="{Binding MaxTaskScrollHeight}"
                          VerticalScrollBarVisibility="Disabled" >

                <components:TaskItemContainerView ContainerTasks="{Binding FocusedProjectTasks}" 
                                                  IsProjectContainer="True"
                                                  CanReorder="True"
                                                  ListBoxHeight="{Binding ListBoxHeight}"
                                                  OrderingIndex="{Binding OrderingIndex}" />

            </ScrollViewer>
            
        </Expander>

    </Grid>
</UserControl>
