<UserControl x:Class="TaskFocusDesktop.Views.MainContent.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.MainContent"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Style="{StaticResource BaseMainContentViewStyle}"
             >
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
     
        <!-- view title -->
        <TextBlock  Grid.Row="0"
                    Margin="5,5,0,50" 
                    FontSize="18">
            Projects
        </TextBlock>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ProjectNames}" />

    </Grid>
</UserControl>
