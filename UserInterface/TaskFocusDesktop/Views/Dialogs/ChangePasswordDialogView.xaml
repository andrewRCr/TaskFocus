<UserControl x:Class="TaskFocusDesktop.Views.Dialogs.ChangePasswordDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.Dialogs" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid Margin="10" Width="400" Height="250" >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal"   Margin="0,0,0,5">
                <materialDesign:PackIcon Kind="Edit" 
                                    Width="22" 
                                    Height="22" 
                                    VerticalAlignment="Center"
                                    Margin="0 0 10 0"
                                    Foreground="{StaticResource ForegroundMainBrush}"/>

                <TextBlock Text="{Binding HeaderText}"
                              Style="{StaticResource HeaderTextStyle}" 
                              FontSize="16"
                              VerticalAlignment="Center"
                              />

            </StackPanel>

            <!-- text input and feedback message -->
            <StackPanel Grid.Row="1" 
                       Margin="0 10 0 0"
                       Orientation="Vertical" 
                       HorizontalAlignment="Center" >

                <Grid >

                    <PasswordBox x:Name="NewPassword" 
                                 Style="{StaticResource MaterialDesignFloatingHintRevealPasswordBox}"
                                 materialDesign:PasswordBoxAssist.Password="{Binding NewPassword}"
                                 Width="275" 
                                 Margin="0 10 0 5"
                                 HorizontalAlignment="Center"
                                 FontSize="14"                              
                                 IsEnabled="True" >
                        
                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="New password" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                        
                    </PasswordBox>

                </Grid>

                <Grid >

                    <PasswordBox x:Name="ConfirmNewPassword" 
                                 Style="{StaticResource MaterialDesignFloatingHintRevealPasswordBox}"
                                 materialDesign:PasswordBoxAssist.Password="{Binding ConfirmNewPassword}"
                                 Width="275" 
                                 Margin="0 10 0 5"
                                 HorizontalAlignment="Center"
                                 FontSize="14"                                 
                                 IsEnabled="True" >

                        <materialDesign:HintAssist.Hint>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Confirm new password" />
                            </StackPanel>
                        </materialDesign:HintAssist.Hint>
                    </PasswordBox>

                </Grid>

                <ContentPresenter Margin="0 0 0 10"
                             HorizontalAlignment="Center"                                    
                             Content="{StaticResource FeedbackMessageContent}" />

            </StackPanel>

            <!-- submit / cancel buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" >

                <Button Content="_CANCEL"
                       Command="{Binding CloseDialogCommand}" 
                       Style="{StaticResource dialogCancelButtonStyle}"              
                       Margin="0 0 15 0" />

                <Button Content="_UPDATE" 
                       Command="{Binding ProcessSubmitActionCommand}"
                       Style="{StaticResource dialogSubmitButtonStyle}"  />

            </StackPanel>

        </Grid>

    </Grid>
</UserControl>
