<UserControl x:Class="TaskFocusDesktop.Views.Dialogs.NewTaskDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.Dialogs"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:dialogs="clr-namespace:TaskFocusDesktop.ViewModels.Dialogs"
             xmlns:vmBase="clr-namespace:TaskFocusDesktop.ViewModels.Base"
             xmlns:system="clr-namespace:System;assembly=netstandard" 
             xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities" 
             xmlns:components="clr-namespace:TaskFocusDesktop.Views.Components"
             d:DesignHeight="200" d:DesignWidth="1000">

    <UserControl.Resources>
        <utilities:IsNullConverter x:Key="IsNullConverterInstance"/>
    </UserControl.Resources>

    <Grid Width="1000" 
          Height="200"
          Background="{StaticResource BackgroundDarkGreyBrush}" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"   Margin="5 5 0 0">
            <materialDesign:PackIcon Kind="Plus" 
                                     Width="22" 
                                     Height="22" 
                                     VerticalAlignment="Center"
                                     Margin="5 5 0 0"
                                     Foreground="{StaticResource ForegroundMainBrush}"/>

            <TextBlock Text="{Binding HeaderText}"
                       Style="{StaticResource HeaderTextStyle}" 
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="6 6 0 0"
                               />

        </StackPanel>

        <!-- text input and feedback message -->
        <StackPanel Grid.Row="1" 
                    Margin="5 10 5 0"
                    Orientation="Vertical" 
                    HorizontalAlignment="Center" >

            <Grid Margin="0 10 0 5" >

                <materialDesign:Card  
                     materialDesign:ElevationAssist.Elevation="Dp6"
                     HorizontalContentAlignment="Center"
                     Width="900"
                     Padding="12"
                     Background="{StaticResource BackgroundLightGreyBrush}" >

                    <components:NewTaskItemView />
                    
                </materialDesign:Card>

            </Grid>

            <TextBlock Text="{Binding FeedbackMessage}" 
                       HorizontalAlignment="Center"
                       Visibility="{Binding FeedbackMessage, Converter={StaticResource IsNullConverterInstance}}">

                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFeedbackError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorRedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFeedbackError}" Value="False">
                                <Setter Property="Foreground" Value="Green" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </StackPanel>

        <!-- submit / cancel buttons -->
        <StackPanel Grid.Row="2" 
                    Margin="0 5 10 10"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" >

            <Button Content="_CANCEL"
                        Command="{Binding CloseDialogCommand}" 
                        Style="{StaticResource dialogCancelButtonStyle}"              
                        Margin="0 0 15 0" />

            <Button Content="_ADD" 
                        Command="{Binding ProcessSubmitActionCommand}"
                        Style="{StaticResource dialogSubmitButtonStyle}"  />

        </StackPanel>

    </Grid>
</UserControl>
