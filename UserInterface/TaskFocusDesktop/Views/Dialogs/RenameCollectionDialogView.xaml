<UserControl x:Class="TaskFocusDesktop.Views.Dialogs.RenameCollectionDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.Dialogs"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:dialogs="clr-namespace:TaskFocusDesktop.ViewModels.Dialogs"
             xmlns:vmBase="clr-namespace:TaskFocusDesktop.ViewModels.Base"
             xmlns:system="clr-namespace:System;assembly=netstandard" 
             xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities" 
             xmlns:components="clr-namespace:TaskFocusDesktop.Views.Components" 
             d:DataContext="{d:DesignInstance Type=dialogs:RenameCollectionDialogViewModel}"
             d:DesignHeight="200" d:DesignWidth="500">

    <UserControl.Resources>
        <utilities:IsNullConverter x:Key="IsNullConverterInstance"/>
    </UserControl.Resources>

    <Grid Margin="10" Width="400" Height="150" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"   Margin="0,0,0,5">
            <materialDesign:PackIcon Kind="{Binding HeaderIconKind}" 
                                     Width="22" 
                                     Height="22" 
                                     VerticalAlignment="Center"
                                     Margin="0 0 10 0"
                                     Foreground="{StaticResource ForegroundMainBrush}"/>

            <TextBlock Text="{Binding HeaderText}"
                               Style="{StaticResource HeaderTextStyle}" 
                               FontSize="16"
                               VerticalAlignment="Center"
                               />

        </StackPanel>

        <!-- text input and feedback message -->
        <StackPanel Grid.Row="1" 
                        Margin="0 10 0 0"
                        Orientation="Vertical" 
                        HorizontalAlignment="Center" >

            <Grid >

                <TextBox x:Name="updatedCollectionNameInputField"
                         Text="{Binding UpdatedCollectionName}" 
                         FontSize="14"
                         Width="275"
                         Margin="0 10 0 5"
                         HorizontalAlignment="Center" />

            </Grid>

            <ContentPresenter Margin="0 0 0 10"
                              HorizontalAlignment="Center"                                    
                              Content="{StaticResource FeedbackMessageContent}" />

        </StackPanel>

        <!-- submit / cancel buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" >

            <Button Content="_CANCEL"
                        Command="{Binding CloseDialogCommand}" 
                        Style="{StaticResource dialogCancelButtonStyle}"              
                        Margin="0 0 15 0" />

            <Button Content="_UPDATE" 
                        Command="{Binding ProcessSubmitActionCommand}"
                        Style="{StaticResource dialogSubmitButtonStyle}"  />

        </StackPanel>

    </Grid>

</UserControl>
