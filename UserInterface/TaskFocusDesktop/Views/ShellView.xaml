<Window x:Class="TaskFocusDesktop.Views.ShellView"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:viewmodels="clr-namespace:TaskFocusDesktop.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:ShellViewModel}"
        mc:Ignorable="d"
        Title="TaskFocus" 
        Height="720" 
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Icon="../Images/favicon-32x32.png"
        WindowState="{Binding ShellWindowState, Mode=TwoWay}"
        WindowStyle="None"
        AllowsTransparency="True"
        Style="{StaticResource BaseStyle}">

    <WindowChrome.WindowChrome>
        <WindowChrome
            ResizeBorderThickness="{Binding ResizeBorderThickness}"
            CaptionHeight="{Binding TitleBarHeight}"
            GlassFrameThickness="0"
            CornerRadius="0"
            />
    </WindowChrome.WindowChrome>

    <!-- outer window border with drop shadow margin -->
    <Border Padding="{Binding OuterMarginSizeThickness, FallbackValue=10}">
        
        <!-- main window outline -->
        <Grid >

            <!-- Opacity mask for corners on grid -->
            <Border x:Name="Container" Panel.ZIndex="0"
                    Background="{StaticResource BackgroundDarkGreyBrush}"
                    CornerRadius="{Binding WindowCornerRadius, FallbackValue=10}" />

            <!-- window border and drop shadow -->
            <Border CornerRadius="{Binding WindowCornerRadius, FallbackValue=10}"
                    Background="{StaticResource BackgroundDarkGreyBrush}" >
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="3" Opacity="0.2" />
                </Border.Effect>
            </Border>

            <!-- main window content -->
            <Grid>

                <!-- Corner clipping -->
                <Grid.OpacityMask>
                    <VisualBrush Visual="{Binding ElementName=Container}" />
                </Grid.OpacityMask>
                
                <!-- main window grid defs -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!-- Title bar -->
                    <RowDefinition Height="{Binding TitleBarHeightGridLength, FallbackValue=32}" />
                    <!-- Title bar drop shadow -->
                    <RowDefinition Height="Auto" />

                    <!-- Window content-->
                    <RowDefinition Height="75" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Column 0-1, Row 0  -->
                <!-- Title bar  -->
                <Grid Grid.Column="0"
                      Grid.Row="0"
                      Grid.ColumnSpan="2"
                      Background="{StaticResource BackgroundDarkGreyBrush}"
                      Panel.ZIndex="1">

                    <Grid.ColumnDefinitions>
                        <!-- Icon -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Title -->
                        <ColumnDefinition Width="*" />
                        <!-- Windows button -->
                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <!--<Button Background="Transparent" 
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            Margin="3 0 0 0"
                            Padding="3 1 3 1"
                            Command="{Binding MenuCommand}">
                        <Image Source="../Images/favicon-32x32.png" />
                    </Button>-->

                    <!-- Title -->
                    <Viewbox Grid.Column="1" Margin="5" HorizontalAlignment="Left">
                        <TextBlock  />
                    </Viewbox>

                    <!-- Window Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        
                        <Button Command="{Binding MinimizeCommand}" 
                                Margin="0 0 0 1" 
                                Background="{StaticResource BackgroundLightGreyBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                >
                            <materialDesign:PackIcon Kind="WindowMinimize"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{StaticResource ForegroundMainBrush}" />
                        </Button>
                        
                        <Button Command="{Binding MaximizeCommand}"
                                Margin="0 0 0 1" 
                                Background="{StaticResource BackgroundLightGreyBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                >
                            <materialDesign:PackIcon Kind="WindowMaximize"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{StaticResource ForegroundMainBrush}" />
                        </Button>

                        <Button x:Name="ExitApplication" 
                                Margin="0 0 0 1"
                                Background="{StaticResource BackgroundLightGreyBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                >
                            <materialDesign:PackIcon Kind="WindowClose"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{StaticResource ForegroundMainBrush}" />
                        </Button>

                    </StackPanel>

                </Grid>

                <!-- Title bar drop shadow -->
                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="6" BorderThickness="0 0.2 0 0">
                    <!-- Underline -->
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1, 0">
                            <GradientStop Color="{StaticResource ForegroundHighlight}" Offset="0.0" />
                            <GradientStop Color="{StaticResource ForegroundMain}" Offset="0.5" />
                            <GradientStop Color="{StaticResource ForegroundHighlight}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>

                    <!-- Drop shadow -->
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0, 1">
                            <GradientStop Color="{StaticResource BackgroundLightGrey}" Offset="0.0" />
                            <GradientStop Color="{StaticResource BackgroundDarkGrey}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                </Border>

                <!-- Column 0, Row 2  -->
                <!-- Logo header -->
                <StackPanel Grid.Column="0" 
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="CheckUnderlineCircle"
                                                Height="23"
                                                Width="23"
                                                Margin="3 6 3 3" 
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Foreground="{StaticResource ForegroundHighlightBrush}" />
                    <TextBlock
                                FontSize="24"
                                Style="{StaticResource textBlockPrimaryStyle}"
                                FontWeight="Bold"
                                ><Run Text="TaskFocus"/></TextBlock>

                </StackPanel>


                <TextBlock Grid.Column="0" 
                            Grid.Row="2" 
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            >test</TextBlock>

                <!-- Column 0, Row 2  -->
                <!-- Navigation bar -->
                <StackPanel Orientation="Vertical"
                            Grid.Column="0" 
                            Grid.Row="2"
                            Visibility="{
                            Binding IsUserLoggedIn, 
                            Converter={StaticResource BooleanToVisibilityConverter}, 
                            FallbackValue=Collapsed}">

                    <Button x:Name="SwitchToInboxView"
                            Width="100">
                        Inbox</Button>

                    <Button x:Name="SwitchToTodayView"
                            Width="100">
                        Today</Button>

                </StackPanel>

                <!-- Column 1, Row 2  -->
                <ContentControl x:Name="TopWidgetPanel"  
                                Grid.Column="1" 
                                Grid.Row="2"
                                />

                <!-- Column 1, Row 2  -->
                <ContentControl x:Name="MainContentPanel"
                                Grid.Column="1" 
                                Grid.Row="3"
                                    />

            </Grid>

        </Grid>

    </Border>

</Window>
