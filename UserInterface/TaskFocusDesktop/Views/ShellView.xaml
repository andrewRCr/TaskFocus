<Window x:Class="TaskFocusDesktop.Views.ShellView"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:viewmodels="clr-namespace:TaskFocusDesktop.ViewModels"
        xmlns:customControls="clr-namespace:TaskFocusDesktop.CustomControls"
        xmlns:vmBase="clr-namespace:TaskFocusDesktop.ViewModels.Base"
        xmlns:dialogs="clr-namespace:TaskFocusDesktop.ViewModels.Dialogs" 
        xmlns:system="clr-namespace:System;assembly=netstandard"
        d:DataContext="{d:DesignInstance Type=viewmodels:ShellViewModel}"
        mc:Ignorable="d"
        Title="TaskFocus" 
        Height="900" 
        Width="1600"
        MinHeight="{Binding WindowMinimumHeight}"
        MinWidth="{Binding WindowMinimumWidth}"
        WindowStartupLocation="CenterScreen"
        Icon="../Resources/Images/favicon-32x32.png"
        WindowState="{Binding ShellWindowState, Mode=TwoWay}"
        WindowStyle="None"
        SourceInitialized="Window_SourceInitialized"
        AllowsTransparency="True"
        Background="Transparent"
        Style="{StaticResource BaseStyle}" >

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="{Binding ResizeBorderThickness}"
                      CaptionHeight="{Binding TitleBarHeight}"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <!-- transparent outer window border for resizing -->
    <Border BorderThickness="2" Padding="{Binding OuterMarginSizeThickness, FallbackValue=10}" >

        <!-- main window outline -->
        <Grid>

            <!-- opacity mask for corners on grid -->
            <Border x:Name="Container" 
                    Background="{StaticResource BackgroundDarkGreyBrush}"
                    CornerRadius="{Binding WindowCornerRadius, FallbackValue=10}" />

            <!-- window border and drop shadow -->
            <Border CornerRadius="{Binding WindowCornerRadius, FallbackValue=10}"
                    Background="{StaticResource BackgroundDarkGreyBrush}" >
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="3" Opacity="0.2" />
                </Border.Effect>
            </Border>

            <!-- handling dialog content across app -->
            <materialDesign:DialogHost Identifier="ShellDialogHost"
                                       CloseOnClickAway="True" >

                <!-- individual templates are referenced implicity using the DataType property -->
                <materialDesign:DialogHost.DialogContentTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}"  />
                    </DataTemplate>
                </materialDesign:DialogHost.DialogContentTemplate>
                    
                <!-- main window content -->
                <Grid>

                    <!-- corner clipping, to round edges of window -->
                    <Grid.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=Container}" />
                    </Grid.OpacityMask>

                    <!-- main window grid defs -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <!-- Title bar -->
                        <RowDefinition Height="{Binding TitleBarHeightGridLength, FallbackValue=32}" />

                        <!-- Window content-->
                        <RowDefinition Height="75" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="80" />
                    </Grid.RowDefinitions>

                    <!-- Column 0-1, Row 0  -->
                    <!-- Title bar  -->
                    <Grid Grid.Column="0"
                          Grid.Row="0"
                          Grid.ColumnSpan="3"
                          Background="Transparent" >

                        <Grid.ColumnDefinitions>
                            <!-- Icon -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Title (empty, spacer) -->
                            <ColumnDefinition Width="*" />
                            <!-- Windows button -->
                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Button Style="{StaticResource WindowControlButton}"
                                Command="{Binding TitleBarMenuCommand}">
                            <materialDesign:PackIcon Kind="Menu"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{StaticResource ForegroundMainBrush}" />
                        </Button>

                        <!-- Window Buttons -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal">

                            <Button Command="{Binding MinimizeCommand}"
                                    Style="{StaticResource WindowControlButton}">
                                <materialDesign:PackIcon Kind="WindowMinimize"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{StaticResource ForegroundMainBrush}" />
                            </Button>

                            <Button Command="{Binding MaximizeCommand}"
                                    Style="{StaticResource WindowControlButton}">
                                <materialDesign:PackIcon Kind="{Binding WindowMaxRestoreIcon}"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{StaticResource ForegroundMainBrush}" />
                            </Button>

                            <Button Command="{Binding CloseCommand}"
                                    Style="{StaticResource WindowCloseButton}">
                                <materialDesign:PackIcon Kind="WindowClose"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{StaticResource ForegroundMainBrush}" />
                            </Button>

                        </StackPanel>

                    </Grid>

                    <!-- Column 0, Row 2  -->
                    <!-- Logo header -->
                    <StackPanel Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Grid.Row="1"
                                Margin="0 0 133 0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">

                        <materialDesign:PackIcon Kind="CheckUnderlineCircle"
                                                 Height="23"
                                                 Width="23"
                                                 Margin="3 6 3 3" 
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{StaticResource ForegroundHighlightBrush}" />
                        <TextBlock FontSize="24"
                                   Foreground="{StaticResource ForegroundHighlightBrush}"
                                   FontWeight="Bold"
                                   Margin="5 0 0 0" >
                            TaskFocus
                        </TextBlock>
                    </StackPanel>

                    <!-- Column 0, Row 2  -->
                    <!-- // Mini Navigation menu (icons) // -->

                    <StackPanel Orientation="Vertical" 
                                Grid.Column="0"
                                Grid.Row="2">

                        <Menu IsEnabled="{Binding IsUserLoggedIn}"
                              Template="{StaticResource MiniNavMenu_Template}" />

                    </StackPanel>

                    <Rectangle Grid.Column="0" 
                               Grid.Row="2"
                               Grid.RowSpan="2"
                               StrokeThickness="1" 
                               Width="1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Stretch"
                               Stroke="{StaticResource BackgroundSeparatorGreyBrush}"
                               Fill="{StaticResource BackgroundSeparatorGreyBrush}" />

                    <!-- Column 1, Row 2  -->
                    <!-- // SidePanel: full NavMenu (text) + SubNavMenu // -->
                    <StackPanel Orientation="Vertical"
                                Grid.Column="1" 
                                Grid.Row="2"
                                Visibility="{Binding IsUserLoggedIn, 
                                                     Converter={StaticResource BooleanToVisibilityConverter}, 
                                                     FallbackValue=Visible}" >

                        <ContentControl x:Name="SideMenuPanel"  />

                    </StackPanel>

                    <!-- // separator // -->
                    <Rectangle Grid.Column="1" 
                               Grid.Row="2" 
                               Grid.RowSpan="2"
                               Width="1" 
                               Stroke="{StaticResource BackgroundSeparatorGreyBrush}" 
                               VerticalAlignment="Stretch"
                               HorizontalAlignment="Right" />

                    <!-- Column 0, Row 3  -->
                    <!-- // Bottom-sticky MiniNavMenu: Settings // -->
                    <Menu Grid.Column="0"
                          Grid.Row="3" 
                          VerticalAlignment="Bottom"
                          IsEnabled="{Binding IsUserLoggedIn}" >

                        <MenuItem Header="Settings" 
                                  Command="{Binding SwitchToSettingsViewCommand}"
                                  Template="{StaticResource MiniNavMenuItem_Template}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="AccountCog" 
                                                         Height="24" 
                                                         Width="24"
                                                         Foreground="{Binding MiniNavIconColor}" />
                            </MenuItem.Icon>
                        </MenuItem>

                    </Menu>

                    <!-- Column 1, Row 3  -->
                    <!-- // Bottom-sticky full (text) navigation menu: Settings // -->        
                    <Menu Grid.Column="1"
                          Grid.Row="3"
                          VerticalAlignment="Bottom"
                          Margin="0 0 0 0"
                          Visibility="{Binding IsUserLoggedIn, 
                                       Converter={StaticResource BooleanToVisibilityConverter}, 
                                       FallbackValue=Visible}" >

                        <MenuItem Header="Settings"
                                  Foreground="{Binding SettingsMenuItemColor}"
                                  Command="{Binding SwitchToSettingsViewCommand}"
                                  Template="{StaticResource NavMenuItem_Template}" />

                    </Menu>
          
                    <!-- Column 2, Row 1  -->
                    <ContentControl x:Name="TopWidgetPanel"  
                                    Grid.Column="2" 
                                    Grid.Row="1" />

                    <!-- Column 2, Row 2  -->
                    <ContentControl x:Name="MainContentPanel"
                                    Grid.Column="2" 
                                    Grid.Row="2" />

                    <!-- Column 2, Row 3  -->

                    <StackPanel Orientation="Horizontal"
                                Grid.Column="2"                                                  
                                Grid.Row="3" >

                        <customControls:CircularButton x:Name="NewTaskButton" 
                                                   Visibility="{Binding IsUserLoggedIn, 
                                                                Converter={StaticResource BooleanToVisibilityConverter}, 
                                                                FallbackValue=Visible}"
                                                   IsEnabled="{Binding IsUserLoggedIn}"
                                                   Grid.Column="2"                                                  
                                                   Grid.Row="3" 
                                                   HorizontalAlignment="Left" 
                                                   Margin="25 15 0 0"
                                                   Height="45"
                                                   Width="45"
                                                   Command="{Binding OpenNewTaskDialogCommand}"
                                                   Style="{StaticResource addNewTaskIconButtonTemplate}"
                                                   FocusEllipseHoverColor="{StaticResource BackgroundLightGreyBrush}"
                                                   FocusEllipsePressedColor="{StaticResource ForegroundTertiaryBrush}" >

                            <materialDesign:PackIcon Kind="Plus"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Height="26"
                                                 Width="26"
                                                 Foreground="{StaticResource ForegroundMainBrush}" />
                        </customControls:CircularButton>

                    </StackPanel>

                    <!-- sync status indicator  -->
                    <StackPanel Orientation="Vertical" 
                                Grid.Column="2" 
                                Grid.Row="3" 
                                Margin="0 20 20 0"
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Right"
                                Visibility="{Binding IsUserLoggedIn, 
                                                     Converter={StaticResource BooleanToVisibilityConverter}, 
                                                     FallbackValue=Visible}" >
                        
                        <TextBlock FontSize="14"
                                   Foreground="{StaticResource ForegroundMainBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" 
                                   Text="Status:" />

                        <TextBlock FontSize="14"  
                                   Foreground="{Binding SyncStatusColor}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" 
                                   Text="{Binding SyncStatusStr}" />

                    </StackPanel>

                </Grid>

            </materialDesign:DialogHost>
            
        </Grid>
    </Border>

</Window>
