<UserControl x:Class="TaskFocusDesktop.Views.SidePanel.NavMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities"
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.SidePanel" xmlns:sidepanel="clr-namespace:TaskFocusDesktop.ViewModels.SidePanel" d:DataContext="{d:DesignInstance Type=sidepanel:NavMenuViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="250">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <utilities:ActiveMainViewToVisibilityConverter x:Key="ActiveMainViewToVisibilityConverter" />

            <ControlTemplate x:Key="NavMenuItem_Template"
                       TargetType="{x:Type MenuItem}">

                <Border x:Name="MenuItemBorder"
                  Background="Transparent"
                  BorderThickness="0"
                  Height="50"
                  Width="250">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- menu text -->
                        <ContentPresenter x:Name="HeaderText" 
                                    ContentSource="Header"
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    RecognizesAccessKey="True"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center" />
                        
                        <!-- selected indicator (highlight vertical strip on right side) -->
                        <Rectangle x:Name="SelectedIndicator" 
                             Tag="{Binding Path=Header}"
                             Grid.Column="1"
                             VerticalAlignment="Stretch" 
                             HorizontalAlignment="Right"
                             Width="3" 
                             Margin="0"
                             Stroke="{StaticResource ForegroundHighlightBrush}"
                             Fill="{StaticResource ForegroundHighlightBrush}" >

                            <Rectangle.Visibility>
                                <MultiBinding Converter="{StaticResource ActiveMainViewToVisibilityConverter}">
                                    <Binding Path="Header" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type MenuItem}}"/>
                                    <Binding Path="ActiveAppStateMainContentView"/>
                                </MultiBinding>
                            </Rectangle.Visibility>
                        </Rectangle>

                        <!-- selected indicator (background) -->
                        <Border x:Name="SelectedIndicatorBorder" 
                          Panel.ZIndex="-1"
                          Grid.ColumnSpan="2"
                          Height="50"
                          Width="250" 
                          Margin="0"
                          Background="{StaticResource BackgroundMidGreyBrush}" >

                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource ActiveMainViewToVisibilityConverter}">
                                    <Binding Path="Header" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type MenuItem}}"/>
                                    <Binding Path="ActiveAppStateMainContentView" />
                                </MultiBinding>
                            </Border.Visibility>
                        </Border>

                    </Grid>
                </Border>

                <ControlTemplate.Triggers>

                    <Trigger Property="IsHighlighted"
                       Value="True">
                        <Setter TargetName="MenuItemBorder"
                          Property="Background"
                          Value="{StaticResource BackgroundMidGreyBrush}" />

                    </Trigger>

                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">

            <Menu>

                <Menu.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </Menu.ItemsPanel>

                <MenuItem Header="Inbox" 
                          Template="{StaticResource NavMenuItem_Template}" 
                          Command="{Binding SwitchToInboxViewCommand}">

                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="Inbox" Margin="0 0 0 0" />
                    </MenuItem.Icon>

                </MenuItem>

                <MenuItem Header="Today"
                          Template="{StaticResource NavMenuItem_Template}"
                          Command="{Binding SwitchToTodayViewCommand}">

                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="CalendarToday" Margin="0 0 0 0" />
                    </MenuItem.Icon>

                </MenuItem>

                <MenuItem Header="Projects" 
                          Template="{StaticResource NavMenuItem_Template}"
                          Command="{Binding SwitchToProjectsViewCommand}">

                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="ClipboardText" Margin="0 0 0 0" />
                    </MenuItem.Icon>

                </MenuItem>

                <MenuItem Header="Contexts" 
                          Template="{StaticResource NavMenuItem_Template}"
                          Command="{Binding SwitchToContextsViewCommand}">

                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="Animation" Margin="0 0 0 0" />
                    </MenuItem.Icon>

                </MenuItem>

                <MenuItem Header="Completed" 
                          Template="{StaticResource NavMenuItem_Template}"
                          Command="{Binding SwitchToCompletedViewCommand}">

                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="PlaylistCheck" Margin="0 0 0 0" />
                    </MenuItem.Icon>

                </MenuItem>

            </Menu>

        </StackPanel>

    </Grid>
    
</UserControl>
