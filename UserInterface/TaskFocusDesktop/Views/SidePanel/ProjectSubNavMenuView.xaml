<UserControl x:Class="TaskFocusDesktop.Views.SidePanel.ProjectSubNavMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities"
             xmlns:customControls="clr-namespace:TaskFocusDesktop.CustomControls"
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.SidePanel"
             xmlns:sidepanel="clr-namespace:TaskFocusDesktop.ViewModels.SidePanel" 
             xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=sidepanel:ProjectSubNavMenuViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="250">
  
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <utilities:ActiveMainViewToVisibilityConverter x:Key="ActiveMainViewToVisibilityConverter" />
        </ResourceDictionary>

    </UserControl.Resources>

    <Grid x:Name="mainSubNavMenuGrid">

        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!-- header row (0); contains back button and header text -->
        <Grid Grid.Row="0" >
                
            <!-- 'back' button -->
            <Button Command="{Binding ExitSubNavMenuCommand}" 
                    Background="Transparent"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Left"
                    Margin="-10 10 0 10"
                    Width="150" 
                    BorderThickness="0"  >

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                    <materialDesign:PackIcon Kind="ChevronLeft"
                                        Foreground="{StaticResource ForegroundMainBrush}"
                                        Height="32"
                                        Width="32"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        />

                    <TextBlock Text="PROJECTS"
                        Style="{StaticResource HeaderTextStyle}"
                        Foreground="{StaticResource ForegroundMainBrush}"
                        VerticalAlignment="Center"
                        Margin="6 1 0 0"
                        />

                </StackPanel>

            </Button>

        </Grid>

        <!-- menu content, row 1. 2 columns (one for collection name, one for corresponding edit button)-->
        <Grid Grid.Row="1" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="15" />
            </Grid.ColumnDefinitions>

            <Behaviors:Interaction.Triggers>
                <Behaviors:EventTrigger EventName="MouseLeave">
                    <Behaviors:InvokeCommandAction Command="{Binding NoHoveredProjectsCommand}" />
                </Behaviors:EventTrigger>

            </Behaviors:Interaction.Triggers>

            <!-- collection name menu items, row 1 -> column 0 -->
            <ListBox x:Name="subNavMenuListBox"
                 Grid.Column="0"
                 ItemsSource="{Binding LocalProjects}" 
                 SelectedItem="{Binding SelectedProject}"             
                 Style="{StaticResource NavigationListBoxStyle}" >

                <Behaviors:Interaction.Triggers>
                    <Behaviors:EventTrigger EventName="SelectionChanged">
                        <Behaviors:InvokeCommandAction Command="{Binding SelectedProjectChangedCommand}" />
                    </Behaviors:EventTrigger>

                </Behaviors:Interaction.Triggers>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ListBoxItem x:Name="listItem" Style="{StaticResource NavigationListBoxItemStyle}">

                            <TextBlock Text="{Binding ProjectName}" />

                            <Behaviors:Interaction.Triggers>
                                <Behaviors:EventTrigger EventName="MouseEnter">
                                    <Behaviors:InvokeCommandAction Command="{Binding DataContext.NewHoveredProjectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                               CommandParameter="{Binding}" />
                                </Behaviors:EventTrigger>
                            </Behaviors:Interaction.Triggers>

                        </ListBoxItem>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <!-- rename / delete contextual menu control for each project, row 1 -> column 1 -->
            <ListBox x:Name="subNavMenuEditButtonsListBox" 
                     Grid.Column="1"
                     ItemsSource="{Binding LocalProjects}"              
                     Style="{StaticResource PlainListBoxStyle}" >

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Button Style="{StaticResource MaterialDesignToolButton}"
                            Command="{Binding DataContext.OpenSelectedProjectEditMenuCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            Height="24" Width="20"
                            Margin="0 3 0 0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" >

                            <Button.Visibility>
                                <MultiBinding>
                                    <MultiBinding.Converter>
                                        <utilities:DictionaryItemBooleanToVisibilityConverter />
                                    </MultiBinding.Converter>

                                    <Binding Path="DataContext.ShowProjectEditMenuDictionary" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                    <!-- binding Key to ProjectDisplayModel, i.e., current source -->
                                    <Binding Path="" />
                                </MultiBinding>


                            </Button.Visibility>

                            <materialDesign:PackIcon Kind="DotsVertical" 
                                                         
                                                         Foreground="{StaticResource ForegroundSecondaryBrush}"
                                                         Height="20" 
                                                         Width="20" 
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Margin="0 0 0 0"
                                                         />
                        </Button>


                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>


        </Grid>

        <!-- add new project control, row 2 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left"                       
                    Margin="20,0,0,0"
                    Width="200" >

            <customControls:CircularButton Command="{Binding RequestAddNewProjectDialogCommand}"
                                           FocusEllipseHoverColor="{StaticResource ForegroundHighlightSecondaryBrush}"
                                           FocusEllipsePressedColor="{StaticResource BackgroundLightestGreyBrush}"
                                           Style="{StaticResource addNewCollectionIconButtonTemplate}"
                                           Height="32"
                                           Width="32"    
                                               >

                <materialDesign:PackIcon Kind="Plus" 
                                             Height="22"
                                             Width="22"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource ForegroundHighlightBrush}"  />

            </customControls:CircularButton>

            <TextBlock Style="{StaticResource HeaderTextStyle}"
                               Margin="5 2 0 0"
                               FontSize="15"
                               Text="ADD NEW PROJECT"
                               VerticalAlignment="Center"
                               />

        </StackPanel>

    </Grid>

</UserControl>
