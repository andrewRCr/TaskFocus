<UserControl x:Class="TaskFocusDesktop.Views.Components.TaskCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.Components" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <!--<i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:CallMethodAction MethodName="FilterCollectionTasks" />
        </i:EventTrigger>
    </i:Interaction.Triggers>-->


    <Grid>

        <Expander IsExpanded="True" Margin="0" Header="{Binding CollectionName, RelativeSource={RelativeSource 
                                      AncestorType={x:Type local:TaskCollectionView}}}" 
                  Background="Transparent"
                  >
            
            <ListBox ItemsSource="{Binding CollectionTasks, RelativeSource={RelativeSource 
                                           AncestorType={x:Type local:TaskCollectionView}}}"  >




                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">

                                    <Grid Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalAlignment}"/>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>


                    </Style>
                </ListBox.ItemContainerStyle>
                
             

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <local:TaskItemView />

                    </DataTemplate>


                </ListBox.ItemTemplate>
            </ListBox>

        </Expander>


        <!--<StackPanel Orientation="Vertical">-->


               
        <!-- collection name -->
            <!--<TextBlock Text="{Binding CollectionName, RelativeSource={RelativeSource 
                                      AncestorType={x:Type local:TaskCollectionView}}}" />-->

        <!-- collection tasks -->
            <!--<ListView ItemsSource="{Binding FilteredCollectionTasks, RelativeSource={RelativeSource 
                                           AncestorType={x:Type local:TaskCollectionView}}}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        --><!--<TextBlock Text="{Binding TaskName}" />--><!--

                        <local:TaskItemView />

                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>-->

            <!--<local:TaskItemContainerView ContainerTasks="{Binding FilteredCollectionTasks, RelativeSource={RelativeSource 
                                           AncestorType={x:Type local:TaskCollectionView}}}" />-->

        <!--</StackPanel>-->

    </Grid>
</UserControl>
