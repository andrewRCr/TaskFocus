<UserControl x:Class="TaskFocusDesktop.Views.Components.TaskCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.Components" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <!--<i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:CallMethodAction MethodName="FilterCollectionTasks" />
        </i:EventTrigger>
    </i:Interaction.Triggers>-->


    <Grid>

        <Expander IsExpanded="True" Margin="0" 
                  Background="Transparent"
                  >

            <Expander.Header>

                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="{Binding CollectionIconKind, RelativeSource={RelativeSource 
                                      AncestorType={x:Type local:TaskCollectionView}}}"
                                     VerticalAlignment="Center"
                                     Margin="0 0 0 0"
                                     Foreground="{StaticResource ForegroundMainBrush}"
                                     Height="24"
                                     Width="24"
                                     />

                    <TextBlock Text="{Binding CollectionName, RelativeSource={RelativeSource 
                                      AncestorType={x:Type local:TaskCollectionView}}}" 
                               Style="{StaticResource HeaderTextStyle}"
                               VerticalAlignment="Center"
                               Margin="10 0 0 0"
                               />
                </StackPanel>
                

            </Expander.Header>

            <local:TaskItemContainerView ContainerTasks="{Binding CollectionTasks, RelativeSource={RelativeSource 
                                           AncestorType={x:Type local:TaskCollectionView}}}" 
                                         CanReorder="True"
                                         OrderingIndex="ProjectIndex"
                                         />

