<UserControl x:Class="TaskFocusDesktop.Views.Components.TaskItemContainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="400">

    <Grid>

        <!-- task container -->
        <ListBox x:Name="TaskContainerListBox" 
                 ItemsSource="{Binding DataContext.LocalTasks, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 AllowDrop="True" 
                 SelectionChanged="TaskContainerListBox_SelectionChanged"
                
                 ItemTemplate="{StaticResource TaskItem_Template2}"
                 SelectedItem="{Binding DataContext.SelectedTaskItem, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" >

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">

                    <!-- handle drag/drop events -->
                    <EventSetter Event="PreviewMouseMove" Handler="TaskItem_MouseMove" />
                    <EventSetter Event="PreviewDrop" Handler="TaskItem_Drop"/>
                    <EventSetter Event="PreviewDragEnter" Handler="TaskItem_DragEnter" />
                    <EventSetter Event="PreviewDragLeave" Handler="TaskItem_DragLeave" />

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Name="_Border"
                                        Padding="1"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        SnapsToDevicePixels="true">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter TargetName="_Border" Property="Background" Value="{StaticResource BackgroundLightestGreyBrush}"/>
                                        <Setter Property="IsSelected" Value="True"/>
                                    </Trigger>

                                    <!-- drag/drop visual highlighting -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsDragging, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Value="True"/>
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="_Border" Property="Background" Value="{StaticResource BackgroundLightestGreyBrush}"/>
                                    </MultiDataTrigger>
                                    
                                </ControlTemplate.Triggers>
                 
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                </Style>

            </ListBox.ItemContainerStyle>

        </ListBox >

    </Grid>
</UserControl>
