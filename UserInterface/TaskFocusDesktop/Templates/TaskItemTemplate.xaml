<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:components="clr-namespace:TaskFocusDesktop.Views.Components"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" >

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- // TaskItem data template // -->

    <DataTemplate x:Key="TaskItem_Template" DataType="ListBoxItem" >

        <DataTemplate.Resources>
            <Size x:Key="iconSize" Height="24" Width="24" />

            <Style x:Key="iconStyle" TargetType="materialDesign:PackIcon">
                <Setter Property="Height" Value="24" />
                <Setter Property="Width" Value="24" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

        </DataTemplate.Resources>

        <Border Background="{StaticResource BackgroundLightGreyBrush}" 
                CornerRadius="5" 
                Margin="2"
                Padding="10" 
                >

            <StackPanel Orientation="Horizontal">
                
                <!-- drag indicator -->
                <materialDesign:PackIcon Kind="Drag"
                                         Style="{StaticResource iconStyle}"
                                         />

                <!-- starred "checkbox" -->
                <materialDesign:PackIcon Kind="StarOutline" 
                                         Style="{StaticResource iconStyle}"
                                         Margin="10 0 0 0"
                                         />

                <!--completion checkbox-->
                <CheckBox IsChecked="{Binding Completed}"
                          Height="32" 
                          Width="32" 
                          Margin="15 0 0 0" 
                          VerticalAlignment="Center" />

                <!--task Name value-->
                <TextBox Text="{Binding TaskName}" Margin="15 5 5 5" MinWidth="200" MaxWidth="250" VerticalAlignment="Center"
                         TextWrapping="Wrap" BorderThickness="0"/>

                <!--project dropdown-->
                <ComboBox Text="{Binding ProjectName}" AllowDrop="True"
                      Margin="5 5 5 5" MinWidth="150" VerticalAlignment="Center"
                      IsEditable="True"
                      ItemsSource="{Binding DataContext.LocalProjects, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      DisplayMemberPath="ProjectName"
                      SelectedItem="{Binding ProjectName}"
                          >
                </ComboBox>

                <!--context dropdown-->
                <ComboBox Text="{Binding ContextName}" 
                      Margin="5 5 5 5" MinWidth="150" VerticalAlignment="Center"
                      IsEditable="True"
                      ItemsSource="{Binding DataContext.LocalContexts, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      DisplayMemberPath="ContextName"
                      SelectedItem="{Binding ContextName}"
                          >
                </ComboBox>

                <!--due date datepicker-->
                <DatePicker Text="Due" SelectedDate="{Binding DueDate}"  Margin="10 5 5 4" VerticalAlignment="Center" BorderThickness="0" />

                <!--delete task button-->
                <Button Content="Delete" Command="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=DataContext.DeleteTaskCommand}" />

            </StackPanel>

        </Border>

    </DataTemplate>

</ResourceDictionary>