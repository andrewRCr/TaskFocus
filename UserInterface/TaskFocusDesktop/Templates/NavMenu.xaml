<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities" >

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="Separator" x:Key="NavMenuSeperatorStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Fill="{TemplateBinding Background}" Height="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <utilities:ActiveMainViewToVisibilityConverter x:Key="ActiveMainViewToVisibilityConverter" />

    <!-- // NavMenu MenuItem template // -->

    <ControlTemplate x:Key="NavMenuItem_Template"
                     TargetType="{x:Type MenuItem}">

        <Border x:Name="MenuItemBorder"
                Background="Transparent"
                BorderThickness="0"
                Height="50"
                Width="250"
                >

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--icon -->

                <ContentPresenter x:Name="Icon"
                                  Grid.Column="0"
                                  ContentSource="Icon"
                                  HorizontalAlignment="Left"
                                  Margin="50,0,0,0"
                                  VerticalAlignment="Center" />

                <!-- menu text -->

                <ContentPresenter ContentSource="Header"
                                  Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  RecognizesAccessKey="True"
                                  Margin="3,0,0,0"
                                  VerticalAlignment="Center" />
                
                <!-- selected indicator -->
                <Rectangle x:Name="SelectedIndicator" 
                           Tag="{Binding Path=Header}"
                           Grid.Column="3"
                           VerticalAlignment="Stretch" 
                           HorizontalAlignment="Right"
                           Width="3" 
                           Margin="0 8"
                           Stroke="{StaticResource ForegroundHighlightBrush}"
                           Fill="{StaticResource ForegroundHighlightBrush}" >

                    <Rectangle.Visibility>
                        <MultiBinding Converter="{StaticResource ActiveMainViewToVisibilityConverter}">
                            <Binding Path="Header" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type MenuItem}}"/>
                            <Binding Path="DataContext.ActiveMainContentView" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}"/>
                        </MultiBinding>
                    </Rectangle.Visibility>
                </Rectangle>

            </Grid>
        </Border>

        <ControlTemplate.Triggers>

            <Trigger Property="IsHighlighted"
                     Value="True">
                <Setter TargetName="MenuItemBorder"
                        Property="Background"
                        Value="{StaticResource BackgroundLightGreyBrush}" />
            </Trigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>


    <!--// NavMenu template //-->

    <ControlTemplate x:Key="NavMenu_Template" TargetType="Menu">

        <Menu Margin="0 20 0 0" >

            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>

            <MenuItem Header="Inbox" 
                        Template="{StaticResource NavMenuItem_Template}" 
                        Command="{Binding SwitchToInboxViewCommand}">

                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Inbox" Margin="0 0 0 0" />
                </MenuItem.Icon>

            </MenuItem>

            <MenuItem Header="Today"
                        Template="{StaticResource NavMenuItem_Template}"
                        Command="{Binding SwitchToTodayViewCommand}">

                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="CalendarToday" Margin="0 0 0 0" />
                </MenuItem.Icon>

            </MenuItem>

            <MenuItem Header="Projects" 
                      Template="{StaticResource NavMenuItem_Template}"
                      Command="{Binding SwitchToProjectsViewCommand}">

                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ClipboardText" Margin="0 0 0 0" />
                </MenuItem.Icon>

            </MenuItem>

            <MenuItem Header="Contexts" 
                      Template="{StaticResource NavMenuItem_Template}"
                      Command="{Binding SwitchToContextsViewCommand}">

                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Animation" Margin="0 0 0 0" />
                </MenuItem.Icon>

            </MenuItem>

            <MenuItem Header="Completed" 
                      Template="{StaticResource NavMenuItem_Template}"
                      Command="{Binding SwitchToCompletedViewCommand}">

                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="PlaylistCheck" Margin="0 0 0 0" />
                </MenuItem.Icon>

            </MenuItem>

        </Menu>

    </ControlTemplate>

</ResourceDictionary>