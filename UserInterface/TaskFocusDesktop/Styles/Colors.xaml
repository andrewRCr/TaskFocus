<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" >

    <Color x:Key="BackgroundDarkGrey">#27272f</Color> 
    <SolidColorBrush x:Key="BackgroundDarkGreyBrush" Color="{StaticResource BackgroundDarkGrey}" />

    <Color x:Key="BackgroundMidGrey">#2f2f37</Color> 
    <SolidColorBrush x:Key="BackgroundMidGreyBrush" Color="{StaticResource BackgroundMidGrey}" />

    <Color x:Key="BackgroundSeparatorGrey">#2d2d35</Color>
    <SolidColorBrush x:Key="BackgroundSeparatorGreyBrush" Color="{StaticResource BackgroundSeparatorGrey}" />

    <Color x:Key="BackgroundLightGrey">#373740</Color>
    <SolidColorBrush x:Key="BackgroundLightGreyBrush" Color="{StaticResource BackgroundLightGrey}" />

    <Color x:Key="BackgroundLightestGrey">#3f3f3f</Color>
    <SolidColorBrush x:Key="BackgroundLightestGreyBrush" Color="{StaticResource BackgroundLightestGrey}" />

    <Color x:Key="ForegroundMain">#c2c2c5</Color>
    <SolidColorBrush x:Key="ForegroundMainBrush" Color="{StaticResource ForegroundMain}" />

    <Color x:Key="ForegroundSecondary">#939397</Color>
    <SolidColorBrush x:Key="ForegroundSecondaryBrush" Color="{StaticResource ForegroundSecondary}" />

    <Color x:Key="ForegroundTertiary">#737379</Color>
    <SolidColorBrush x:Key="ForegroundTertiaryBrush" Color="{StaticResource ForegroundTertiary}" />

    <Color x:Key="ForegroundHighlight">#776be7</Color>
    <SolidColorBrush x:Key="ForegroundHighlightBrush" Color="{StaticResource ForegroundHighlight}" />

    <Color x:Key="ForegroundHighlightSecondary">#2c2b3a</Color>
    <SolidColorBrush x:Key="ForegroundHighlightSecondaryBrush" Color="{StaticResource ForegroundHighlightSecondary}" />

    <Color x:Key="ErrorRed">#f64e62</Color>
    <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRed}" />

    <Color x:Key="ErrorRedSecondary">#543c44</Color>
    <SolidColorBrush x:Key="ErrorRedSecondaryBrush" Color="{StaticResource ErrorRedSecondary}" />

    <Color x:Key="WindowsFrame">#646464</Color>
    <SolidColorBrush x:Key="WindowsFrameBrush" Color="{StaticResource WindowsFrame}" />

</ResourceDictionary>