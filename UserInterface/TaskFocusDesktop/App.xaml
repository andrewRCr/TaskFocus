<Application x:Class="TaskFocusDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskFocusDesktop"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities">

    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary>
                    <local:Bootstrapper x:Key="Bootstrapper" />
                </ResourceDictionary>

                <!-- material design styling base -->
                <materialDesign:CustomColorTheme BaseTheme="Dark" PrimaryColor="#776be7" SecondaryColor="Red" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <!-- custom styling (order matters) -->
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Fonts.xaml" />
                <ResourceDictionary Source="Styles/Checkboxes.xaml" />
                <ResourceDictionary Source="Styles/Buttons.xaml" />
                <ResourceDictionary Source="Styles/Texts.xaml" />
                <ResourceDictionary Source="Styles/ContentViews.xaml" />
                <ResourceDictionary Source="Styles/ListBoxes.xaml" />
                <ResourceDictionary Source="Styles/Windows.xaml" />
                
                <!-- custom user control templates -->
                <ResourceDictionary Source="Templates/DialogTemplates.xaml" />
                <ResourceDictionary Source="Templates/MiniNavMenuTemplate.xaml" />
                <ResourceDictionary Source="Templates/NavMenuItemTemplate.xaml" />
                <ResourceDictionary Source="Templates/TaskItemTemplate.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <utilities:InvertableBooleanToVisibilityConverter x:Key="InvertableBooleanToVisibilityConverter" />
            <utilities:ActiveMainViewToVisibilityConverter x:Key="ActiveMainViewToVisibilityConverter" />
            <utilities:DictionaryItemBooleanToVisibilityConverter x:Key="DictionaryItemBooleanToVisibilityConverter" />

            <!-- app-level styling -->

            <!-- MudBlazor default dark grey background : #27272f -->
            <!-- MudBlazor lighter grey background: #373740-->
            <!-- MudBlazor primary purple: #776be7 -->
            <!-- MudBlazor very light grey text color: #c2c2c5 -->
            <!-- MudBlazor light grey text color: #939397 -->
            
            <!-- default base styling for all windows -->
            <!--<Style x:Key="WindowDefaults" TargetType="{x:Type Window}">
                <Setter Property="Background" Value="#27272f" />
                <Setter Property="FontFamily" Value="Helvetica Neue" />
                <Setter Property="TextBlock.Foreground" Value="#c2c2c5" />
            </Style>-->

            <!-- default base styling for all windows -->
            <!--<Style x:Key="WindowDefaults" TargetType="{x:Type Window}">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesignBody}" />
                <Setter Property="TextElement.FontWeight" Value="Regular" />
                <Setter Property="TextElement.FontSize" Value="13" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
                <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}" />
                <Setter Property="FontFamily" Value="{DynamicResource MaterialDesignFont}" />
            </Style>-->

        </ResourceDictionary>
    </Application.Resources>
    
</Application>
