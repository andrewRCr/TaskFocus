<Application x:Class="TaskFocusDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskFocusDesktop"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities" >

    <Application.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary>
                    <local:Bootstrapper x:Key="Bootstrapper" />
                </ResourceDictionary>

                <!-- material design styling base -->
                <materialDesign:CustomColorTheme BaseTheme="Dark" PrimaryColor="#776be7" SecondaryColor="Red" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

                <!-- custom styling (order matters) -->
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Fonts.xaml" />
                <ResourceDictionary Source="Styles/Buttons.xaml" />
                <ResourceDictionary Source="Styles/Texts.xaml" />
                <ResourceDictionary Source="Styles/ContentViews.xaml" />
                <ResourceDictionary Source="Styles/ListBoxes.xaml" />
                <ResourceDictionary Source="Styles/Windows.xaml" />

                <!-- custom user control templates -->
                <ResourceDictionary Source="Templates/DialogTemplates.xaml" />
                <ResourceDictionary Source="Templates/MiniNavMenuTemplate.xaml" />
                <ResourceDictionary Source="Templates/NavMenuItemTemplate.xaml" />
                <ResourceDictionary Source="Templates/TaskItemTemplate.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <utilities:InvertableBooleanToVisibilityConverter x:Key="InvertableBooleanToVisibilityConverter" />
            <utilities:ActiveMainViewToVisibilityConverter x:Key="ActiveMainViewToVisibilityConverter" />
            <utilities:DictionaryItemBooleanToVisibilityConverter x:Key="DictionaryItemBooleanToVisibilityConverter" />
            <utilities:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <utilities:IsTaskOverdueConverter x:Key="IsTaskOverdueConverter" />

        </ResourceDictionary>
    </Application.Resources>
    
</Application>
