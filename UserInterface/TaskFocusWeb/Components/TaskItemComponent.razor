
<MudForm Model="@TaskParam" >

    <MudStack Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center" 
              @onmouseover="()=> SetElementsActive(true)" @onmouseleave="()=> SetElementsActive(false)">

        <div class="d-flex align-center ml-1">
            <!-- drag indicator icon -->
            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" />
            <div class="ml-n1">
                <!-- starred/today input -->
                <MudCheckBox Class="@starredClassStr" @bind-Value="TaskParam.Completed" Size="Size.Medium" Color="Color.Default"
                             CheckedIcon="@Icons.Material.Filled.Star" UncheckedIcon="@Icons.Material.Filled.StarOutline" />
            </div>
            <div class="ml-n3">
                <!-- completed input -->
                <MudCheckBox @bind-Value="TaskParam.Completed" Size="Size.Small"></MudCheckBox>
            </div>
        </div>
        
        <MudGrid Class="pb-4">
   
            <!-- taskName input -->
            <MudItem xs="3">
                <MudTextField @bind-Value="TaskParam.TaskName" Placeholder="Task" Variant="Variant.Text" Margin="Margin.Dense" 
                              Clearable=@isTaskNameClearable @onmouseenter="()=> SetIsTaskNameClearable(true)" AutoGrow />
            </MudItem>

            <!-- projectName input -->
            <MudItem xs="2" @onmouseenter="()=> SetIsProjectNameClearable(true)" @onmouseleave="()=> SetIsProjectNameClearable(false)">
                <MudSelect T="string" Placeholder="Project" AnchorOrigin="Origin.BottomCenter" @bind-Value="TaskParam.ProjectName" Margin="Margin.Dense"
                           Clearable=@isProjectNameClearable >
                    @foreach (ProjectModel project in ProjectsParam)
                    {
                        <MudSelectItem Value="@(project.ProjectName)">@project.ProjectName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- contextName input -->
            <MudItem xs="2" @onmouseenter="()=> SetIsContextNameClearable(true)" @onmouseleave="()=> SetIsContextNameClearable(false)">
                <MudSelect T="string" Placeholder="Context" AnchorOrigin="Origin.BottomCenter" @bind-Value="TaskParam.ContextName" Margin="Margin.Dense"
                           Clearable=@isContextNameClearable>
                    @foreach (ContextModel context in ContextsParam)
                    {
                        <MudSelectItem Value="@(context.ContextName)">@context.ContextName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <!-- due date input -->
            <MudItem xs="2">
                <MudDatePicker Placeholder="Due" @bind-Date="TaskParam.DueDate" Margin="Margin.Dense" Clearable />
            </MudItem>

        </MudGrid>

    </MudStack>

</MudForm>

@code {
    [Parameter]
    public TaskDisplayModel TaskParam { get; set; } = default!;

    [Parameter]
    public List<ProjectModel> ProjectsParam { get; set; } = default!;

    [Parameter]
    public List<ContextModel> ContextsParam { get; set; } = default!;

    bool isTaskNameClearable = false;
    bool isProjectNameClearable = false;
    bool isContextNameClearable = false;
    bool showStarIcon = false;
    string starredClassStr = "invisible";

    void SetIsTaskNameClearable(bool newClearable)
    {
        isTaskNameClearable = newClearable;
    }

    void SetIsProjectNameClearable(bool newClearable)
    {
        isProjectNameClearable = newClearable;
    }

    void SetIsContextNameClearable(bool newClearable)
    {
        isContextNameClearable = newClearable;
    }

    void SetElementsActive(bool newActive)
    {
        showStarIcon = newActive;

        if (newActive) { starredClassStr = string.Empty; }
        else
        {
            // TODO: once Starred is its own TaskModel property, swap over from Completed (just placeholder prop for Starred)
            if (!TaskParam.Completed) { starredClassStr = "invisible"; }
            SetIsTaskNameClearable(false);
        }
    }
}