
<MudForm Model="@TaskParam">

    <MudStack Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center">
        
        <!-- completed input -->
        <MudCheckBox @bind-Value="TaskParam.Completed"></MudCheckBox>

        <MudGrid>
            <!-- taskName input -->
            <MudItem xs="3">
                <MudTextField @bind-Value="TaskParam.TaskName" Label="Task" Variant="Variant.Text"></MudTextField>
            </MudItem>

            <!-- projectId input -->
            <MudItem xs="2">
            <MudSelect T="int?" Label="Project" AnchorOrigin="Origin.BottomCenter" @bind-Value="TaskParam.ProjectId">
                @foreach (ProjectModel project in ProjectsParam)
                {
                    <MudSelectItem Value="@(project.Id)">@project.ProjectName</MudSelectItem>
                }
            </MudSelect>
                </MudItem>

            <!-- contextId input -->
            <MudItem xs="2">
            <MudSelect T="int?" Label="Context" AnchorOrigin="Origin.BottomCenter" @bind-Value="TaskParam.ContextId">
                @foreach (ContextModel context in ContextsParam)
                {
                    <MudSelectItem Value="@(context.Id)">@context.ContextName</MudSelectItem>
                }
            </MudSelect>
            </MudItem>

            <!-- due date input -->
            <MudItem xs="2">
            <MudDatePicker Label="Due" @bind-Date="TaskParam.DueDate" />
            </MudItem>

        </MudGrid>

    </MudStack>

</MudForm>

@code {
    [Parameter]
    public TaskModel TaskParam { get; set; } = default!;

    [Parameter]
    public List<ProjectModel> ProjectsParam { get; set; } = default!;

    [Parameter]
    public List<ContextModel> ContextsParam { get; set; } = default!;
}