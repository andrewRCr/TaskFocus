

<div class="col-8 mb-3">
    <div class="container">
        <div class="row">

            <EditForm Model="@TaskParam">
                <div class="form-group row">
                    <div class="col-1" style="display:flex; align-items:center;">
                        <InputCheckbox id="completed" class="form-check-inline" @bind-Value="TaskParam.Completed" />
                    </div>
                    <div class="col-3">
                        <InputText id="task-name" class="form-control border-0" @bind-Value="TaskParam.TaskName" placeholder="TaskName" />
                    </div>
                    <div class="col-2">
                        <InputSelect id="assigned-project" style="@GetColor("ProjectId")"
                                     @onfocusin="() => OnProjectInputSelected(true)" @onfocusout="() => OnProjectInputSelected(false)"
                                     class="form-select border-0" @bind-Value="TaskParam.ProjectId" >
                            <option hidden disabled selected value="">Project</option>
                            @foreach (ProjectModel project in ProjectsParam)
                            {
                                <option value="@project.Id">@project.ProjectName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-2">
                        <InputSelect id="assigned-context" style="@GetColor("ContextId")"
                                     @onfocusin="() => OnContextInputSelected(true)" @onfocusout="() => OnContextInputSelected(false)"
                                     class="form-select border-0" @bind-Value="TaskParam.ContextId" placeholder="Context">
                            <option hidden disabled selected value="">Context</option>
                            @foreach (ContextModel context in ContextsParam)
                            {
                                <option value="@context.Id">@context.ContextName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-2">
                        
                        <InputDate id="due-date" style="@GetColor("DueDate")"
                                   @onfocusin="() => OnDueDateInputSelected(true)" @onfocusout="() => OnDueDateInputSelected(false)"
                                   class="form-control border-0" @bind-Value="TaskParam.DueDate" />
                    </div>
                </div>
            </EditForm>    
        </div>
    </div>
</div>

@code {
    [Parameter]
    public TaskModel TaskParam { get; set; }

    [Parameter]
    public List<ProjectModel> ProjectsParam { get; set; }

    [Parameter]
    public List<ContextModel> ContextsParam { get; set; }

    private bool projectSelectIsFocused = false;
    private bool contextSelectIsFocused = false;
    private bool dueDateSelectIsFocused = false;

    public TaskItemComponent()
    {
        TaskParam = new();
        ProjectsParam = new();
        ContextsParam = new();
    }

    public string GetColor(string taskProperty)
    {
        switch (taskProperty)
        {
            case "ProjectId":
                if (projectSelectIsFocused) { return "color:black;"; }
                else if (TaskParam.ProjectId == null) { return "color:gray;"; }
                break;

            case "ContextId":
                if (contextSelectIsFocused) { return "color:black;"; }
                if (TaskParam.ContextId == null) { return "color:gray;"; }
                break;

            case "DueDate":
                if (dueDateSelectIsFocused) { return "color:black;"; }
                if (TaskParam.DueDate == null) { return "color:gray;"; }
                break;

            default:
                break;
        }

        return "color:black;";
    }

    private void OnProjectInputSelected(bool isFocused)
    {
        SetInputIsFocused("ProjectId", isFocused);
    }

    private void OnContextInputSelected(bool isFocused)
    {
        SetInputIsFocused("ContextId", isFocused);
    }

    private void OnDueDateInputSelected(bool isFocused)
    {
        SetInputIsFocused("DueDate", isFocused);
    }

    private void SetInputIsFocused(string taskProperty, bool isFocused)
    {
        switch (taskProperty)
        {
            case "ProjectId":
                projectSelectIsFocused = isFocused;
                break;

            case "ContextId":
                contextSelectIsFocused = isFocused;
                break;

            case "DueDate":
                dueDateSelectIsFocused = isFocused;
                break;

            default:
                break;
        }
    }
}