
<div class="col-8 mb-3">
    <div class="container">
        <div class="row">

            <EditForm Model="@TaskParam">
                <div class="form-group row">
                    <div class="col-1" style="display:flex; align-items:center;">
                        <InputCheckbox id="completed" class="form-check-inline" @bind-Value="TaskParam.Completed" />
                    </div>
                    <div class="col-3">
                        <InputText id="task-name" class="form-control border-0" @bind-Value="TaskParam.TaskName" placeholder="TaskName" />
                    </div>
                    <div class="col-2">
                        <InputSelect id="assigned-project" @onfocusin="BlackProjectDropdownTextColor" @onfocusout="GrayProjectDropdownTextColor" style="@GetColor("ProjectId")"
                                     class="form-select border-0" @bind-Value="TaskParam.ProjectId" placeholder="Project">
                            <option disabled selected value="">Project</option>
                            @foreach (ProjectModel project in ProjectsParam)
                            {
                                <option value="@project.Id">@project.ProjectName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-2">
                        <InputSelect id="assigned-context" @onfocusin="BlackProjectDropdownTextColor" @onfocusout="GrayProjectDropdownTextColor" style="@GetColor("ContextId")" 
                                     class="form-select border-0" @bind-Value="TaskParam.ContextId" placeholder="Context">
                            <option disabled selected value="">Context</option>
                            @foreach (ContextModel context in ContextsParam)
                            {
                                <option value="@context.Id">@context.ContextName</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-2">
                        
                        <InputDate style="@GetColor("DueDate")" id="due-date" class="form-control border-0" @bind-Value="TaskParam.DueDate" />
                    </div>
                </div>
            </EditForm>    
        </div>
    </div>
</div>

@code {
    [Parameter]
    public TaskModel TaskParam { get; set; }

    [Parameter]
    public List<ProjectModel> ProjectsParam { get; set; }

    [Parameter]
    public List<ContextModel> ContextsParam { get; set; }

    private bool shouldBeBlack = false;

    public string GetColor(string taskProperty)
    {
        if (shouldBeBlack)
        {
            return "color:black;";
        }

        switch (taskProperty)
        {
            case "ProjectId":
                if (TaskParam.ProjectId == null) { return "color:gray;"; }
                break;

            case "ContextId":
                if (TaskParam.ContextId == null) { return "color:gray;"; }
                break;

            case "DueDate":
                if (TaskParam.DueDate == null) { return "color:gray;"; }
                break;

            default:
                break;
        }

        return "color:black;";
    }

    private void BlackProjectDropdownTextColor()
    {
        shouldBeBlack = true;
    }

    private void GrayProjectDropdownTextColor()
    {
        if (TaskParam.ProjectId == null)
        {
            shouldBeBlack = false;
        }
    }
}
