<MudExpansionPanels DisableBorders="true" Elevation="0" MultiExpansion="true">
    <MudDropContainer T="ContextDisplayModel" Items="@ContainerContextItemsParam" ItemsSelector="@ContainerItemsSelectorParam" Class="5">
        <ChildContent>
            <MudDropZone T="ContextDisplayModel" AllowReorder Class="6 rounded mud-background-gray px-2 py-1 ma-2" />
        </ChildContent>
        <ItemRenderer>
            <MudPaper Elevation=25 Class="pa-0 my-2">

                <MudExpansionPanel IsExpanded="@IsExpanded" DisableGutters="true" Dense="true" Class="pa-0 my-2">
                    <TitleContent>
                        <div class="d-flex">
                            <MudText><strong>@context.ContextName</strong></MudText>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <MudDropZone T="TaskDisplayModel" Identifier="@context.ContextName" AllowReorder Class="mud-background-gray px-3 py-2 ma-0" />
                    </ChildContent>
                </MudExpansionPanel>

            </MudPaper>
        </ItemRenderer>
    </MudDropContainer>
</MudExpansionPanels>

@code {
    [Parameter]
    public List<ContextDisplayModel> ContainerContextItemsParam { get; set; } = default!;

    [Parameter]
    public Func<ContextDisplayModel, string, bool> ContainerItemsSelectorParam { get; set; } = default!;

    [Parameter]
    public bool IsExpanded { get; set; } = false;
}