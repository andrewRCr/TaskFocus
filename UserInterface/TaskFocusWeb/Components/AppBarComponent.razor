@inherits _ComponentStateAwareBase
@inject IDataService DataService
@inject ISnackbar Snackbar

<MudAppBar Bottom="true" 
Fixed="true" 
Color="Color.Transparent" 
Elevation="0" >


        <MudGrid Justify="Justify.Center">

            <MudItem xs="1" Class="mt-2">

            @if (DataService.IsDataStateLoaded())
            {
                <MudIconButton Class="rounded-circle"
                Icon="@Icons.Material.Filled.Add"
                Color="Color.Primary"
                Variant="Variant.Filled"
                Size="Size.Large"
                Edge="Edge.Start"
                OnClick="ShowNewTaskInput" />
            }

            </MudItem>

            <MudItem xs="10">
                <MudSpacer />
            </MudItem>

            <MudItem xs="1" Class="mt-2">
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudText Align="Align.Right">Status: <MudText Inline="true" Color="@GetSyncStatusColor()">@GetSyncStatusString()</MudText></MudText>
                </MudStack>
            </MudItem>

        </MudGrid>
    

</MudAppBar>

<MudDialog @bind-IsVisible=_newTaskInputsVisible 
Options="dialogOptions"
Style="background-color: #27272f" >

    <TitleContent>
        <MudStack Row="true" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Add" />
            <MudText Typo="Typo.button">Add new task</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>

        <MudPaper Outlined Style="background-color: #373740;" Class="pa-4 ma-0" Elevation="3">

            <MudStack Row="true">

                <MudForm @ref="_newTaskForm" 
                @bind-IsValid="@_newTaskIsValid" 
                @bind-Errors="@_newTaskErrors" 
                Model="_newTask">

                    <MudGrid Justify="Justify.SpaceAround" Spacing="@(_gridSpacing)">

                        @if (_newTaskInputsVisible)
                        {
                            <!-- taskName input -->
                            <MudItem xs="8" sm="5" md="3" lg="3" xl="3">

                                <MudTextField @bind-Value="_newTask.TaskName" 
                                Placeholder="Task" 
                                Variant="Variant.Text" 
                                Margin="Margin.Dense"
                                Required="true"
                                RequiredError=" "
                                AutoGrow 
                                AutoFocus="false" />
                            </MudItem>

                            <!-- projectName input-->
                            <MudItem xs="8" sm="5" md="3" lg="3" xl="3">

                                <MudAutocomplete @ref="_projectSelectInput"
                                T="string"
                                @bind-Value="_newTask.ProjectName"
                                SearchFunc="@((x)=> ItemCollectionSearch(_projectNames, x))"
                                Margin="Margin.Dense"
                                Dense="true"
                                Placeholder="Project"
                                Disabled="@_isProjectInputDisabled"
                                AnchorOrigin="Origin.BottomCenter"
                                ResetValueOnEmptyText="true"
                                Strict="false"
                                CoerceText="true"
                                SelectOnClick="true"
                                SelectValueOnTab="true">

                                    <ItemTemplate Context="e">
                                        <MudText>
                                            @($"{e}")
                                        </MudText>
                                    </ItemTemplate>
                                </MudAutocomplete>
                            </MudItem>

                            <!-- contextName input-->
                            <MudItem xs="8" sm="5" md="3" lg="3" xl="3">

                                <MudAutocomplete @ref="_contextSelectInput"
                                T="string"
                                @bind-Value="_newTask.ContextName"
                                SearchFunc="@((x) => ItemCollectionSearch(_contextNames, x))"
                                Margin="Margin.Dense"
                                Dense="true"
                                Placeholder="Context"
                                Disabled="@_isContextInputDisabled"
                                AnchorOrigin="Origin.BottomCenter"
                                ResetValueOnEmptyText="true"
                                Strict="false"
                                CoerceText="true"
                                SelectOnClick="true"
                                SelectValueOnTab="true">

                                    <ItemTemplate Context="e">
                                        <MudText>
                                            @($"{e}")
                                        </MudText>
                                    </ItemTemplate>
                                </MudAutocomplete>
                            </MudItem>

                            <!-- due date input -->
                            <MudItem xs="8" sm="5" md="2" lg="2" xl="2">

                                <MudDatePicker @ref="_datePicker"
                                @bind-Date="_newTask.DueDate"
                                OnClick="()=> _datePicker.SelectAsync()"
                                Placeholder="Due"
                                Margin="Margin.Dense"
                                DisableToolbar="true"
                                Editable="true"
                                AutoClose="false">

                                    <PickerActions>
                                        <MudButton Class="mr-auto align-self-start" OnClick="@(() => _datePicker.Clear())">Clear</MudButton>
                                        <MudButton OnClick="@(() => _datePicker.Close(false))">Cancel</MudButton>
                                        <MudButton Color="Color.Primary" OnClick="@(() => _datePicker.Close())">Ok</MudButton>
                                    </PickerActions>
                                </MudDatePicker>
                            </MudItem>
                        }
                    </MudGrid>
                </MudForm>
            </MudStack>
        </MudPaper>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="()=>_newTaskInputsVisible = false" Class="px-0">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="TrySubmitNewTask" Class="px-0">Add</MudButton>
    </DialogActions>

</MudDialog>

@code {
    private bool _newTaskInputsVisible = false;
    private int _gridSpacing = 3;

    private TaskDisplayModel _newTask = default!;
    private string[] _projectNames = { };
    private string[] _contextNames = { };
    private bool _isProjectInputDisabled = false;
    private bool _isContextInputDisabled = false;

    private string? _focusedProjectIdStr = null;
    public ProjectDisplayModel ProjectParam { get; set; } = default!;
    private string? _focusedContextIdStr = null;
    public ContextDisplayModel ContextParam { get; set; } = default!;
    int integerProjectId;
    int integerContextId;

    private MudForm _newTaskForm = default!;
    private bool _newTaskIsValid;
    private string[] _newTaskErrors = { };
    string? errorMessage;

    private MudAutocomplete<string> _projectSelectInput = default!;
    private MudAutocomplete<string> _contextSelectInput = default!;
    private MudDatePicker _datePicker = default!;

    private DialogOptions dialogOptions = new() {
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            NoHeader = false,
            CloseOnEscapeKey = true
    };

    private MudBlazor.Color GetSyncStatusColor()
    {
        return GetSyncStatusString() == "Synchronized" ? Color.Primary : Color.Default;
    }

    protected override async Task OnInitializedAsync()
    {
        dataRefreshTriggers = new List<string> { 
            nameof(EDataRefreshType.Tasks), 
            nameof(EDataRefreshType.Projects), 
            nameof(EDataRefreshType.Contexts),
            nameof(EDataRefreshType.SyncStatus)};
    }

    protected override void CustomAuthenticatedOnInit()
    {
        _newTask = new();
        UpdateProjectContextSelectionLists();
        _focusedProjectIdStr = AppState.FocusedProjectIdStr;
        _focusedContextIdStr = AppState.FocusedContextIdStr;

        // context-awareness: if on Projects or Contexts pages and have highlighted in the UI a particular one, pre-populate field
        if (_focusedProjectIdStr != null && AppState.ShowProjectSubMenu)
        {
            GetProjectFromId();
            if (ProjectParam != null) _newTask.ProjectName = ProjectParam.ProjectName;
        }
        else if (_focusedContextIdStr != null && AppState.ShowContextSubMenu)
        {
            GetContextFromId();
            if (ContextParam != null) _newTask.ContextName = ContextParam.ContextName; 
        }
    }

    private async void ShowNewTaskInput()
    {
        await VerifyAuthAndRedirectIfExpired();

        CustomAuthenticatedOnInit(); 
        _newTaskInputsVisible = true;      
    }

    private void UpdateProjectContextSelectionLists()
    {
        if (DataService.GetDataStateProjects() != null && DataService.GetDataStateProjects()!.Count > 0)
        {
            List<string> projectParamNamesOnly = new();
            foreach (ProjectDisplayModel project in DataService.GetDataStateProjects()!)
            { projectParamNamesOnly.Add(project.ProjectName); }

            _projectNames = projectParamNamesOnly.ToArray();
        }
        else
        { _isProjectInputDisabled = true; }

        if (DataService.GetDataStateContexts() != null && DataService.GetDataStateContexts()!.Count > 0)
        {
            List<string> contextParamNamesOnly = new();
            foreach (ContextDisplayModel context in DataService.GetDataStateContexts()!)
            { contextParamNamesOnly.Add(context.ContextName); }

            _contextNames = contextParamNamesOnly.ToArray();
        }
        else { _isContextInputDisabled = true; }
    }

    private Task<IEnumerable<string>> ItemCollectionSearch(string[] itemCollection, string value)
    {
        IEnumerable<string> items = itemCollection;

        // if text is null or empty, show complete list
        if (string.IsNullOrEmpty(value)) { return Task.FromResult(items); }

        var result = items
            .Where(item => item.Contains(value, StringComparison.InvariantCultureIgnoreCase))
            ?? itemCollection;

        return Task.FromResult(result);
    }

    private async Task TrySubmitNewTask()
    {
        await VerifyAuthAndRedirectIfExpired();

        await _newTaskForm.Validate();
        if (_newTaskForm.IsValid)
        {
            _newTaskInputsVisible = false;
            OnValidNewTaskSubmit();
        }
        else { Snackbar.Add("Unable to add task; please try again.", Severity.Error); }
    }

    private void OnValidNewTaskSubmit()
    {
        errorMessage = string.Empty;

        try
        {
            DataService.AddTask(_newTask);
            Snackbar.Add("Task added.", Severity.Success);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    protected void GetProjectFromId()
    {
        bool isValid = int.TryParse(_focusedProjectIdStr, out integerProjectId);
        if (isValid)
        {
            ProjectParam = DataService.GetDataStateProjects()!.Find(x => x.Id == integerProjectId)!;
        }
    }

    protected void GetContextFromId()
    {
        bool isValid = int.TryParse(_focusedContextIdStr, out integerContextId);
        if (isValid)
        {
            ContextParam = DataService.GetDataStateContexts()!.Find(x => x.Id == integerContextId)!;
        }
    }

    protected override bool HandleDataStateChanged(string propertyName, IDataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName)) return false;
        else if (AppState.CanRefresh)
        {
            //GetSyncStatusString();
            GetSyncStatusColor();
            //Console.WriteLine($"AppBarComponent returned True on HandleDataStateChanged, due to {propertyName}");
        }

        return AppState.CanRefresh;
    }
}
