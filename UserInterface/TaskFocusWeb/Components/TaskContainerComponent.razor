@inherits _ComponentBase

@if (ContainerTaskItemsParam.Count > 0)
{
    <MudDropContainer @ref=_container
                      T="TaskDisplayModel"
                      Items="@ContainerTaskItemsParam"
                      ItemsSelector="@ContainerItemsSelectorParam"
                      ItemPicked="()=>SetCanRefresh(false)"
                      ItemDropped="OnItemDropped">

        <ChildContent>
            <MudDropZone T="TaskDisplayModel"
                         Identifier="@ContainerIdentifierParam"
                         AllowReorder="@CanReorderParam"
                         ItemIsDisabled="(task)=>IsDraggingDisabled(task)"
                         Class="rounded mud-background-gray px-2 py-1 ma-2" />
        </ChildContent>

        <ItemRenderer>
            <MudPaper Elevation="25" Class="pa-0 my-2">
                <TaskItemComponent TaskParam="@context"
                                   ProjectsParam="@ContainerProjectsParam"
                                   ContextsParam="@ContainerContextsParam" />
            </MudPaper>
        </ItemRenderer>

    </MudDropContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraSmall">
        <MudPaper Elevation="25" Class="pa-0 my-0">
            <MudText Class="pa-3" Align="Align.Center">
                <i>No tasks assigned.</i>
            </MudText>
        </MudPaper>
    </MudContainer>
}

@code {
    [Parameter]
    public List<TaskDisplayModel> ContainerTaskItemsParam { get; set; } = default!;

    [Parameter]
    public string ContainerIdentifierParam { get; set; } = default!;

    [Parameter]
    public string ContainerOrderingTypeParam { get; set; } = default!;

    [Parameter]
    public bool CanReorderParam { get; set; } = true;

    [Parameter]
    public List<ProjectDisplayModel> ContainerProjectsParam { get; set; } = default!;

    [Parameter]
    public List<ContextDisplayModel> ContainerContextsParam { get; set; } = default!;

    [Parameter]
    public Func<TaskDisplayModel, string, bool> ContainerItemsSelectorParam { get; set; } = default!;

    private MudDropContainer<TaskDisplayModel> _container = default!;
    private string _orderingIndex = string.Empty;

    protected override void CustomAuthenticatedOnInit()
    {
        //Console.WriteLine($"ContainerOrderingTypeParam: {ContainerOrderingTypeParam}");
        if (CanReorderParam)
        {
            _orderingIndex = ContainerOrderingTypeParam + "Index";
            ContainerTaskItemsParam = ContainerTaskItemsParam.OrderBy(x => x[_orderingIndex]).ToList();
        }

        //Console.WriteLine($"_orderingIndex: {_orderingIndex}");
    }

    private bool IsDraggingDisabled(TaskDisplayModel task)
    {
        return !CanReorderParam;
    }

    private void OnItemDropped(MudItemDropInfo<TaskDisplayModel> dropItem)
    {
        //Console.WriteLine("item dropped!");
        UpdateLocalOrder(dropItem);
        SetCanRefresh(true);
    }

    private void RefreshContainer()
    {
        ContainerTaskItemsParam = ContainerTaskItemsParam.OrderBy(x => x[_orderingIndex]).ToList();
        StateHasChanged(); // update the binding to the container
        _container.Refresh(); // container refreshes internal state
    }

    private void UpdateLocalOrder(MudItemDropInfo<TaskDisplayModel> reorderedDropItem)
    {
        //Console.WriteLine(_orderingIndex);
        int oldIndex = (int)reorderedDropItem.Item![_orderingIndex]!;
        var newIndex = reorderedDropItem.IndexInZone;

        if (oldIndex > -1)
        {
            var oldItem = ContainerTaskItemsParam[oldIndex];
            if (newIndex > -1)
            {
                ContainerTaskItemsParam.RemoveAt(oldIndex);
                ContainerTaskItemsParam.Insert(newIndex, oldItem);
                UpdateRemoteOrder(reorderedDropItem);
            }
        }
    }

    private void UpdateRemoteOrder(MudItemDropInfo<TaskDisplayModel> reorderedDropItem)
    {
        foreach (var item in ContainerTaskItemsParam)
        {
            // will trigger an API UpdateTaskData call
            item[_orderingIndex] = ContainerTaskItemsParam.IndexOf(item);
            Console.WriteLine($"{item.TaskName} OrderingIndex({_orderingIndex}): {item[_orderingIndex]}");
        }
    }

    protected override bool HandleDataStateChanged(String propertyName, IDataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            //Console.WriteLine("TaskContainerComp: returned true on HandleDataStateChanged!");
            if (CanReorderParam && _container != null) { RefreshContainer(); }
        }

        return AppState.CanRefresh;
    }
} 