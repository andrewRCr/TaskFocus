@inherits _ComponentBase

<MudDropContainer T="TaskDisplayModel" Items="@ContainerTaskItemsParam" ItemsSelector="@ContainerItemsSelectorParam"
                  ItemPicked="()=>SetCanRefresh(false)"
                  ItemDropped="OnItemDropped"
                    >
    <ChildContent>
        <MudDropZone T="TaskDisplayModel" Identifier="@ContainerIdentifierParam" AllowReorder="true" Class="rounded mud-background-gray px-2 py-1 ma-2">
@*             <MudText Typo="Typo.h6" Class="mb-2">@ContainerIdentifierParam</MudText> *@
        </MudDropZone>
    </ChildContent>
    <ItemRenderer>
        <MudPaper Elevation="25" Class="pa-0 my-2">
            <TaskItemComponent TaskParam="@context" ProjectsParam="@ContainerProjectsParam" ContextsParam="@ContainerContextsParam" />
        </MudPaper>
    </ItemRenderer>
</MudDropContainer>


@code {

    [Parameter]
    public List<TaskDisplayModel> ContainerTaskItemsParam { get; set; } = default!;

    [Parameter]
    public string ContainerIdentifierParam { get; set; } = default!;

    [Parameter]
    public List<ProjectDisplayModel> ContainerProjectsParam { get; set; } = default!;

    [Parameter]
    public List<ContextDisplayModel> ContainerContextsParam { get; set; } = default!;

    [Parameter]
    public Func<TaskDisplayModel, string, bool> ContainerItemsSelectorParam { get; set; } = default!;

    private void OnItemDropped()
    {
        Console.WriteLine("item dropped!");
        SetCanRefresh(true);
        StateHasChanged();
    }

    protected override bool HandleDataStateChanged(String propertyName, DataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            Console.WriteLine("TaskContainerComp: returned true on HandleDataStateChanged!");
        }

        return AppState.CanRefresh;
    }
} 