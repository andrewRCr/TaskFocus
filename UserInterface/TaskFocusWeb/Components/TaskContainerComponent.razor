<MudDropContainer T="TaskModel" Items="@ContainerTaskItemsParam" ItemsSelector="@ContainerItemsSelectorParam" Class="d-flex flex-wrap flex-grow-1">
    <ChildContent>
        <MudDropZone T="TaskModel" Identifier="@ContainerIdentifierParam" AllowReorder="true" Class="6 rounded mud-background-gray px-2 py-1 ma-2 flex-grow-1">
@*             <MudText Typo="Typo.h6" Class="mb-2">@ContainerIdentifierParam</MudText> *@
        </MudDropZone>
    </ChildContent>
    <ItemRenderer>
        <MudPaper Elevation="25" Class="pa-0 my-2">
            <TaskItemComponent TaskParam="@context" ProjectsParam="@ContainerProjectsParam" ContextsParam="@ContainerContextsParam" />
        </MudPaper>
    </ItemRenderer>
</MudDropContainer>


@code {

    [Parameter]
    public List<TaskModel> ContainerTaskItemsParam { get; set; } = default!;

    [Parameter]
    public string ContainerIdentifierParam { get; set; } = default!;

    [Parameter]
    public List<ProjectModel> ContainerProjectsParam { get; set; } = default!;

    [Parameter]
    public List<ContextModel> ContainerContextsParam { get; set; } = default!;

    [Parameter]
    public Func<TaskModel, string, bool> ContainerItemsSelectorParam { get; set; } = default!;
} 