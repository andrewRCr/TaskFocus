@inherits _ComponentBase

<MudExpansionPanels DisableBorders="true" 
                    MultiExpansion="true"
                    Elevation="0">

        <MudDropContainer T="ProjectDisplayModel" 
                          Items="@ContainerProjectItemsParam" 
                          ItemsSelector="@ContainerItemsSelectorParam"
                          ItemPicked="()=>SetCanRefresh(false)"
                          ItemDropped="OnItemDropped">

            @foreach (ProjectDisplayModel project in ContainerProjectItemsParam)
            {
                <MudTreeView T="string">
                    <MudTreeViewItem Value="@project.ProjectName" 
                                     TextTypo="Typo.button" 
                                     Expanded="true" 
                                     Icon="@Icons.Material.Filled.AssignmentTurnedIn">

                            <MudDropZone T="TaskDisplayModel" 
                                         Identifier="@project.ProjectName" 
                                         AllowReorder="true" 
                                         Class="mud-background-gray px-3 py-2 ma-0" />
                    </MudTreeViewItem>
                </MudTreeView>
            }
        </MudDropContainer>
</MudExpansionPanels>

@code {
    [Parameter]
    public List<ProjectDisplayModel> ContainerProjectItemsParam { get; set; } = default!;

    [Parameter]
    public Func<ProjectDisplayModel, string, bool> ContainerItemsSelectorParam { get; set; } = default!;

    [Parameter]
    public bool IsExpanded { get; set; } = false;


    private void OnItemDropped()
    {
        //Console.WriteLine("item dropped!");
        SetCanRefresh(true);
        UpdateParametersFromDataState();
    }

    private void UpdateParametersFromDataState()
    {
        if (DataState.IsDataLoaded())
        {
            ContainerProjectItemsParam = DataState.Projects!;
            StateHasChanged();
        }
    }

    protected override bool HandleDataStateChanged(string propertyName, IDataState dataState)
    {
        if (propertyName != nameof(DataState.Projects))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            UpdateParametersFromDataState();
            //Console.WriteLine("ProjectContainerComp: returned true on HandleDataStateChanged!");
        }

        return AppState.CanRefresh;
    }
}
