@inherits ComponentBase
@implements IDisposable
@inject IAPIHelper ApiHelper
@inject IUserEndpoint UserEndpoint
@inject ITaskEndpoint TaskEndpoint
@inject IProjectEndpoint ProjectEndpoint
@inject IContextEndpoint ContextEndpoint
@inject IMapper Mapper
@inject IDataHelper DataHelper
@inject IDataService DataService

@code {
    [Inject]
    protected AppState AppState { get; private set; } = default!;

    [Inject]
    protected DataState DataState { get; private set; } = default!;

    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; } = default!;

    protected List<string> dataRefreshTriggers = new List<string> { 
        nameof(DataState.Tasks), nameof(DataState.Projects), nameof(DataState.Contexts) };

    private List<TaskDisplayModel>? _localTasks;
    public List<TaskDisplayModel>? LocalTasks
    {
        get { return _localTasks; }
        set { _localTasks = value; }
    }

    private List<ProjectDisplayModel>? _localProjects;
    public List<ProjectDisplayModel>? LocalProjects
    {
        get { return _localProjects; }
        set { _localProjects = value; }
    }

    private List<ContextDisplayModel>? _localContexts;
    public List<ContextDisplayModel>? LocalContexts
    {
        get { return _localContexts; }
        set { _localContexts = value; }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        AppState.AppStateChanged += AppStateChanged;
        DataState.DataStateChanged += DataStateChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;

        if (authState.User.Identity!.IsAuthenticated)
        {
            // do any child-specific loading/filtering of data
            CustomAuthenticatedOnInit();
        }
    }

    // to be defined in children as needed
    protected virtual void CustomAuthenticatedOnInit()
    {
    }

    // to be defined in child components as needed
    protected virtual bool HandleAppStateChanged(String propertyName, AppState appState)
    {
        return false;
    }

    private async void AppStateChanged(String propertyName, AppState appState)
    {
        bool changesOccured = HandleAppStateChanged(propertyName, appState);
        if (changesOccured)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    // to be defined in child components as needed
    protected virtual bool HandleDataStateChanged(String propertyName, DataState dataState)
    {
        return false;
    }

    private async void DataStateChanged(String propertyName, DataState dataState)
    {
        bool changesOccured = HandleDataStateChanged(propertyName, dataState);
        if (changesOccured)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        AppState.AppStateChanged -= AppStateChanged;
        DataState.DataStateChanged -= DataStateChanged;
    }

    protected void SetCanRefresh(bool newCanRefresh)
    {
        AppState.CanRefresh = newCanRefresh;
    }

    public bool IsLocalDataLoaded()
    {
        return LocalTasks != null && LocalProjects != null && LocalContexts != null;
    }

    protected void LoadAllLocalData()
    {
        LoadLocalTaskData();
        LoadLocalProjectData();
        LoadLocalContextData();

        PerformTaskCleanup();
    }

    protected void PerformTaskCleanup()
    {
        if (LocalTasks != null && DataState.IsDataLoaded())
        {
            foreach (TaskDisplayModel task in LocalTasks)
            {
                if (task.Completed)
                {
                    TimeSpan interval = (DateTime.Now - (DateTime)task.DateCompleted!);
                    int daysPassedSinceTaskCompletion = interval.Days;

                    // check if should delete
                    int deleteIntervalSetting = DataState.UserSettings.DeleteDelayDays;
                    if (daysPassedSinceTaskCompletion > deleteIntervalSetting)
                    {
                        Task.Run(() => DataService.DeleteTask(task).Wait());
                    }

                    // handle CleanedUp status
                    else if (!task.CleanedUp)
                    {
                        if (DataState.UserSettings.CleanUpImmediately) { task.CleanedUp = true; }
                        else
                        {
                            int cleanupIntervalSetting = DataState.UserSettings.CleanUpDelayDays;
                            if (daysPassedSinceTaskCompletion > cleanupIntervalSetting) { task.CleanedUp = true; }
                        }
                    }
                }
            }
        }
    }

    protected virtual void LoadLocalTaskData()
    {
        if (DataState.IsDataLoaded())
        {
            LocalTasks = DataState.Tasks;
            foreach (TaskDisplayModel task in LocalTasks!)
            {
                task.PropertyChanged += OnExistingTaskPropertyChanged!; // subscribe to property changed event
            }
        }
    }

    protected virtual void LoadLocalProjectData()
    {
        if (DataState.IsDataLoaded())
        {
            LocalProjects = DataState.Projects;
            foreach (ProjectDisplayModel project in LocalProjects!)
            {
                project.PropertyChanged += OnExistingProjectPropertyChanged!; // subscribe to property changed event
            }
        }
    }

    protected virtual void LoadLocalContextData()
    {
        if (DataState.IsDataLoaded())
        {
            LocalContexts = DataState.Contexts;
        }
    }

    // saves updated task data to server on property change
    protected async void OnExistingTaskPropertyChanged(object sender, PropertyChangedEventArgs e)
    {
        string? changedProperty = e.PropertyName;
        TaskDisplayModel senderTask = (TaskDisplayModel)sender;
        Console.WriteLine($"{senderTask.TaskName}'s property {changedProperty} was changed.");

        await DataService.UpdateTaskData(senderTask);
    }

    // saves updated project data to server on property change
    protected async void OnExistingProjectPropertyChanged(object sender, PropertyChangedEventArgs e)
    {
        string? changedProperty = e.PropertyName;
        ProjectDisplayModel senderProject = (ProjectDisplayModel)sender;
        Console.WriteLine($"{senderProject.ProjectName}'s property {changedProperty} was changed.");

        await DataService.UpdateProjectData(senderProject);
    }

    // saves updated context data to server on property change
    protected async void OnExistingContextPropertyChanged(object sender, PropertyChangedEventArgs e)
    {
        string? changedProperty = e.PropertyName;
        ContextDisplayModel senderContext = (ContextDisplayModel)sender;
        Console.WriteLine($"{senderContext.ContextName}'s property {changedProperty} was changed.");

        await DataService.UpdateContextData(senderContext);
    }
}
