@inherits _ComponentStateAwareBase
@using Microsoft.AspNetCore.Components.Sections
@inject IAuthenticationService AuthService
@inject IDataService DataService
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

@if (_working)
{
    <span class="app-loading" hidden></span>
}

<MudForm Model="userModel" 
@ref="_loginForm" 
@bind-IsValid="@_success" 
@bind-Errors="@_errors" >

    <MudGrid>
        <MudStack Row="true" Class="mt-2" AlignItems="AlignItems.Center">

            <MudItem Class="col-auto" @onpaste="MarkEmailAsEntered">

                <MudTextField @bind-Value="userModel.Email"
                @bind-Value:after="MarkEmailAsEntered"
                Immediate="@(!string.IsNullOrWhiteSpace(PrefillEmail))"
                Variant="Variant.Outlined" 
                Margin="Margin.Dense"
                Style="width: 235px"
                Placeholder="Email Address" 
                ErrorText=" " 
                OnlyValidateIfDirty="false"
                Required="true"
                RequiredError=" "
                OnKeyUp="EnterKeyPressed"
                Validation="@(new EmailAddressAttribute() {ErrorMessage = " "})" />
            </MudItem>

            <MudItem Class="col-auto">

                <MudTextField @bind-Value="userModel.Password"
                @ref="_passwordField"
                Variant="Variant.Outlined"
                Margin="Margin.Dense"
                Placeholder="Password"
                Style="width: 235px"
                ErrorText=" "
                InputType="@_passwordInput"
                TextChanged="SetAdornment"
                Adornment="_passwordAdornment"
                AdornmentIcon="@_passwordInputIcon"
                OnAdornmentClick="ToggleShowPassword"
                AdornmentAriaLabel="Show Password"
                OnlyValidateIfDirty="false"
                Required="true"         
                RequiredError=" "
                OnKeyUp="EnterKeyPressed"
                Validation="@(new Func<string, string?>(PasswordValidator))" />
            </MudItem>

            <MudItem Class="col-auto mr-2">

                <MudLoadingButton @bind-Loading="_working"
                LoadingAdornment="Adornment.None"
                Variant="Variant.Filled"
                Color="Color.Primary"
                OnClick="ValidateAndExecute">
                    Login
                </MudLoadingButton>

            </MudItem>

        </MudStack>
    </MudGrid>

</MudForm>

@if (!string.IsNullOrEmpty(_authenticationError))
{
    <SectionContent SectionName="SignInWarning">
        <div class="sign-in-warning mx-3 mt-3">
            <MudAlert Severity="_authenticationErrorSeverity">@_authenticationError</MudAlert>
        </div>
    </SectionContent>
}

@code {
    [SupplyParameterFromQuery(Name = "prefillEmail")]
    private string? PrefillEmail { get; set; }

    private AuthenticationUserModel userModel = new();
    private string _authenticationError = string.Empty;
    private Severity _authenticationErrorSeverity;
    private bool _attemptCanShowError;

    private MudForm _loginForm = default!;
    private MudTextField<string> _passwordField = default!;
    private string? _previousPrefillEmail;
    private bool _emailWasPrefilled;
    private bool _focusPassword;
    private bool _success;
    private string[] _errors = { };

    private bool _isShowPassword = false;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
    private MudBlazor.Adornment _passwordAdornment = Adornment.None;

    private bool _working = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        NavManager.LocationChanged += OnLocationChanged;
    }

    public override void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        base.Dispose();
    }

    protected override bool HandleAppStateChanged(string propertyName, AppState appState)
    {
        return propertyName is nameof(AppState.AlertMessage) or nameof(AppState.DismissSignInWarning)
            && ClearLoginError();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (ClearLoginError())
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private bool ClearLoginError()
    {
        _attemptCanShowError = false;
        var hadError = _authenticationError.Length != 0;
        _authenticationError = string.Empty;
        return hadError;
    }

    protected override void OnParametersSet()
    {
        if (_previousPrefillEmail == PrefillEmail)
        {
            return;
        }

        _previousPrefillEmail = PrefillEmail;
        _focusPassword = !string.IsNullOrWhiteSpace(PrefillEmail);
        if (_focusPassword)
        {
            userModel.Email = PrefillEmail;
            _emailWasPrefilled = true;
        }
        else if (_emailWasPrefilled)
        {
            userModel.Email = null;
            _emailWasPrefilled = false;
        }
    }

    private void MarkEmailAsEntered() => _emailWasPrefilled = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPassword)
        {
            _focusPassword = false;
            await _passwordField.FocusAsync();
        }
    }

    private void RegisterUser()
    {
        NavManager.NavigateTo("/register");
    }

    private async Task ValidateAndExecute()
    {
        if (_working)
        {
            return;
        }

        var (returnUrl, confirmationEmail) = SignInRedirect.GetLoginReturnUrl(NavManager);
        _authenticationError = string.Empty;
        _attemptCanShowError = true;
        _working = true;
        try
        {
            await _loginForm.Validate();
            if (_loginForm.IsValid && userModel.Email is { } email)
            {
                await ExecuteLogin(email, returnUrl, confirmationEmail);
            }
            else
            {
                ShowLoginError();
            }
        }
        catch (HttpRequestException ex) when (AuthStateProvider.CredentialsRejected(ex))
        {
            ShowLoginError("Your sign-in session was rejected. Please log in again.", Severity.Warning);
        }
        catch (HttpRequestException ex) when (ApiRequest.IsServiceFailure(ex)
            || ex.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
        {
            ShowLoginError(ApiRequest.IsServiceFailure(ex)
                ? ApiRequest.ServiceUnavailableMessage
                : ApiRequest.TooManyRequestsMessage, Severity.Warning);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            ShowLoginError("Could not complete sign-in. Please try again.");
        }
        finally
        {
            _working = false;
            StateHasChanged();
        }
    }

    private void ShowLoginError(string message = "There was an error when attempting to log in. Please try again.",
                                Severity severity = Severity.Error)
    {
        if (_attemptCanShowError)
        {
            _authenticationErrorSeverity = severity;
            _authenticationError = message;
        }
    }

    private async Task ExecuteLogin(string email, string? returnUrl, string? confirmationEmail)
    {
        UserModel attemptLoginUserModel = new UserModel { Email = email };
        bool exists = await DataService.CheckUserExists(attemptLoginUserModel);
        if (!exists)
        {
            ShowLoginError("No matching user found.", Severity.Warning);
        }
        else
        {
            bool confirmed = await DataService.CheckUserEmailConfirmed(attemptLoginUserModel);
            if (!confirmed)
            {
                bool passwordValid = await DataService.CheckPasswordValid(new CheckPasswordModel
                {
                    Email = email,
                    Password = userModel.Password
                });
                if (passwordValid)
                {
                    var confirmationUrl = QueryHelpers.AddQueryString("/unconfirmedemail", "email", email);
                    if (returnUrl is not null && CanUseReturnUrl(email))
                    {
                        var confirmationKey = SignInRedirect.ConfirmationStorageKey(email);
                        await LocalStorage.SetItemAsStringAsync(confirmationKey, returnUrl);
                        confirmationUrl = QueryHelpers.AddQueryString(confirmationUrl, "returnUrl", returnUrl);
                    }
                    NavManager.NavigateTo(confirmationUrl);
                }
                else
                {
                    ShowLoginError();
                }
            }
            else
            {
                var result = await AuthService.LoginAsync(userModel);
                if (result != null)
                {
                    var confirmationKey = SignInRedirect.ConfirmationStorageKey(result.UserName ?? email);
                    await LocalStorage.RemoveItemAsync(confirmationKey);
                    AppState.ClearAlertMessage();
                    var destination = CanUseReturnUrl(result.UserName) ? returnUrl : null;
                    NavManager.NavigateTo(destination ?? "/inbox");
                }
                else
                {
                    ShowLoginError();
                }
            }
        }

        bool CanUseReturnUrl(string? accountEmail) =>
            confirmationEmail is null || string.Equals(accountEmail?.Trim(), confirmationEmail.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    public async Task EnterKeyPressed(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            await ValidateAndExecute();
        }
    }

    private string? PasswordValidator(string pw)
    {
        return string.IsNullOrWhiteSpace(pw) ? " " : null;
    }

    private void ToggleShowPassword()
    {
        _isShowPassword = !_isShowPassword;
        _passwordInputIcon = _isShowPassword ?
            Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        _passwordInput = _isShowPassword ? InputType.Text : InputType.Password;
    }

    private void SetAdornment()
    {
        _passwordAdornment = string.IsNullOrEmpty(userModel.Password) ? Adornment.None : Adornment.End;
    }
}
