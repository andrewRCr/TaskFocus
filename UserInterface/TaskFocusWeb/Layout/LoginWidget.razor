@inherits _ComponentBase

@inject IAuthenticationService AuthService
@inject IUserEndpoint UserEndpoint
@inject NavigationManager NavManager
@inject IDataService DataService
@using System.ComponentModel.DataAnnotations

<MudForm Model="userModel" 
         @ref="_loginForm" 
         @bind-IsValid="@_success" 
         @bind-Errors="@_errors" >

    <MudGrid>
        <MudStack Row="true" Class="mt-2" AlignItems="AlignItems.Center">

            <MudItem Class="col-auto">

                <MudTextField @bind-Value="userModel.Email"
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense"
                              Style="width: 235px"
                              Placeholder="Email Address" 
                              ErrorText=" " 
                              OnlyValidateIfDirty="false"
                              Required="true"
                              RequiredError=" "
                              OnKeyUp="EnterKeyPressed"
                              Validation="@(new EmailAddressAttribute() {ErrorMessage = " "})" />
            </MudItem>

            <MudItem Class="col-auto">

                <MudTextField @bind-Value="userModel.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Placeholder="Password"
                              Style="width: 235px"
                              ErrorText=" "
                              InputType="@_passwordInput"
                              TextChanged="SetAdornment"
                              Adornment="_passwordAdornment"
                              AdornmentIcon="@_passwordInputIcon"
                              OnAdornmentClick="ToggleShowPassword"
                              AdornmentAriaLabel="Show Password"
                              OnlyValidateIfDirty="false"
                              Required="true"         
                              RequiredError=" "
                              OnKeyUp="EnterKeyPressed"
                              Validation="@(new Func<string, string?>(PasswordValidator))" />
            </MudItem>

            <MudItem Class="col-auto mr-2">

                <MudLoadingButton @bind-Loading="_working"
                                  LoadingAdornment="Adornment.None"
                                  Variant="Variant.Filled"
                                  Color="Color.Primary"
                                  OnClick="ValidateAndExecute">
                    Login
                </MudLoadingButton>
                    
            </MudItem>

        </MudStack>
    </MudGrid>

</MudForm>

@code {
    private AuthenticationUserModel userModel = new();
    private string authenticationErrorText = string.Empty;

    private MudForm _loginForm = default!;
    private bool _success;
    private string[] _errors = { };

    private bool _isShowPassword = false;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
    private MudBlazor.Adornment _passwordAdornment = Adornment.None;

    private bool _working = false;

    private void RegisterUser()
    {
        NavManager.NavigateTo("/register");
    }

    private async Task ValidateAndExecute()
    {
        _working = true;

        // display AuthProcessing loading screen
        NavManager.NavigateTo("/attemptlogin");

        await _loginForm.Validate();
        if (_loginForm.IsValid)
        {
            await ExecuteLogin();
        }
        else 
        { 
            _working = false;
            AppState.ShowGenericLoginError(); 
            // return to Home view (from AuthProcessing) to see auth error
            NavManager.NavigateTo("/");
        }
    }

    private async Task ExecuteLogin()
    {
        UserModel attemptLoginUserModel = new UserModel { Email = userModel.Email };
        bool exists = await UserEndpoint.CheckUserExists(attemptLoginUserModel);
        if (!exists)
        {
            AppState.AlertSeverity = MudBlazor.Severity.Warning;
            AppState.AlertMessage = "No matching user found.";
            // return to Home view (from AuthProcessing) to see auth error 
            NavManager.NavigateTo("/");
        }
        else
        {
            bool confirmed = await UserEndpoint.CheckUserEmailConfirmed(attemptLoginUserModel);
            if (!confirmed)
            {
                NavManager.NavigateTo($"/unconfirmedemail?email={userModel.Email}");
            }
            else
            {
                var result = await AuthService.LoginAsync(userModel);
                if (result != null)
                {
                    await DataService.FetchAllRemoteData();
                    AppState.ClearAlertMessage();
                    NavManager.NavigateTo("/inbox");
                }
                else
                {
                    // return to Home view (from AuthProcessing) to see auth error
                    AppState.ShowGenericLoginError();
                    NavManager.NavigateTo("/");
                }
            }
        }
        _working = false;
    }

    public async Task EnterKeyPressed(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            await ValidateAndExecute();
        }
    }

    private string? PasswordValidator(string pw)
    {
        return string.IsNullOrWhiteSpace(pw) ? " " : null;
    }

    private void ToggleShowPassword()
    {
        _isShowPassword = !_isShowPassword;
        _passwordInputIcon = _isShowPassword ?
            Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        _passwordInput = _isShowPassword ? InputType.Text : InputType.Password;
    }

    private void SetAdornment()
    {
        _passwordAdornment = string.IsNullOrEmpty(userModel.Password) ? Adornment.None : Adornment.End;
    }
}
