@inject IProjectEndpoint ProjectEndpoint
@inject IContextEndpoint ContextEndpoint﻿

<MudNavMenu>
    <AuthorizeView>
        <Authorized>
        <MudNavLink Href="all" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">All Tasks</MudNavLink>
        <MudNavLink Href="inbox" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inbox">Inbox</MudNavLink>

        <MudNavLink Href="projects" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">All Projects</MudNavLink>

        <MudNavGroup Title="Projects" Icon="@Icons.Material.Filled.List" @bind-Expanded="@_isProjectsExpanded">
            @if (Projects != null)
            {
                @foreach (ProjectModel project in Projects)
                {
                        string link = "/projects/" + @project.Id;
                        <MudNavLink href="@link" Icon="@Icons.Material.Filled.List">@project.ProjectName</MudNavLink>
                }
            }
        </MudNavGroup>

        <MudNavGroup  Title="Contexts" Icon="@Icons.Material.Filled.List" @bind-Expanded="@_isContextsExpanded">
            @if (Contexts != null)
            {
                @foreach (ContextModel context in Contexts)
                {
                        string link = "/contexts/" + @context.Id;
                    <MudNavLink href="@link" Icon="@Icons.Material.Filled.List">@context.ContextName</MudNavLink>
                }
            }
        </MudNavGroup>

        <MudNavLink Href="verifyauth" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">Verify Auth</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<ProjectModel> _projects = default!;
    public List<ProjectModel> Projects
    {
        get { return _projects; }
        set { _projects = value; }
    }

    private List<ContextModel> _contexts = default!;
    public List<ContextModel> Contexts
    {
        get { return _contexts; }
        set { _contexts = value; }
    }

    bool _isProjectsExpanded = false;
    bool _isContextsExpanded = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;

        if (authState.User.Identity!.IsAuthenticated)
        {
            await LoadSubMenuData();
        }
    }

    protected virtual async Task LoadSubMenuData()
    {
        Projects = await ProjectEndpoint.GetAllProjectsForUser();
        Contexts = await ContextEndpoint.GetAllContextsForUser();
    }
}