@inherits _ComponentBase

@inject IProjectEndpoint ProjectEndpoint
@inject IContextEndpoint ContextEndpoint﻿

<MudNavMenu Bordered="true" Style="display: flex; flex-flow: column; height: inherit;" >
    <AuthorizeView>
        <Authorized>
@*         <MudNavLink Href="all" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">All Tasks</MudNavLink> *@
            <MudNavLink Class="mainNavLink" Href="inbox" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inbox">
                Inbox
            </MudNavLink>
            <MudNavLink Class="mainNavLink" Href="today" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Today">
                Today
            </MudNavLink>

            <div @onclick=@ResetFocusedProjectIdStr>
            <MudNavLink Class="mainNavLink" Href="projects" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">
                Projects
            </MudNavLink>
            </div>

            <div @onclick=@ResetFocusedContextIdStr>
            <MudNavLink Class="mainNavLink" Href="contexts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">
                Contexts
            </MudNavLink>
            </div>

            <MudNavLink Disabled></MudNavLink> @* just for spacing *@

            <MudNavGroup Class="mainNavLink" Title="Pinned" Icon="@Icons.Material.Filled.PushPin" @bind-Expanded="@_isQuickAccessExpanded">

                <MudNavLink  href="#" Icon="@Icons.Material.Filled.List">Placeholder</MudNavLink>
        
            </MudNavGroup>


            <MudDivider  />
            <MudNavLink Class="mainNavLink" Href="verifyauth" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">Verify Auth</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

<style>
    .mainNavLink .mud-nav-link {
        height: 3rem;
        font-size: 1.0rem;
        align-items: center;
    }
</style>

@code {
    private bool _isQuickAccessExpanded = false;

    private void ResetFocusedProjectIdStr()
    {
        AppState.FocusedProjectIdStr = null;
    }

    private void ResetFocusedContextIdStr()
    {
        AppState.FocusedContextIdStr = null;
    }
}