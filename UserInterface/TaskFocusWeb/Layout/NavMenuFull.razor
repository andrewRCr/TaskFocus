@inherits _ComponentBase

<MudNavMenu Bordered="true" Style="display: flex; flex-flow: column; height: inherit; width:250px;">

    <MudNavLink Class="mainNavLink" Disabled="@_isMenuDisabled" Href="inbox" Match="NavLinkMatch.Prefix">
            Inbox
    </MudNavLink>
    <MudNavLink Class="mainNavLink" Disabled="@_isMenuDisabled" Href="today" Match="NavLinkMatch.Prefix">
            Today
    </MudNavLink>

    <div @onclick=@ResetFocusedProjectIdStr>
        <MudNavLink Class="mainNavLink" Disabled="@_isMenuDisabled" Href="projects" Match="NavLinkMatch.Prefix">
                Projects
        </MudNavLink>
    </div>

    <div @onclick=@ResetFocusedContextIdStr>
        <MudNavLink Class="mainNavLink" Disabled="@_isMenuDisabled" Href="contexts" Match="NavLinkMatch.Prefix">
                Contexts
        </MudNavLink>
    </div>

    <MudNavLink Disabled />
    <MudDivider DividerType="DividerType.Middle" />

    <MudNavLink Class="mainNavLink" Disabled="@_isMenuDisabled" Href="completed" Match="NavLinkMatch.Prefix" Style="color:#5e5e65;"><i>[ Completed ]</i></MudNavLink>
    <MudDivider Class="invisible" />
    <MudDivider DividerType="DividerType.Middle" />
    <MudNavLink Class="mainNavLink" Disabled="@_isMenuDisabled" Href="settings" Match="NavLinkMatch.Prefix">Settings</MudNavLink>

</MudNavMenu>

@code {
    private bool _isAuthenticated = false;
    private bool _isMenuDisabled = true;

    protected override async Task OnInitializedAsync()
    {
        dataRefreshTriggers = new List<string> { nameof(DataState.CurrentUser) };
        await VerifyAuth();
    }

    private async Task VerifyAuth()
    {
        var authState = await AuthState;

        _isAuthenticated = authState.User.Identity!.IsAuthenticated;
        _isMenuDisabled = !_isAuthenticated;
    }

    private void ResetFocusedProjectIdStr()
    {
        if (!_isAuthenticated) { return; }

        AppState.FocusedProjectIdStr = null;
        AppState.ShowProjectSubMenu = true;
    }

    private void ResetFocusedContextIdStr()
    {
        if (!_isAuthenticated) { return; }

        AppState.FocusedContextIdStr = null;
        AppState.ShowContextSubMenu = true;
    }

    protected override bool HandleDataStateChanged(string propertyName, DataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            //Console.WriteLine("NavMenuFull: returned true on HandleDataStateChanged!");
            InvokeAsync(VerifyAuth);
        }

        return AppState.CanRefresh;
    }
}
