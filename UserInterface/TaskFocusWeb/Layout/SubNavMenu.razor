@inherits _ComponentBase
@inject IDataService DataService

<MudNavMenu Bordered="true" Style="width: 250px;">
    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ArrowBackIosNew" OnClick="HideSubMenu"/>
    <MudButton OnClick="ResetToAllItemsView" Color="Color.Inherit" Class="ml-2">@CollectionName</MudButton>
    <MudDivider DividerType="DividerType.Middle" />

    @if (IsProjectsSubMenu)
    {
        @if (LocalProjects != null)
        {
            <SubNavMenuItemContainer IsProjectsSubMenu="true" ContainerProjectsParam="@LocalProjects" ContainerIdentifierParam="ProjectsSubNavMenu" />
        }
    }
    else
    {
        @if (LocalContexts != null)
        {
            <SubNavMenuItemContainer IsProjectsSubMenu="false" ContainerContextsParam="@LocalContexts" ContainerIdentifierParam="ContextsSubNavMenu" />
        }
    }

    <div class="flex-grow-1" style="max-width: 250px;" @onmouseover="()=>SetAddNewCollectionButtonActive(true)"
         @onmouseleave="()=>SetAddNewCollectionButtonActive(false)">
        <MudIconButton OnClick="()=>_newCollectionDialogVisible = true"
                       Color="@_addNewCollectionButtonColor"
                       Class="ml-1 mr-2"
                       Icon="@Icons.Material.Filled.Add"
                       />
        <MudText Typo="Typo.button" Class="@_addCollectionTextClassStr">Add new @_collectionTypeName</MudText>
    </div>

</MudNavMenu>

<!-- addNewCollection dialog -->
<MudDialog @bind-IsVisible="_newCollectionDialogVisible" Options="dialogOptions" @onfocusout="()=> _newCollectionName = string.Empty">
    <TitleContent>
        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-1 mb-1" />
        <MudText Typo="Typo.button" >
             Add new @_collectionTypeName
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newCollectionName" Variant="Variant.Text" Margin="Margin.Dense" Placeholder="@_addNewPlaceholderText" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelAddNewCollectionDialog" Class="px-0">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="SubmitNewCollection" Class="px-0">Add</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .subNavLink .mud-nav-link {
        font-size: 1.0rem;
        align-items: center;
    }

    .subNavLinkActive .mud-nav-link {
        font-size: 1.0rem;
        align-items: center;
        color: #7e6fff;
    }

    .mud-icon-button {
        height: fit-content;
        align-self: center;
    }
</style>

@code {
    [Parameter]
    public bool IsProjectsSubMenu { get; set; } = default!;

    [Parameter]
    public EventCallback<string> OnProjectFocused { get; set; }

    [Parameter]
    public EventCallback<string> OnContextFocused { get; set; }

    private string _collectionTypeName = string.Empty;
    private string _addNewPlaceholderText = string.Empty;
    private string _editMenuClassStr = "invisible";
    private string _addCollectionButtonClassStr = "invisible";
    private string _addCollectionTextClassStr = "invisible";
    private bool _newCollectionDialogVisible = false;
    private string _addNewCollectionButtonDescription = string.Empty;
    private MudBlazor.Color _addNewCollectionButtonColor = Color.Inherit;
    private string _newCollectionName = string.Empty;
    private DialogOptions dialogOptions = new() { FullWidth = true };

    private void ShowHideItemEditMenu(bool newShow)
    {
        _editMenuClassStr = newShow ? "" : "invisible";
    }

    private void SetAddNewCollectionButtonActive(bool newActive)
    {
        // always display if no collections exist
        if (IsProjectsSubMenu && LocalProjects != null)
        {
            if (!newActive && LocalProjects.Count == 0) { return; }
        }
        else if (!IsProjectsSubMenu && LocalContexts != null)
        {
            if (!newActive && LocalContexts.Count == 0) { return; }
        }

        _addCollectionButtonClassStr = newActive ? "ml-1" : "invisible";
        _addCollectionTextClassStr = newActive ? "ml-n2 pt-2" : "invisible";
        _addNewCollectionButtonColor = newActive ? Color.Primary : Color.Inherit;
    }

    private void CancelAddNewCollectionDialog()
    {
        _newCollectionName = string.Empty;
        _newCollectionDialogVisible = false;
    }

    private string CollectionName
    {
        get { return IsProjectsSubMenu ? "Projects" : "Contexts"; }
    }

    protected override void CustomAuthenticatedOnInit()
    {
        LoadLocalProjectData();
        LoadLocalContextData();
    }

    protected override void OnParametersSet()
    {
        _collectionTypeName = IsProjectsSubMenu?
            "Project" : "Context";
        _addNewPlaceholderText = IsProjectsSubMenu ?
            "Project Name" : "Context Name";
        _newCollectionName = string.Empty;
    }

    protected override void LoadLocalProjectData()
    {
        if (DataState.IsDataLoaded())
        {
            List<ProjectDisplayModel> projects = DataState.Projects!;
            projects = projects.OrderBy(x => x.OrderIndex).ToList();
            LocalProjects = projects;

            foreach (ProjectDisplayModel project in LocalProjects!)
            {
                project.PropertyChanged += OnExistingProjectPropertyChanged!; // subscribe to property changed event
                                                                              //Console.WriteLine($"{project.ProjectName}'s OrderIndex: {project.OrderIndex}");
            }

            if (LocalProjects.Count == 0)
            {
                SetAddNewCollectionButtonActive(true);
            }
        }
    }

    protected override void LoadLocalContextData()
    {
        if (DataState.IsDataLoaded())
        {
            List<ContextDisplayModel> contexts = DataState.Contexts!;
            contexts = contexts.OrderBy(x => x.OrderIndex).ToList();
            LocalContexts = contexts;

            foreach (ContextDisplayModel context in LocalContexts!)
            {
                context.PropertyChanged += OnExistingContextPropertyChanged!; // subscribe to property changed event                                                                        
            }
        }
    }

    private void ResetToAllItemsView()
    {
        if (IsProjectsSubMenu)
        { AppState.FocusedProjectIdStr = null; }
        else
        { AppState.FocusedContextIdStr = null; }
    }

    private void HideSubMenu()
    {
        AppState.ShowProjectSubMenu = false;
        AppState.ShowContextSubMenu = false;
    }

    private void SetFocusedItemIdStr(int itemId)
    {
        if (IsProjectsSubMenu)
        { AppState.FocusedProjectIdStr = itemId.ToString(); }
        else
        { AppState.FocusedContextIdStr = itemId.ToString(); ; }
    }

    private async Task SubmitNewCollection()
    {
        _newCollectionDialogVisible = false;

        if (IsProjectsSubMenu)
        {
            ProjectModel newProject = new();
            newProject.ProjectName = _newCollectionName;
            await DataService.AddProject(newProject);
        }
        else
        {
            ContextModel newContext = new();
            newContext.ContextName = _newCollectionName;
            await DataService.AddContext(newContext);
        }

        _newCollectionName = string.Empty;
    }

    protected override bool HandleDataStateChanged(String propertyName, DataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            //Console.WriteLine("SubNavMenu: returned true on HandleDataStateChanged!");
            LoadLocalProjectData();
            LoadLocalContextData();
        }

        return AppState.CanRefresh;
    }
}