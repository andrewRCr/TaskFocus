@inherits _ComponentBase

<MudNavMenu Bordered="true" Style="width: 250px;">
    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ArrowBackIosNew" OnClick="HideSubMenu"/>
    <MudButton OnClick="ResetToAllItemsView" Color="Color.Inherit" Class="mx-2">@CollectionName</MudButton>
    <MudDivider />

    @if (IsProjectsSubMenu)
    {
        @if (LocalProjects != null)
        {
            @foreach (ProjectDisplayModel project in LocalProjects)
            {
                <SubNavMenuItem IsProjectsSubMenu="true" ProjectParam="project" />

@*                 <MudStack Row="true" @onmouseover="()=> ShowHideItemEditMenu(true)" 
                    @onmouseout="()=> ShowHideItemEditMenu(false)">

                <MudNavLink Class="subNavLink" OnClick="@(()=>SetFocusedItemIdStr((int)project.Id!))" 
                    Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">
                    @project.ProjectName
                </MudNavLink>

                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                             Class="@_editMenuClassStr"
                             Dense="true" 
                             Size="Size.Small"

                             >

                        <MudMenuItem>Rename</MudMenuItem>
                        <MudMenuItem>Delete</MudMenuItem>
                    </MudMenu>

                </MudStack> *@
            }
        }
    }
    else
    {
        @if (LocalContexts != null)
        {
            @foreach (ContextDisplayModel context in LocalContexts)
            {
                <SubNavMenuItem IsProjectsSubMenu="false" ContextParam="context" />

@*                 <MudNavLink Class="subNavLink" OnClick="@(()=>SetFocusedItemIdStr((int)context.Id!))" 
                    Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">
                    @context.ContextName
                </MudNavLink> *@
            }
        }
    }

</MudNavMenu>

<style>
    .subNavLink .mud-nav-link {
        font-size: 1.0rem;
        align-items: center;
    }
</style>

@code {
    [Parameter]
    public bool IsProjectsSubMenu { get; set; } = default!;

    [Parameter]
    public EventCallback<string> OnProjectFocused { get; set; }

    [Parameter]
    public EventCallback<string> OnContextFocused { get; set; }

    private string _editMenuClassStr = "invisible";

    private void ShowHideItemEditMenu(bool newShow)
    {
        _editMenuClassStr = newShow ? "" : "invisible";
    }

    private string CollectionName
    {
        get { return IsProjectsSubMenu ? "Projects" : "Contexts"; }
    }

    protected override void CustomAuthenticatedOnInit()
    {
        LoadLocalProjectData();
        LoadLocalContextData();
    }

    private void ResetToAllItemsView()
    {
        if (IsProjectsSubMenu)
        { AppState.FocusedProjectIdStr = null; }
        else
        { AppState.FocusedContextIdStr = null; }
    }

    private void HideSubMenu()
    {
        AppState.ShowProjectSubMenu = false;
        AppState.ShowContextSubMenu = false;
    }

    private void SetFocusedItemIdStr(int itemId)
    {
        if (IsProjectsSubMenu)
        { AppState.FocusedProjectIdStr = itemId.ToString(); }
        else
        { AppState.FocusedContextIdStr = itemId.ToString(); ; }
    }
}