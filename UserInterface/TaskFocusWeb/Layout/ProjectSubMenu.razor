@inherits NavMenu
@inject NavigationManager NavManager

<MudNavMenu Bordered="true" Style="width: 250px;">

    <MudButton OnClick="NavigateToAllProjectsView" Color="Color.Inherit" Class="mx-2">Projects</MudButton>

    @if (Projects != null)
    {
        @foreach (ProjectModel project in Projects)
        {
            string link = "/projects/" + @project.Id;
            <MudNavLink Href="@link" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.List">@project.ProjectName</MudNavLink>
        }
    }

</MudNavMenu>

@code {

    void NavigateToAllProjectsView()
    {
        NavManager.NavigateTo("/projects");
    }
}
