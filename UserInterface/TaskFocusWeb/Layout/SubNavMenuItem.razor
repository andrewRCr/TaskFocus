@inherits _ComponentBase

@inject IDataService DataService
@inject ISnackbar Snackbar

<MudStack Row="true" 
Class="@_stackClass"
Spacing="0" 
@onmouseover="()=> ShowHideItemEditMenuButton(true)" 
@onfocusout="CloseItemEditMenu">

    <MudNavLink OnClick="@SetFocusedItemIdStr" 
    Icon="@_iconStr" 
    IconColor="@_linkColor"
    Class="subNavLink active"
    ActiveClass="active">

        <ChildContent>
            <MudText Color="@_linkColor">
                @if (IsProjectsSubMenu) { @ProjectParam.ProjectName }
                else { @ContextParam.ContextName }
            </MudText>
        </ChildContent>

    </MudNavLink>

    <MudMenu @ref="_itemEditMenu"
    Icon="@Icons.Material.Filled.MoreVert"
    Class=""
    Dense="true" 
    Size="Size.Medium">

        <div @onmousedown=OnItemMouseDown>

            <MudMenuItem OnClick="RenameItem" 
            OnTouch="RenameItemTouch" 
            Icon="@Icons.Material.Filled.Edit" 
            IconSize="Size.Medium">
                <MudText Typo="Typo.button" Class="ml-n4">Rename</MudText>
            </MudMenuItem>

            <MudMenuItem OnClick="DeleteItem" 
            OnTouch="DeleteItemTouch" 
            Icon="@Icons.Material.Filled.DeleteForever" 
            IconSize="Size.Medium">
                <MudText Typo="Typo.button" Class="ml-n4">Delete</MudText>
            </MudMenuItem>

        </div>
    </MudMenu>

</MudStack>

<!-- rename dialog -->
<MudDialog @bind-IsVisible="_renameDialogVisible" 
Options="dialogOptions" 
Style="background-color: #27272f">

    <TitleContent>
        <MudStack Row="true" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" />
            <MudText Typo="Typo.button">
                Rename @_collectionTypeName
            </MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudPaper Outlined Style="background-color: #373740;" 
        Class="pb-2 px-2 pt-n1" 
        Elevation="3">

            <MudTextField @bind-Value="_itemName" 
            Variant="Variant.Text" 
            Margin="Margin.Dense" 
            OnKeyUp="RenameEnterKeyPressed" />

        </MudPaper>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="()=>_renameDialogVisible = false" Class="px-0">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="SubmitRename" Class="px-0">Save</MudButton>
    </DialogActions>
</MudDialog>

<!-- delete dialog -->
<MudDialog @bind-IsVisible="_deleteDialogVisible" 
Options="dialogOptions" 
Style="background-color: #27272f">

    <TitleContent>
        <MudStack Row="true" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Class="mr-3" />
            <MudText Typo="Typo.button">Delete "@_itemName"?</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        <MudPaper Outlined 
        Style="background-color: #373740;" 
        Class="pa-3 ma-0 mb-1" 
        Elevation="3">
            <MudText>
                Any tasks with this @_collectionTypeName assigned will be moved to your Inbox.
            </MudText>
        </MudPaper>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="()=>_deleteDialogVisible= false" Class="px-0">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="SubmitDelete" Class="px-0">Delete</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public bool IsProjectsSubMenu { get; set; } = default!;

    [Parameter]
    public ProjectDisplayModel ProjectParam { get; set; } = default!;

    [Parameter]
    public ContextDisplayModel ContextParam { get; set; } = default!;

    private string _itemName = string.Empty;
    private string _collectionTypeName = string.Empty;
    private MudMenu _itemEditMenu = default!;
    private string _editMenuClassStr = "invisible";
    private string _stackClass = string.Empty;
    private MudBlazor.Color _linkColor = Color.Inherit;
    private string _iconStr = Icons.Material.Filled.List;

    private bool _itemClicked = false;
    private bool _renameDialogVisible = false;
    private bool _deleteDialogVisible = false;
    private DialogOptions dialogOptions = new() { FullWidth = true };

    private void OpenRenameDialog() => _renameDialogVisible = true;
    private void OpenDeleteDialog() => _deleteDialogVisible = true;

    protected override void CustomAuthenticatedOnInit()
    {
        SetLinkColor();
    }

    private async void TrySubmitRename()
    {
        await VerifyAuthAndRedirectIfExpired();

        if (string.IsNullOrWhiteSpace(_itemName))
        {
            Snackbar.Add($"{_collectionTypeName} name is required.", Severity.Error);
        }
        else { SubmitRename(); }
    }

    private void SubmitRename()
    {
        if (IsProjectsSubMenu) { ProjectParam.ProjectName = _itemName; }
        else { ContextParam.ContextName = _itemName; }

        _renameDialogVisible = false;

        Snackbar.Add($"{_collectionTypeName} renamed.", Severity.Success);
    }

    private async Task SubmitDelete()
    {
        await VerifyAuthAndRedirectIfExpired();
        _deleteDialogVisible = false;

        if (IsProjectsSubMenu) { await DataService.DeleteProject(ProjectParam); }
        else { await DataService.DeleteContext(ContextParam); }

        Snackbar.Add($"{_collectionTypeName} deleted.", Severity.Success);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _itemName = IsProjectsSubMenu ? 
            ProjectParam.ProjectName : ContextParam.ContextName;

        _collectionTypeName = IsProjectsSubMenu ?
            "Project" : "Context";

        _iconStr = IsProjectsSubMenu ?
        Icons.Material.Filled.List : Icons.Material.Filled.AlternateEmail;

        if (IsProjectsSubMenu && ProjectParam.OrderIndex == 0 ||
            !IsProjectsSubMenu && ContextParam.OrderIndex == 0)
        { _stackClass = "pt-1"; }
    }

    private void SetLinkColor()
    {
        string? idStrToParse = IsProjectsSubMenu ? AppState.FocusedProjectIdStr : AppState.FocusedContextIdStr;
        ICollectionDisplayModel relevantCollection = IsProjectsSubMenu ? ProjectParam : ContextParam;

        int integerFocusedCollectionId;
        bool isValid = int.TryParse(idStrToParse, out integerFocusedCollectionId);

        _linkColor = (isValid && relevantCollection.Id == integerFocusedCollectionId) ? Color.Primary : Color.Inherit;
    }

    private void CloseItemEditMenu()
    {
        if (!_itemClicked && _itemEditMenu.IsOpen)
        {
            _itemEditMenu.CloseMenu();
            ShowHideItemEditMenuButton(false);
        }
        _itemClicked = false; // reset for future clicks
    }

    private void OnItemMouseDown()
    {
        _itemClicked = true;
    }

    private void ShowHideItemEditMenuButton(bool newShow)
    {
        _editMenuClassStr = newShow ? "" : "invisible";
    }

    private void SetFocusedItemIdStr()
    {
        if (IsProjectsSubMenu && ProjectParam != null)
        { AppState.FocusedProjectIdStr = ProjectParam.Id.ToString(); }
        else if (ContextParam != null)
        { AppState.FocusedContextIdStr = ContextParam.Id.ToString(); }
    }

    public void RenameEnterKeyPressed(KeyboardEventArgs e)
    {
        if (e.Code == "Enter" || e.Code == "NumpadEnter")
        {
            TrySubmitRename();
        }
    }

    private void RenameItem(MouseEventArgs args) => OpenRenameDialog();
    private void RenameItemTouch(TouchEventArgs args) => OpenRenameDialog();
    private void DeleteItem(MouseEventArgs args) => OpenDeleteDialog();
    private void DeleteItemTouch(TouchEventArgs args) => OpenDeleteDialog();

    protected override bool HandleAppStateChanged(String propertyName, AppState state)
    {
        if (propertyName != nameof(AppState.FocusedProjectIdStr) && propertyName != nameof(AppState.FocusedContextIdStr))
        {
            return false;
        }

        SetLinkColor();
        return true;
    }
}
