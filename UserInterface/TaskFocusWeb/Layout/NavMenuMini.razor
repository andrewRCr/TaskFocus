@using TaskFocusUI.Library.Data.State
@inherits _ComponentStateAwareBase

<MudNavMenu Bordered="@ShowBorderHighlight" 
            Style="display: flex; flex-flow: column; height: inherit; width:60px;" >

    <MudNavLink Class="mainNavLink" 
                Disabled="@_isMenuDisabled" 
                Href="inbox" 
                Match="NavLinkMatch.Prefix" 
                Icon="@Icons.Material.Filled.Inbox" />

    <MudNavLink Class="mainNavLink" 
                Disabled="@_isMenuDisabled" 
                Href="today" 
                Match="NavLinkMatch.Prefix" 
                Icon="@Icons.Material.Filled.Today" />

    <div @onclick=@ResetFocusedProjectIdStr>
        <MudNavLink Class="mainNavLink" 
                    Disabled="@_isMenuDisabled" 
                    Href="projects" 
                    Match="NavLinkMatch.Prefix" 
                    Icon="@Icons.Material.Filled.Assignment" />
    </div>

    <div @onclick=@ResetFocusedContextIdStr>
        <MudNavLink Class="mainNavLink" 
                    Disabled="@_isMenuDisabled" 
                    Href="contexts" 
                    Match="NavLinkMatch.Prefix" 
                    Icon="@Icons.Material.Filled.AutoAwesomeMotion" />
    </div>

    <MudNavLink Disabled />
    <MudDivider DividerType="DividerType.Middle" />

    <MudNavLink Class="mainNavLink" 
                Disabled="@_isMenuDisabled" 
                Href="completed" 
                Match="NavLinkMatch.Prefix" 
                Icon="@Icons.Material.Filled.Checklist" />
            
    <MudDivider Class="invisible"  />
    <MudDivider DividerType="DividerType.Middle" />

    <MudNavLink Class="mainNavLink" 
                Disabled="@_isMenuDisabled" 
                Href="settings" 
                Match="NavLinkMatch.Prefix" 
                Icon="@Icons.Material.Filled.ManageAccounts" />

</MudNavMenu>

<style>
    .mainNavLink .mud-nav-link {
        height: 3rem;
        font-size: 1.0rem;
        align-items: center;
    }
</style>

@code {
    [Parameter]
    public bool ShowBorderHighlight { get; set; } = false;

    private bool _isMenuDisabled = true;

    protected override async Task OnInitializedAsync()
    {
        dataRefreshTriggers = new List<string> { nameof(ESyncableUserDataType.User) };
        await VerifyAuth();
        _isMenuDisabled = !_isAuthenticated;
    }

    private void ResetFocusedProjectIdStr()
    {
        if (!_isAuthenticated) { return; }

        AppState.FocusedProjectIdStr = null;
        AppState.ShowProjectSubMenu = true;
    }

    private void ResetFocusedContextIdStr()
    {
        if (!_isAuthenticated) { return; }

        AppState.FocusedContextIdStr = null;
        AppState.ShowContextSubMenu = true;
    }

    protected override bool HandleDataStateChanged(string propertyName, IDataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            InvokeAsync(VerifyAuth);
        }

        return AppState.CanRefresh;
    }
}