@inherits _ComponentBase

<MudNavMenu Bordered="@ShowBorderHighlight" Style="display: flex; flex-flow: column; height: inherit; width:60px;" >
    <AuthorizeView>
        <Authorized>
            <MudNavLink Class="mainNavLink" Href="inbox" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Inbox" />
            <MudNavLink Class="mainNavLink" Href="today" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Today" />

            <div @onclick=@ResetFocusedProjectIdStr>
            <MudNavLink Class="mainNavLink" Href="projects" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assignment" />
            </div>

            <div @onclick=@ResetFocusedContextIdStr>
            <MudNavLink Class="mainNavLink" Href="contexts" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AutoAwesomeMotion" />
            </div>

            <MudNavLink Disabled />
            <MudDivider DividerType="DividerType.Middle" />
    
            <MudNavLink Class="mainNavLink" Href="completed" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Checklist" />
            
            <MudDivider Class="invisible"  />
            <MudDivider DividerType="DividerType.Middle" />
            <MudNavLink Class="mainNavLink" Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts" />
        </Authorized>
    </AuthorizeView>
</MudNavMenu>

<style>
    .mainNavLink .mud-nav-link {
        height: 3rem;
        font-size: 1.0rem;
        align-items: center;
    }
</style>

@code {
    [Parameter]
    public bool ShowBorderHighlight { get; set; } = false;

    private void ResetFocusedProjectIdStr()
    {
        AppState.FocusedProjectIdStr = null;
        AppState.ShowProjectSubMenu = true;
    }

    private void ResetFocusedContextIdStr()
    {
        AppState.FocusedContextIdStr = null;
        AppState.ShowContextSubMenu = true;
    }
}