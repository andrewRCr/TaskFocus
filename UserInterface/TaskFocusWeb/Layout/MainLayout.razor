@inherits LayoutComponentBase
@inject IDataService DataService

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudLink Href="Account/Manage">@context.User.Identity?.Name</MudLink>
                <MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Class="ml-6 mr-3"/>
                <MudLink Href="logout">Log Out</MudLink>
            </Authorized>
            <NotAuthorized>
                <Login />
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen" Elevation="1" Width="300px" Variant="@DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" PreserveOpenState="true">
            <MudDrawerHeader Class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.OfflinePin" Color="Color.Primary" Class="mr-3" />
                <MudText Color="Color.Primary" Typo="Typo.h6" Style="font-family:Bahnschrift; font-weight:700; font-size:x-large;">TaskFocus</MudText>
        </MudDrawerHeader>
        <NavMenuContainer />
    </MudDrawer>

    <MudMainContent>
        <div class="col-12  col-xxl-10">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; } = default!;

    [Inject]
    protected DataState DataState { get; private set; } = default!;

    protected bool _drawerOpen = true;
    private MudTheme _theme = new();
    private bool _isDarkMode = true;

    protected void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;

        if (authState.User.Identity!.IsAuthenticated)
        {
            // ensure DataState has remote data loaded
            if (!DataState.IsDataLoaded())
            {
                await DataService.FetchAllRemoteData();
                //Console.WriteLine("MainLayout: onInit fetched all remote data!");
            }
        }
    }
}