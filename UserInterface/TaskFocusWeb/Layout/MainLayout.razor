@inherits LayoutComponentBase
@inject IDataService DataService
@inject IDataSyncService DataSyncService

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_customTheme" />
<MudDialogProvider @ref="AppState.DialogProvider" />
<MudSnackbarProvider />

<MudLayout>

    <!-- top app bar; logo + menu drawer toggle (if authenticated); login or auth widget -->
    <MudAppBar Elevation="0" >
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                Color="Color.Inherit" 
                Class="ml-n5" 
                OnClick="@((e) => DrawerToggle())" />
            </Authorized>
            <NotAuthorized>
                <MudIcon Icon="@Icons.Material.Filled.OfflinePin" 
                Color="Color.Primary" 
                Class="mr-4 ml-n3" 
                Size="Size.Large" />
                <MudText Color="Color.Primary" 
                Typo="Typo.h5" 
                Class="mt-1" 
                Style="font-family:Bahnschrift; font-weight:700; font-size:x-large;">TaskFocus</MudText>
            </NotAuthorized>
        </AuthorizeView>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <AuthWidget />
            </Authorized>
            <NotAuthorized>
                <LoginWidget />
            </NotAuthorized>
        </AuthorizeView>

    </MudAppBar>

    <MudStack Row="true">

        <!-- nav menu drawer; only visible if authenticated-->
        <AuthorizeView>
            <Authorized>

                <!-- behind-drawer mini nav menu (for when drawer collpased) -->
                <MudStack>
                    <div class="mt-6 mb-6"/>
                    <NavMenuMini ShowBorderHighlight="true" />
                </MudStack>

                <MudDivider Vertical />

                <MudDrawer @bind-Open="@_drawerOpen" 
                Elevation="25" 
                Width="360px" 
                Variant="@DrawerVariant.Responsive" 
                Breakpoint="Breakpoint.Md" 
                PreserveOpenState="true">

                    <MudDrawerHeader Class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.OfflinePin" 
                        Color="Color.Primary" 
                        Class="mr-4 ml-n3" 
                        Size="Size.Large" />
                        <MudText Color="Color.Primary" 
                        Typo="Typo.h5" 
                        Class="mt-1" 
                        Style="font-family:Bahnschrift; font-weight:700; font-size:x-large;">TaskFocus</MudText>
                    </MudDrawerHeader>

                    <!-- nav menu  -->
                    <NavMenuContainer />

                </MudDrawer>
            </Authorized>
        </AuthorizeView>

        <!-- body positioning; different if drawer visible (offset) -->
        <MudMainContent>
            <AuthorizeView>
                <Authorized>
                    <div class="col-12  col-xxl-10" style="margin-left: 8px;">
                        @Body
                    </div>
                </Authorized>

                <NotAuthorized>
                    <div class="col-12">
                        @Body
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </MudMainContent>

        <!-- global add new task component (+ button) -->
        <AuthorizeView>
            <Authorized>
                @if (DataState.IsDataLoaded())
                {
                    <AddNewTaskComponent />
                }

                <MudLoadingButton @bind-Loading="_syncing"
                LoadingAdornment="Adornment.None"
                Variant="Variant.Filled"
                Color="Color.Primary"
                OnClick="ManualDataSync">
                    Sync
                </MudLoadingButton>

            </Authorized>
        </AuthorizeView>

    </MudStack>

</MudLayout>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; } = default!;

    [Inject]
    protected AppState AppState { get; private set; } = default!;

    [Inject]
    protected IDataState DataState { get; private set; } = default!;

    private bool _syncing = false;
    protected bool _drawerOpen = true;
    private bool _isDarkMode = true;

    private MudTheme _customTheme = new MudTheme()
        {
            PaletteDark = new PaletteDark()
            {
                Background = "#27272f"
        },
    };

    protected void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;

        if (authState.User.Identity!.IsAuthenticated)
        {
            // if DataState has no remote data loaded, load it
            if (!DataState.IsDataLoaded())
            {
                //await DataSyncService.InitSync();
                DataService.InvokeSyncRequest($"{this.ToString()}: {nameof(OnInitializedAsync)}");
            }
        }
    }

    // TODO: TEMPORARY; only for testing. remove 
    private async Task ManualDataSync()
    {
        _syncing = true;

        //await DataSyncService.Sync();
        DataService.InvokeSyncRequest($"{this.ToString()}: {nameof(ManualDataSync)}");

        _syncing = false;
    }
}