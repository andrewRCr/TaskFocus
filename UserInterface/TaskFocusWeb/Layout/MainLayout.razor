@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Sections
@inject IDataService DataService
@inject IDataSyncService DataSyncService
@inject AuthenticationStateProvider AuthenticationProvider
@inject IBrowserViewportService BrowserViewport

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_customTheme" />
<MudDialogProvider @ref="AppState.DialogProvider" />
<MudSnackbarProvider />

<MudLayout Class="@(AuthState.IsCompletedSuccessfully ? "app-ready" : "app-loading")">

    <!-- top app bar; logo + menu drawer toggle (if authenticated); login or auth widget -->
    <MudAppBar Elevation="0" >
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                Color="Color.Inherit" 
                Class="ml-n5" 
                OnClick="@((e) => DrawerToggle())" />
            </Authorized>
            <NotAuthorized>
                <a href="/" class="taskfocus-title ml-n3">
                    <MudIcon Icon="@Icons.Material.Filled.OfflinePin"
                             Color="Color.Primary"
                             Class="mr-4"
                             Size="Size.Large" />
                    <MudText Color="Color.Primary"
                             Typo="Typo.h5"
                             Class="mt-1"
                             Style="font-family:Bahnschrift, 'DIN Alternate', Barlow, sans-serif; font-weight:700; font-size:x-large;">TaskFocus</MudText>
                </a>
            </NotAuthorized>
        </AuthorizeView>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <AuthWidget />
            </Authorized>
            <NotAuthorized>
                @if (!AuthProvider.SessionRestoreFailed)
                {
                    <LoginWidget />
                }
            </NotAuthorized>
        </AuthorizeView>

    </MudAppBar>

    <MudStack Row="true">

        <!-- nav menu drawer; only visible if authenticated-->
        <AuthorizeView>
            <Authorized>

                <!-- behind-drawer mini nav menu (for when drawer collpased) -->
                <MudStack>
                    <div class="mt-6 mb-6"/>
                    <NavMenuMini ShowBorderHighlight="true" />
                </MudStack>

                <MudDivider Vertical />

                <MudDrawer @bind-Open="@_drawerOpen" 
                Elevation="25" 
                Width="360px" 
                Variant="@DrawerVariant.Responsive" 
                Breakpoint="Breakpoint.Md" 
                PreserveOpenState="true">

                    <MudDrawerHeader Class="d-flex align-center">
                        <a href="/" class="taskfocus-title ml-n3" @onclick="CloseDrawerForHomeAsync">
                            <MudIcon Icon="@Icons.Material.Filled.OfflinePin"
                                     Color="Color.Primary"
                                     Class="mr-4"
                                     Size="Size.Large" />
                            <MudText Color="Color.Primary"
                                     Typo="Typo.h5"
                                     Class="mt-1"
                                     Style="font-family:Bahnschrift, 'DIN Alternate', Barlow, sans-serif; font-weight:700; font-size:x-large;">TaskFocus</MudText>
                        </a>
                    </MudDrawerHeader>

                    <!-- nav menu  -->
                    <NavMenuContainer />

                </MudDrawer>
            </Authorized>
            <NotAuthorized />
        </AuthorizeView>

        <!-- body positioning; different if drawer visible (offset) -->
        <MudMainContent>
            <SectionOutlet SectionName="SignInWarning" />
            @if (AuthProvider.SessionRestoreFailed || _initialLoadError is not null)
            {
                <MudAlert Class="mx-3 mt-3" Severity="Severity.Warning">
                    @(AuthProvider.SessionRestoreFailed ? ApiRequest.ServiceUnavailableMessage : _initialLoadError)
                    <MudButton Class="ml-2" Disabled="@_retrying" OnClick="RetryAsync">Retry</MudButton>
                </MudAlert>
            }

            <AuthorizeView>
                <Authorized>
                    <div class="col-12  col-xxl-10" style="margin-left: 8px;">
                        @Body
                    </div>
                </Authorized>

                <NotAuthorized>
                    @if (!AuthProvider.SessionRestoreFailed)
                    {
                        <div class="col-12">
                            @Body
                        </div>
                    }
                </NotAuthorized>
            </AuthorizeView>
        </MudMainContent>

        <!-- global add new task component (+ button) / sync status bar -->
        <AuthorizeView>
            <Authorized>
                <AppBarComponent InitialLoadFailed="@(_initialLoadError is not null)" />
            </Authorized>
            <NotAuthorized />
        </AuthorizeView>

    </MudStack>

</MudLayout>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; } = default!;

    [Inject]
    protected AppState AppState { get; private set; } = default!;

    protected bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private bool _loadingData;
    private bool _retrying;
    private string? _initialLoadError;
    private AuthStateProvider AuthProvider => (AuthStateProvider)AuthenticationProvider;

    private MudTheme _customTheme = new MudTheme()
        {
            PaletteDark = new PaletteDark()
            {
                Background = "#27272f"
        },
    };

    protected void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task CloseDrawerForHomeAsync(MouseEventArgs click)
    {
        if (click.Button == 0 && !click.CtrlKey && !click.MetaKey && !click.ShiftKey && !click.AltKey
            && await BrowserViewport.IsBreakpointWithinWindowSizeAsync(Breakpoint.SmAndDown))
        {
            _drawerOpen = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthState;
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            _initialLoadError = null;
        }
        else if (!DataService.IsDataStateLoaded() && _initialLoadError is null)
        {
            await LoadInitialDataAsync();
        }
    }

    private async Task LoadInitialDataAsync()
    {
        if (_loadingData)
        {
            return;
        }

        _loadingData = true;
        try
        {
            var success = await DataSyncService.TrySync(onFailure: error =>
            {
                _initialLoadError = error switch
                {
                    HttpRequestException requestError when ApiRequest.IsServiceFailure(requestError) =>
                        ApiRequest.ServiceUnavailableMessage,
                    HttpRequestException { StatusCode: System.Net.HttpStatusCode.TooManyRequests } =>
                        ApiRequest.TooManyRequestsMessage,
                    _ => ApiRequest.RequestFailedMessage
                };
            });
            if (success)
            {
                _initialLoadError = null;
            }
        }
        finally
        {
            _loadingData = false;
        }
    }

    private async Task RetryAsync()
    {
        if (_retrying)
        {
            return;
        }

        _retrying = true;
        try
        {
            if (AuthProvider.SessionRestoreFailed)
            {
                await AuthProvider.RetrySessionRestoreAsync();
            }
            else
            {
                await LoadInitialDataAsync();
            }
        }
        finally
        {
            _retrying = false;
        }
    }
}
