@inherits LayoutComponentBase
@inject IDataService DataService

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_customTheme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <!-- top app bar; logo + menu drawer toggle (if authenticated); login or auth widget -->
    <MudAppBar Elevation="0">
        <AuthorizeView>
            <Authorized>
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
            </Authorized>
            <NotAuthorized>
                <MudIcon Icon="@Icons.Material.Filled.OfflinePin" Color="Color.Primary" Class="mr-3" />
                <MudText Color="Color.Primary" Typo="Typo.h6" Style="font-family:Bahnschrift; font-weight:700; font-size:x-large;">TaskFocus</MudText>
            </NotAuthorized>
        </AuthorizeView>
        
        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <AuthWidget />
            </Authorized>
            <NotAuthorized>
                <LoginWidget />
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <!-- menu drawer; only visible if authenticated-->
    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="@_drawerOpen" Elevation="25" Width="300px" Variant="@DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" PreserveOpenState="true">
                <MudDrawerHeader Class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.OfflinePin" Color="Color.Primary" Class="mr-3" />
                    <MudText Color="Color.Primary" Typo="Typo.h6" Style="font-family:Bahnschrift; font-weight:700; font-size:x-large;">TaskFocus</MudText>
                </MudDrawerHeader>
                <NavMenuContainer />
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <!-- body positioning; different if drawer visible (offset) -->
    <MudMainContent>
        <AuthorizeView>
            <Authorized>
                <div class="col-12  col-xxl-10" style="margin-left: 8px;" >
                    @Body
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="col-12">
                    @Body
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </MudMainContent>

    <!-- global add new task component (+ button) -->
    <AuthorizeView>
        <Authorized>
            @if (DataState.IsDataLoaded()) { <AddNewTaskComponent /> }
        </Authorized>
    </AuthorizeView>

</MudLayout>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; } = default!;

    [Inject]
    protected AppState AppState { get; private set; } = default!;

    [Inject]
    protected IDataState DataState { get; private set; } = default!;

    protected bool _drawerOpen = true;
    private bool _isDarkMode = true;

    private MudTheme _customTheme = new MudTheme()
        {
            PaletteDark = new PaletteDark()
            {
                Background = "#27272f"
        },
    };

    protected void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;

        if (authState.User.Identity!.IsAuthenticated)
        {
            // ensure DataState has remote data loaded
            if (!DataState.IsDataLoaded())
            {
                await DataService.FetchAllRemoteData();
                //Console.WriteLine("MainLayout: onInit fetched all remote data!");
            }
        }
    }
}