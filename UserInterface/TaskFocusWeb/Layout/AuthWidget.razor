@inherits _ComponentBase

<MudLink Href="/settings">@_currentUserEmail</MudLink>
<MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Class="ml-6 mr-3" />
<MudLink Href="logout">Log Out</MudLink>

@code {
    private string _currentUserEmail = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        dataRefreshTriggers = new List<string> { nameof(DataState.CurrentUser) };

        var authState = await AuthState;
        _isAuthenticated = authState.User.Identity!.IsAuthenticated;
        if (_isAuthenticated)
        {
            _currentUserEmail = authState.User.Identity.Name!;
        }
    }

    protected override bool HandleDataStateChanged(string propertyName, IDataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            InvokeAsync(VerifyAuth);
        }

        return AppState.CanRefresh;
    }
}
