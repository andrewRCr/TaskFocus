@inherits _ComponentStateAwareBase
@inject IDataService DataService

<MudText>Welcome,&nbsp</MudText>
<MudLink Href="/settings">@_currentUserFirstName</MudLink>
<MudIcon Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" Class="ml-3 mr-3" />
<MudLink Href="logout">Log Out</MudLink>

@code {
    private string _currentUserFirstName = string.Empty;

    private void LoadCurrentUserFirstName()
    {
        if (DataService.GetDataStateCurrentUser() != null)
        {
            _currentUserFirstName = DataService.GetDataStateCurrentUser()!.FirstName!;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        dataRefreshTriggers = new List<string> { nameof(EDataRefreshType.User) };

        var authState = await AuthState;
        _isAuthenticated = authState.User.Identity!.IsAuthenticated;
        if (_isAuthenticated) LoadCurrentUserFirstName();
    }

    protected override bool HandleDataStateChanged(string propertyName, IDataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))return false;
        else if (AppState.CanRefresh)
        {
            InvokeAsync(VerifyAuth);
            LoadCurrentUserFirstName();
            //Console.WriteLine($"AuthWidget returned True on HandleDataStateChanged, due to {propertyName}");
        }

        return AppState.CanRefresh;
    }
}
