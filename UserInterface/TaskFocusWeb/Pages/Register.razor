@page "/register"
@inject IDataService DataService
@inject IUserEndpoint UserEndpoint
@inject IAuthenticationService AuthService
@inject NavigationManager NavManager
@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<MudTreeView T="MudContainer" Width="100%">
    <MudTreeViewItem T="MudContainer"
                     Expanded="true"
                     Icon="@Icons.Material.Filled.AccountCircle"
                     Text="Create new account"
                     TextTypo="Typo.button">

        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">

            <MudForm @ref="_registerForm" @bind-IsValid="@_success" @bind-Errors="@_errors" Model="userModel" >

                <MudTextField T="string"
                              @bind-Value="userModel.FirstName"
                              Label="First Name"
                              Style="width: 350px;"
                              Validation="@(new Func<string, IEnumerable<string>>(FirstNameValidator))" />

                <MudTextField T="string"
                              @bind-Value="userModel.LastName"
                              Label="Last Name"
                              Style="width: 350px;"
                              Validation="@(new Func<string, IEnumerable<string>>(LastNameValidator))"/>

                <MudTextField T="string"
                              @bind-Value="userModel.Email"
                              Label="Email address"
                              Style="width: 350px;"
                              Validation="@(new EmailAddressAttribute() {ErrorMessage = "Please provide a valid email address."})" />

                <MudTextField T="string"
                              Label="Password"
                              @bind-Value="userModel.Password"
                              @ref="_pwField1"
                              Style="width: 350px;"
                              InputType="@_passwordInput"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordInputIcon"
                              OnAdornmentClick="ToggleShowPassword"
                              AdornmentAriaLabel="Show Password"
                              Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))" />

                <MudTextField T="string"
                              Label="Confirm Password"
                              @bind-Value="userModel.ConfirmPassword"
                              InputType="@_passwordInput"
                              Style="width: 350px;"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordInputIcon"
                              OnAdornmentClick="ToggleShowPassword"
                              AdornmentAriaLabel="Show Confirm Password"
                              Validation="@(new Func<string, string>(PasswordMatch))" />

                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Disabled="@(!_success)" 
                           Class="ml-auto mt-6"
                           OnClick="(() => SubmitRegisterForm())" >
                    Register
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Inherit"
                           DisableElevation="true"
                           OnClick="@(()=>_registerForm.ResetAsync())"
                           Class="mx-2 mt-6">
                    Reset
                </MudButton>
            </MudForm>

        </MudContainer>
    </MudTreeViewItem>
</MudTreeView>

@code {
    CreateUserModel userModel = new();
    string? errorMessage;

    private MudForm _registerForm;
    private bool _success;
    private string[] _errors = { };
    private MudTextField<string> _pwField1;

    private bool _isShowPassword = false;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    private async Task SubmitRegisterForm()
    {
        await _registerForm.Validate();
        if (_registerForm.IsValid)
        {
            await OnValidSubmit();
        }
    }

    private async Task OnValidSubmit()
    {
        errorMessage = string.Empty;

        try
        {
            await UserEndpoint.CreateUser(userModel);
            var result = await AuthService.LoginAsync(new() { Email = userModel.Email, Password = userModel.Password });

            if (result != null)
            {
                await DataService.FetchAllRemoteData();
                NavManager.NavigateTo("/");
            }
            else
            {
                errorMessage = "Registration was successful, but there was an error when attempting to log in.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ToggleShowPassword()
    {
        _isShowPassword = !_isShowPassword;
        _passwordInputIcon = _isShowPassword ?
            Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        _passwordInput = _isShowPassword ? InputType.Text : InputType.Password;
    }

    private IEnumerable<string> PasswordStrength(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw))
        {
            yield return "Password is required.";
            yield break;
        }
        if (pw.Length < 6)
            yield return "Password must be at least of length 6.";
        if (!Regex.IsMatch(pw, @"[A-Z]"))
            yield return "Password must contain at least one capital letter.";
        if (!Regex.IsMatch(pw, @"[a-z]"))
            yield return "Password must contain at least one lowercase letter.";
        if (!Regex.IsMatch(pw, @"[0-9]"))
            yield return "Password must contain at least one digit.";
        if (!Regex.IsMatch(pw, @"[-+_!@#$%^&*.,?]"))
            yield return "Password must contain at least one special character.";
    }

    private string PasswordMatch(string arg)
    {
        if (string.IsNullOrWhiteSpace(arg))
            return "Password confirmation is required.";
        else if (_pwField1.Value != arg)
            return "Passwords do not match.";
        return null;
    }

    private IEnumerable<string> FirstNameValidator(string arg)
    {
        if (string.IsNullOrWhiteSpace(arg))
        {
            yield return "First name is required.";
            yield break;
        }
    }

    private IEnumerable<string> LastNameValidator(string arg)
    {
        if (string.IsNullOrWhiteSpace(arg))
        {
            yield return "Last name is required.";
            yield break;
        }
    }
}
