@page "/logout"
@using TaskFocusUI.Library.Data.Services
@using TaskFocusUI.Library.Data.Services.Synchronization
@inherits _ComponentStateAwareBase
@inject NavigationManager NavManager
@inject IAuthenticationService AuthService
@inject IDataSyncService DataSyncService

@code {
    protected override async Task OnInitializedAsync()
    {
        await DataSyncService.Sync();
        await AuthService.LogoutAsync();
        DataState.CurrentUser = null;

        NavManager.NavigateTo("/");
    }
}
