@page "/logout"
@inherits _ComponentStateAwareBase
@inject NavigationManager NavManager
@inject IAuthenticationService AuthService
@inject IDataSyncService DataSyncService
@inject IDataService DataService

@code {
    protected List<string> appRefreshTriggers = new List<string> { nameof(AppState.PostSyncLogoutRequested) };

    // process logout (post-sync)
    private async Task HandleLogout()
    {
        if (!_isAuthenticated) return;

        await AuthService.LogoutAsync();
        AppState.PostSyncLogoutRequested = false;
        DataService.ResetDataStateOnLogout();

        NavManager.NavigateTo("/");
    }

    protected override void CustomAuthenticatedOnInit()
    {
        dataRefreshTriggers = new List<string> { nameof(EDataRefreshType.AppRequestedSyncCompleted) };

        // if we reached this page, we want to logout, but we need to try and sync first
        if (!AppState.PostSyncLogoutRequested) // pre-logout sync hasn't yet run
        {
            DataService.InvokeSyncRequest($"{this.ToString()}: {nameof(OnInitializedAsync)}", true);
        }
    }

    protected override bool HandleAppStateChanged(string propertyName, AppState appState)
    {
        if (!appRefreshTriggers.Contains(propertyName)) return false;
        if (AppState.CanRefresh) Task.Run(async() => await HandleLogout());

        return AppState.CanRefresh;
    }

    protected override bool HandleDataStateChanged(string propertyName, IDataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName)) return false;

        if (AppState.CanRefresh)
        {
            // on refresh, no new sync request + call HandleLogout()
            AppState.PostSyncLogoutRequested = DataService.IsAppRequestedSyncCompleted();
            //Console.WriteLine($"Logout: returned true on HandleDataStateChanged. changed property causing True return: {propertyName}");
        }

        return AppState.CanRefresh;
    }
}
