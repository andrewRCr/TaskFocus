@page "/register"

@inherits _ComponentStateAwareBase
@inject IDataService DataService
@inject IUserEndpoint UserEndpoint
@inject IAuthenticationService AuthService
@inject NavigationManager NavManager
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions
@using TaskFocusUI.Library.Data.Services
@using TaskFocusUI.Library.Data.Services.Access

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

<MudLoading @bind-Loading="_loading">

    <LoaderContent>
        <div class="mx-auto text-center mt-3">
            <MudProgressLinear Class="mb-3" Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.button" Class="mt-3">Processing</MudText>
        </div>
    </LoaderContent>

    <ChildContent>

            <AuthorizeView>
                <Authorized>

                    <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-6">

                        <MudText Typo="Typo.button" Color="Color.Primary">
                            Register New Account
                        </MudText>

                        <MudPaper Elevation="25" Class="mt-2">
                            <MudText Class="pt-4 px-4 pb-4 text-center">
                                    Please <MudLink Href="logout">logout</MudLink> of your existing account before registering a new one.
                            </MudText>

                        </MudPaper>

                    </MudContainer>

                </Authorized>

                <NotAuthorized>

                    <div class="mx-auto text-center mt-6">

                        <!-- header -->
                        <MudContainer Class="d-flex align-center justify-center mud-width-full">
                            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Primary" Class="mr-3" />
                            <MudText Color="Color.Primary" Typo="Typo.button">Create new account</MudText>
                        </MudContainer>

                        <MudContainer Class="d-flex align-center justify-center mud-width-full">

                            <MudForm @ref="_registerForm" 
                                     @bind-IsValid="@_success" 
                                     @bind-Errors="@_errors" 
                                     Model="userModel">

                                <MudTextField T="string"
                                              @bind-Value="userModel.FirstName"
                                              Label="First Name"
                                              Style="width: 350px;"
                                              Validation="@(new Func<string, IEnumerable<string>>(FirstNameValidator))" />

                                <MudTextField T="string"
                                              @bind-Value="userModel.LastName"
                                              Label="Last Name"
                                              Style="width: 350px;"
                                              Validation="@(new Func<string, IEnumerable<string>>(LastNameValidator))" />

                                <MudTextField T="string"
                                              @bind-Value="userModel.Email"
                                              Label="Email address"
                                              Style="width: 350px;"
                                              Validation="@(new EmailAddressAttribute() {ErrorMessage = "Please provide a valid email address."})" />

                                <MudTextField T="string"
                                              Label="Password"
                                              @bind-Value="userModel.Password"
                                              @ref="_pwField1"
                                              Style="width: 350px;"
                                              InputType="@_passwordInput"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@_passwordInputIcon"
                                              OnAdornmentClick="ToggleShowPassword"
                                              AdornmentAriaLabel="Show Password"
                                              Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))" />

                                <MudTextField T="string"
                                              Label="Confirm Password"
                                              @bind-Value="userModel.ConfirmPassword"
                                              InputType="@_passwordInput"
                                              Style="width: 350px;"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@_passwordInputIcon"
                                              OnAdornmentClick="ToggleShowPassword"
                                              AdornmentAriaLabel="Show Confirm Password"
                                              Validation="@(new Func<string, string?>(PasswordMatch))" />

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Disabled="@(!_success)"
                                           Class="ml-auto mt-9"
                                           OnClick="(() => SubmitRegisterForm())">
                                    Register
                                </MudButton>

                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Inherit"
                                           DisableElevation="true"
                                           OnClick="@(()=>_registerForm.ResetAsync())"
                                           Class="mx-2 mt-9">
                                    Reset
                                </MudButton>

                            </MudForm>
                        </MudContainer>

                    </div>

                </NotAuthorized>
            </AuthorizeView>

    </ChildContent>
</MudLoading>

@code {
    private bool _loading = false;
    CreateUserModel userModel = new();
    string? errorMessage;

    private MudForm _registerForm = default!;
    private bool _success;
    private string[] _errors = { };
    private MudTextField<string> _pwField1 = default!;

    private bool _isShowPassword = false;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    private async Task SubmitRegisterForm()
    {
        await _registerForm.Validate();
        if (_registerForm.IsValid)
        {
            await OnValidSubmit();
        }
    }

    private async Task OnValidSubmit()
    {
        errorMessage = string.Empty;

        try
        {
            // indicate processing to user
            _loading = true;
            await UserEndpoint.CreateUser(userModel);

            UserModel createdUserModel = new() { Email = userModel.Email };
            bool success = await UserEndpoint.CheckUserExists(createdUserModel);
            if (success)
            {
                // set Alert notification + navigate to unconfirmed email page
                AppState.AlertMessage = "Account created but email not yet confirmed. Please check your email for a confirmation link.";
                AppState.AlertSeverity = Severity.Success;
                NavManager.NavigateTo($"/unconfirmedemail?email={userModel.Email}");
            }
            else
            {
                _loading = false;
                errorMessage = "There was an error when attempting to register.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ToggleShowPassword()
    {
        _isShowPassword = !_isShowPassword;
        _passwordInputIcon = _isShowPassword ?
            Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        _passwordInput = _isShowPassword ? InputType.Text : InputType.Password;
    }

    private IEnumerable<string> PasswordStrength(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw))
        {
            yield return "Password is required.";
            yield break;
        }
        if (pw.Length < 6)
            yield return "Password must be at least of length 6.";
        if (!Regex.IsMatch(pw, @"[A-Z]"))
            yield return "Password must contain at least one capital letter.";
        if (!Regex.IsMatch(pw, @"[a-z]"))
            yield return "Password must contain at least one lowercase letter.";
        if (!Regex.IsMatch(pw, @"[0-9]"))
            yield return "Password must contain at least one digit.";
        if (!Regex.IsMatch(pw, @"[-+_!@#$%^&*.,?]"))
            yield return "Password must contain at least one special character.";
    }

    private string? PasswordMatch(string arg)
    {
        if (string.IsNullOrWhiteSpace(arg))
            return "Password confirmation is required.";
        else if (_pwField1.Value != arg)
            return "Passwords do not match.";
        return null;
    }

    private IEnumerable<string> FirstNameValidator(string arg)
    {
        if (string.IsNullOrWhiteSpace(arg))
        {
            yield return "First name is required.";
            yield break;
        }
    }

    private IEnumerable<string> LastNameValidator(string arg)
    {
        if (string.IsNullOrWhiteSpace(arg))
        {
            yield return "Last name is required.";
            yield break;
        }
    }
}
