@page "/autherror"
@inherits _ComponentBase
@inject NavigationManager NavManager

<PageTitle>TaskFocus</PageTitle>

@if (!_isAuthenticated)
{
    <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-6">

        <MudText Typo="Typo.button" Color="Color.Error">
            Authentication Error
        </MudText>

        <MudPaper Elevation="25" Class="mt-2">
            <MudText Class="px-4 py-2 text-center">
                There was an error when attempting to log in; please try again.
            </MudText>
        </MudPaper>

    </MudContainer>
}

@code {
    private bool _isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        dataRefreshTriggers = new List<string> { nameof(DataState.CurrentUser) };
        await VerifyAuth();

        if (_isAuthenticated)
        {
            NavManager.NavigateTo("/inbox");
        }
    }

    private async Task VerifyAuth()
    {
        var authState = await AuthState;
        _isAuthenticated = authState.User.Identity!.IsAuthenticated;
    }

    protected override bool HandleDataStateChanged(string propertyName, IDataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            //Console.WriteLine("AuthError: returned true on HandleDataStateChanged!");
            InvokeAsync(VerifyAuth);
        }

        return AppState.CanRefresh;
    }
}
