@page "/settings"

@inherits _ComponentBase
@inject IUserEndpoint UserEndpoint
@inject IDataService DataService
@inject IAuthenticationService AuthService
@inject ISnackbar Snackbar
@inject NavigationManager NavManager
@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations

@inject ILogger<SettingsViewPage> Logger

@if (LocalCurrentUser != null)
{
    <MudLoading @bind-Loading="_loading">

        <LoaderContent>
            <div class="mx-auto text-center mt-3">
                <MudProgressLinear Class="mb-3" Color="Color.Primary" Indeterminate="true" />
                <MudText Typo="Typo.button" Class="mt-3">Processing</MudText>
            </div>
        </LoaderContent>

        <ChildContent>

            <!-- user app preferences -->
            <MudTreeView T="MudContainer" Width="100%">

                <MudTreeViewItem T="MudContainer" 
                                 Expanded="true"
                                 Icon="@Icons.Material.Filled.Settings"
                                 Text="Preferences"
                                 TextTypo="Typo.button">

                    <MudContainer MaxWidth="MaxWidth.Medium">

                        <MudText Class="ml-4 mb-n1">Automatically <strong>clean up</strong> completed tasks:</MudText>

                        <MudRadioGroup @bind-Value="LocalSettings.CleanUpImmediately" Class="ml-2">

                            <MudRadio Value="true" 
                                      Dense="true" 
                                      Class="ml-2" 
                                      Color="Color.Primary"
                                      UnCheckedColor="Color.Inherit">

                                <MudText Style="@_immediateTextStyleStr">Immediately</MudText>
                            </MudRadio>

                            <MudRadio Value="false" Dense="true" Class="ml-2" Color="!LocalSettings.CleanUpImmediately ? Color.Primary : Color.Inherit">

                                <MudStack Row="true" AlignItems="AlignItems.Center">

                                    <MudNumericField @bind-Value="LocalSettings.CleanUpDelayDays"
                                                     Class="ml-2 d-flex align-start pb-3"
                                                     HideSpinButtons="false"
                                                     DisableUnderLine="true"
                                                     Variant="Variant.Text"
                                                     Min="1"
                                                     Max="90"
                                                     MaxLength="2"
                                                     Disabled="@LocalSettings.CleanUpImmediately"
                                                     FullWidth="false"
                                                     Margin="Margin.Dense"
                                                     Style="@_cleanDaysNumFieldStyleStr" />

                                    <MudText Class="ml-n2" Style="@_cleanDaysTextStyleStr">@_cleanDaysTextStr after completion</MudText>
                                </MudStack>

                            </MudRadio>
                        </MudRadioGroup>

                        <MudText Class="ml-4 mb-n1">Automatically <strong>delete</strong> completed tasks:</MudText>

                        <div class="d-flex">
                            <MudStack Row="true" AlignItems="AlignItems.Center">

                                <MudNumericField @bind-Value="LocalSettings.DeleteDelayDays"
                                                 Class="ml-6 d-flex align-start pb-3"
                                                 HideSpinButtons="false"
                                                 DisableUnderLine="true"
                                                 Variant="Variant.Text"
                                                 Min="1"
                                                 Max="90"
                                                 MaxLength="2"
                                                 FullWidth="false"
                                                 Margin="Margin.Dense"
                                                 Style="@_deleteDaysNumFieldStyleStr" />

                                <MudText Class="ml-n2">@_deleteDaysTextStr after completion</MudText>
                            </MudStack>
                        </div>

                    </MudContainer>

                </MudTreeViewItem>
            </MudTreeView>

            <!-- user profile info / settings -->
            <MudTreeView T="MudContainer" Width="100%">

                <MudTreeViewItem T="MudContainer" 
                                 Expanded="true"
                                 Icon="@Icons.Material.Filled.AccountCircle"
                                 Text="Profile"
                                 TextTypo="Typo.button">

                    <MudContainer MaxWidth="MaxWidth.Medium">

                        <MudGrid>
                            <MudStack Class="mt-3 mb-3 ml-7" 
                                      Row="true" 
                                      AlignItems="AlignItems.Center" 
                                      Spacing="4">

                                <MudItem xs="5">
                                    <MudTextField MaxLength="50" 
                                                  Variant="Variant.Text" 
                                                  Margin="Margin.Dense" 
                                                  HelperText="First Name" 
                                                  @bind-Value="LocalCurrentUser.FirstName" />
                                </MudItem>

                                <MudItem xs="5">
                                    <MudTextField MaxLength="50" 
                                                  Variant="Variant.Text" 
                                                  Margin="Margin.Dense" 
                                                  HelperText="Last Name" 
                                                  @bind-Value="LocalCurrentUser.LastName" />
                                </MudItem>

                            </MudStack>
                        </MudGrid>

                        <!-- disabled email address display -->
                        <MudTextField Class="ml-4"
                                      Style="width:370px;"
                                      Disabled="true"
                                      Variant="Variant.Text"
                                      Margin="Margin.Dense"
                                      HelperText="Email Address"
                                      @bind-Value="LocalCurrentUser.Email" />

                        <!-- email/password update buttons (open dialogs) -->
                        <MudButton Class="mt-5 ml-4"
                                   Variant="Variant.Filled"
                                   ButtonType="ButtonType.Button"
                                   OnClick="OpenUpdateEmailDialog"
                                   Color="Color.Primary">
                            Update email
                        </MudButton>

                        <MudButton Class="mt-5 ml-4"
                                   Variant="Variant.Filled"
                                   ButtonType="ButtonType.Button"
                                   OnClick="OpenUpdatePasswordDialog"
                                   Color="Color.Primary">
                            Change password
                        </MudButton>

                    </MudContainer>

                </MudTreeViewItem>
            </MudTreeView>

            <MudContainer>
                @if (!string.IsNullOrEmpty(_alertMessage))
                {
                    <MudAlert Class="mt-6" 
                              Elevation="25" 
                              Severity="_alertSeverity">@_alertMessage</MudAlert>
                }
            </MudContainer>

        </ChildContent>
    </MudLoading>

    <!-- updateEmail dialog -->
    <MudDialog @bind-IsVisible="_updateEmailDialogVisible" 
               @ref="_updateEmailDialog"
               Options="dialogOptions"
               Style="background-color: #27272f">

        <TitleContent>
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-1 mb-1" />
            <MudText Typo="Typo.button">
                Change Email Address
            </MudText>
        </TitleContent>

        <DialogContent>
            <MudPaper Outlined 
                      Style="background-color: #373740;" 
                      Class="pa-2 ma-0 mb-1" 
                      Elevation="3">

                <MudForm @ref="_updateEmailForm" 
                         @bind-IsValid="@_emailFormIsValid" 
                         @bind-Errors="@_emailErrors" 
                         Model="_userModel">

                    <MudTextField T="string" 
                                  Class="mb-2"
                                  Label="Email Address" ShrinkLabel="true"
                                  Margin="Margin.Dense"
                                  @bind-Value="_userModel.Email"
                                  Style="width: 350px;"
                                  Validation="@(new EmailAddressAttribute() {ErrorMessage = "Please provide a valid email address."})" />
                </MudForm>
            </MudPaper>
            <MudText Typo="Typo.caption">You will need to confirm your new email address after updating.</MudText>
        </DialogContent>

        <DialogActions>
            <MudButton OnClick="()=> _updateEmailDialogVisible = false" 
                       Class="px-0">Cancel</MudButton>
            <MudButton Color="Color.Primary"
                       Disabled="@(!_emailFormIsValid)"
                       Class="px-0"
                       OnClick="SubmitUpdatedEmail">
                Submit
            </MudButton>
        </DialogActions>
    </MudDialog>

    <!-- updatePassword dialog -->
    <MudDialog @bind-IsVisible="_updatePasswordDialogVisible" 
               @ref="_updatePasswordDialog" 
               Options="dialogOptions"
               Style="background-color: #27272f">

        <TitleContent>
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-1 mb-1" />
            <MudText Typo="Typo.button">
                Change Password
            </MudText>
        </TitleContent>

        <DialogContent>
            <MudPaper Outlined 
                      Style="background-color: #373740;" 
                      Class="pa-2 ma-0 mb-1" 
                      Elevation="3">

                <MudForm @ref="_updatePasswordForm" 
                         @bind-IsValid="@_passwordFormIsValid" 
                         @bind-Errors="@_passwordErrors" 
                         Model="_authUserModel">

                    <MudTextField T="string" 
                                  Class="pl-2 my-2"
                                  Label="New password" 
                                  ShrinkLabel="true"
                                  @bind-Value="_authUserModel.Password"
                                  @ref="_pwField1"
                                  Style="width: 350px;"
                                  Margin="Margin.Dense"
                                  InputType="@_passwordInput"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_passwordInputIcon"
                                  OnAdornmentClick="ToggleShowPassword"
                                  AdornmentAriaLabel="Show Password"
                                  Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))" 
                                  Required="true"
                                  RequiredError="Password is required!" />

                    <MudTextField T="string" 
                                  class="pl-2 mb-2"
                                  Label="Confirm new password" 
                                  ShrinkLabel="true"
                                  @bind-Value="_authUserModel.ConfirmPassword"
                                  InputType="@_passwordInput"
                                  Style="width: 350px;"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_passwordInputIcon"
                                  OnAdornmentClick="ToggleShowPassword"
                                  AdornmentAriaLabel="Show Confirm Password"
                                  Validation="@(new Func<string, string?>(PasswordMatch))" />

                </MudForm>
            </MudPaper>
            <MudText Typo="Typo.caption">You will need to re-authenticate after updating.</MudText>
        </DialogContent>

        <DialogActions>
            <MudButton OnClick="()=> _updatePasswordDialogVisible = false" 
                       Class="px-0">Cancel</MudButton>

            <MudButton Color="Color.Primary"
                       Disabled="@(!_passwordFormIsValid)"
                       Class="px-0"
                       OnClick="SubmitUpdatedPassword">
                Submit
            </MudButton>
        </DialogActions>

    </MudDialog>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
}

@code {
    private string _immediateTextStyleStr = string.Empty;
    private string _cleanDaysTextStyleStr = string.Empty;
    private string _cleanDaysNumFieldStyleStr = string.Empty;
    private string _cleanDaysTextStr = string.Empty;
    private string _deleteDaysTextStr = string.Empty;
    private string _deleteDaysNumFieldStyleStr = string.Empty;

    private DialogOptions dialogOptions = new() { FullWidth = true };
    private MudDialog _updateEmailDialog = default!;
    private MudDialog _updatePasswordDialog = default!;
    private bool _updateEmailDialogVisible = false;
    private bool _updatePasswordDialogVisible = false;
    private bool _emailFormIsValid;
    private bool _passwordFormIsValid;
    private string[] _emailErrors = { };
    private string[] _passwordErrors = { };
    string? errorMessage;
    private MudForm _updateEmailForm = default!;
    private MudForm _updatePasswordForm = default!;
    private MudTextField<string> _pwField1 = default!;

    private UserModel _userModel = new();
    private CreateUserModel _authUserModel = new();
    private bool _isShowPassword = false;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    private bool _loading = false;
    private MudBlazor.Severity _alertSeverity = Severity.Normal;
    private string _alertMessage = string.Empty;

    private UserSettingsDisplayModel _localSettings = default!;
    public UserSettingsDisplayModel LocalSettings
    {
        get { return _localSettings; }
        set { _localSettings = value; }
    }

    private UserModel _localCurrentUser = default!;
    public UserModel LocalCurrentUser
    {
        get { return _localCurrentUser; }
        set { _localCurrentUser = value; }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        AppState.ShowProjectSubMenu = false;
        AppState.ShowContextSubMenu = false;

        dataRefreshTriggers = new List<string> { nameof(DataState.UserSettings), nameof(DataState.CurrentUser) };
        LoadAlertMessage();
    }

    protected override async Task OnInitializedAsync()
    {
        await VerifyAuthAndRedirectIfExpired();
        CustomAuthenticatedOnInit();
    }

    protected override void CustomAuthenticatedOnInit()
    {
        LoadLocalSettingsData();
        LoadLocalUserData();
    }

    private void LoadAlertMessage()
    {
        if (AppState.AlertMessage != null)
        {
            _alertMessage = AppState.AlertMessage;
            _alertSeverity = AppState.AlertSeverity;
        }
    }

    private async void OpenUpdateEmailDialog()
    {
        await VerifyAuthAndRedirectIfExpired();

        if (DataState.IsDataLoaded()) { _userModel.Email = LocalCurrentUser.Email; }
        _updateEmailDialogVisible = true;
    }

    private async Task SubmitUpdatedEmail()
    {
        await VerifyAuthAndRedirectIfExpired();

        AppState.ClearAlertMessage();

        await _updateEmailForm.Validate();
        if (_updateEmailForm.IsValid)
        {
            _updateEmailDialogVisible = false;
            _loading = true; // indicate request processing
            bool emailTaken = await UserEndpoint.CheckUserExists(_userModel);
            if (emailTaken)
            {
                _loading = false;
                AppState.AlertSeverity = Severity.Warning;
                AppState.AlertMessage = "Email address already associated with an existing account.";

            }
            else { await OnValidEmailSubmit(); }
        }
    }

    private async Task OnValidEmailSubmit()
    {
        errorMessage = string.Empty;
        AppState.ClearAlertMessage();

        try
        {
            await UserEndpoint.RequestUpdateEmail(_userModel);
            NavManager.NavigateTo($"/unconfirmedupdatedemail?email={_userModel.Email}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async void OpenUpdatePasswordDialog()
    {
        await VerifyAuthAndRedirectIfExpired();

        _authUserModel.Password = string.Empty;
        _authUserModel.ConfirmPassword = string.Empty;
        _updatePasswordDialogVisible = true;
    }

    private async Task SubmitUpdatedPassword()
    {
        await VerifyAuthAndRedirectIfExpired();

        await _updatePasswordForm.Validate();
        if (_updatePasswordForm.IsValid)
        {
            _updatePasswordDialogVisible = false;
            await OnValidPasswordSubmit();
        }
    }

    private async Task OnValidPasswordSubmit()
    {
        errorMessage = string.Empty;

        try
        {
            _loading = true; // indicate request processing
            await UserEndpoint.UpdatePassword(_authUserModel);

            CheckPasswordModel checkPasswordModel = new() { Email = _authUserModel.Email, Password = _authUserModel.Password };
            bool success = await UserEndpoint.CheckPasswordValid(checkPasswordModel);
            _loading = false;

            if (success)
            {
                // update auth state: log user out
                await AuthService.LogoutAsync();

                // set Alert notification on home page
                AppState.AlertSeverity = Severity.Success;
                AppState.AlertMessage = "Password successfully updated. Please log in again.";
                NavManager.NavigateTo("/");

                // send email confirmation
                UserModel user = new UserModel { Email = _authUserModel.Email };
                await UserEndpoint.SendPasswordChangeSuccessEmail(user);
            }
            else
            {
                AppState.AlertSeverity = Severity.Error;
                AppState.AlertMessage = "There was an error when attempting to change your password. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ToggleShowPassword()
    {
        _isShowPassword = !_isShowPassword;
        _passwordInputIcon = _isShowPassword ?
            Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        _passwordInput = _isShowPassword ? InputType.Text : InputType.Password;
    }

    private IEnumerable<string> PasswordStrength(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw))
        {
            yield return "Password is required.";
            yield break;
        }
        if (pw.Length < 6)
            yield return "Password must be at least of length 6.";
        if (!Regex.IsMatch(pw, @"[A-Z]"))
            yield return "Password must contain at least one capital letter.";
        if (!Regex.IsMatch(pw, @"[a-z]"))
            yield return "Password must contain at least one lowercase letter.";
        if (!Regex.IsMatch(pw, @"[0-9]"))
            yield return "Password must contain at least one digit.";
        if (!Regex.IsMatch(pw, @"[-+_!@#$%^&*.,?]"))
            yield return "Password must contain at least one special character.";
    }

    private string? PasswordMatch(string arg)
    {
        if (string.IsNullOrWhiteSpace(arg))
            return "Password confirmation is required.";
        else if (_pwField1.Value != arg)
            return "Passwords do not match.";
        return null;
    }

    private void SetRadioTextColor()
    {
        string enabledStr = "color: rgba(255, 255, 255, 0.6980392156862745)";
        string disabledStr = "color: rgba(255, 255, 255, 0.2)";

        _immediateTextStyleStr = LocalSettings.CleanUpImmediately ? enabledStr : disabledStr;
        _cleanDaysTextStyleStr = LocalSettings.CleanUpImmediately ? disabledStr : enabledStr;
    }

    private void SetDaysTextColor()
    {
        _cleanDaysTextStyleStr = !LocalSettings.CleanUpImmediately ?
            "color: rgba(255, 255, 255, 0.6980392156862745)" : "color: rgba(255, 255, 255, 0.2)";
    }

    protected void LoadLocalSettingsData()
    {
        if (DataState.IsDataLoaded())
        {
            LocalSettings = DataState.UserSettings;
            LocalSettings.PropertyChanged += OnExistingSettingsPropertyChanged!; // subscribe to property changed event
            SetRadioTextColor();
            _cleanDaysTextStr = LocalSettings.CleanUpDelayDays > 1 ? "days" : "day";
            _cleanDaysNumFieldStyleStr = LocalSettings.CleanUpDelayDays > 9 ? "max-width: 45px;" : "max-width: 35px;";
            _deleteDaysTextStr = LocalSettings.DeleteDelayDays > 1 ? "days" : "day";
            _deleteDaysNumFieldStyleStr = LocalSettings.DeleteDelayDays > 9 ? "max-width: 45px;" : "max-width: 35px;";
        }
    }

    protected void LoadLocalUserData()
    {
        if (DataState.IsDataLoaded() && DataState.CurrentUser != null)
        {
            LocalCurrentUser = DataState.CurrentUser;

            _userModel.Id = LocalCurrentUser.Id;
            _userModel.FirstName = LocalCurrentUser.FirstName;
            _userModel.LastName = LocalCurrentUser.LastName;
            _userModel.Email = LocalCurrentUser.Email;
            _authUserModel.FirstName = LocalCurrentUser.FirstName;
            _authUserModel.LastName = LocalCurrentUser.LastName;
            _authUserModel.Email = LocalCurrentUser.Email;
        }
    }

    // saves updated user settings data to server on property change
    protected async void OnExistingSettingsPropertyChanged(object sender, PropertyChangedEventArgs e)
    {
        string? changedProperty = e.PropertyName;
        UserSettingsDisplayModel senderSettings = (UserSettingsDisplayModel)sender;
        Console.WriteLine($"LocalSettings's property {changedProperty} was changed.");

        await VerifyAuthAndRedirectIfExpired();
        await DataService.UpdateSettingsData(senderSettings);
    }

    protected override bool HandleDataStateChanged(string propertyName, IDataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            //Console.WriteLine("SettingsViewPage: returned true on HandleDataStateChanged!");
            LoadLocalSettingsData();
        }

        return AppState.CanRefresh;
    }

    protected override bool HandleAppStateChanged(string propertyName, AppState appState)
    {
        if (propertyName != nameof(AppState.AlertMessage))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            //Console.WriteLine("SettingsViewPage: returned true on HandleAppStateChanged!");
            LoadAlertMessage();
        }

        return AppState.CanRefresh;
    }
}
