@page "/resetpw"

@inherits _ComponentBase
@inject IDataService DataService
@inject NavigationManager NavManager
@inject IUserEndpoint UserEndpoint
@inject IAuthenticationService AuthService
@using Microsoft.AspNetCore.WebUtilities
@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @_errorMessage
    </div>
}

<h1>@_resetPasswordModel.Token</h1>

<MudTreeView T="MudContainer" Width="100%">
    <MudTreeViewItem T="MudContainer"
                     Expanded="true"
                     Icon="@Icons.Material.Filled.AccountCircle"
                     Text="Reset Password"
                     TextTypo="Typo.button">

        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">

            <MudForm @ref="_passwordResetForm" @bind-IsValid="@_success" @bind-Errors="@_errors" Model="_resetPasswordModel">

                <MudInput T="string" @bind-Value="_resetPasswordModel.Email" hidden />
                <MudInput T="string" @bind-Value="_resetPasswordModel.Token" hidden />

                <MudTextField T="string"
                              Label="New password"
                              @bind-Value="_resetPasswordModel.Password"
                              @ref="_pwField1"
                              Style="width: 350px;"
                              InputType="@_passwordInput"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordInputIcon"
                              OnAdornmentClick="ToggleShowPassword"
                              AdornmentAriaLabel="Show Password"
                              Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))" />

                <MudTextField T="string"
                              Label="Confirm new password"
                              @bind-Value="_resetPasswordModel.ConfirmPassword"
                              InputType="@_passwordInput"
                              Style="width: 350px;"
                              Adornment="Adornment.End"
                              AdornmentIcon="@_passwordInputIcon"
                              OnAdornmentClick="ToggleShowPassword"
                              AdornmentAriaLabel="Show Confirm Password"
                              Validation="@(new Func<string, string>(PasswordMatch))" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@(!_success)"
                           Class="ml-auto mt-6"
                           OnClick="(() => SubmitPasswordResetForm())">
                    Submit
                </MudButton>
            </MudForm>

        </MudContainer>
    </MudTreeViewItem>
</MudTreeView>

@code {
    private ResetPasswordModel _resetPasswordModel = new();
    private string? _errorMessage;

    private MudForm _passwordResetForm;
    private bool _success;
    private string[] _errors = { };
    private MudTextField<string> _pwField1;

    private bool _isShowPassword = false;
    private InputType _passwordInput = InputType.Password;
    private string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;

    protected override void OnInitialized()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);

        var queryStrings = QueryHelpers.ParseQuery(uri.Query);
        if (queryStrings.TryGetValue("email", out var emailParam))
        {
            _resetPasswordModel.Email = emailParam;
        }
        if (queryStrings.TryGetValue("token", out var tokenParam))
        {
            _resetPasswordModel.Token = tokenParam;
        }
    }

    private async Task SubmitPasswordResetForm()
    {
        await _passwordResetForm.Validate();
        if (_passwordResetForm.IsValid)
        {
            await OnValidSubmit();
        }
    }

    private async Task OnValidSubmit()
    {
        _errorMessage = string.Empty;

        try
        {
            await UserEndpoint.ResetPassword(_resetPasswordModel);

            var result = await AuthService.LoginAsync(new() { Email = _resetPasswordModel.Email, Password = _resetPasswordModel.Password });
            if (result != null)
            {
                await DataService.FetchAllRemoteData();

                // set Alert notification on home page
                AppState.AlertMessage = "Password successfully updated.";
                AppState.AlertSeverity = Severity.Success;
                NavManager.NavigateTo("/");
            }
            else
            {
                _errorMessage = "Password reset was successful, but there was an error when attempting to log in.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void ToggleShowPassword()
    {
        _isShowPassword = !_isShowPassword;
        _passwordInputIcon = _isShowPassword ?
            Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        _passwordInput = _isShowPassword ? InputType.Text : InputType.Password;
    }

    private IEnumerable<string> PasswordStrength(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw))
        {
            yield return "Password is required.";
            yield break;
        }
        if (pw.Length < 6)
            yield return "Password must be at least of length 6.";
        if (!Regex.IsMatch(pw, @"[A-Z]"))
            yield return "Password must contain at least one capital letter.";
        if (!Regex.IsMatch(pw, @"[a-z]"))
            yield return "Password must contain at least one lowercase letter.";
        if (!Regex.IsMatch(pw, @"[0-9]"))
            yield return "Password must contain at least one digit.";
        if (!Regex.IsMatch(pw, @"[-+_!@#$%^&*.,?]"))
            yield return "Password must contain at least one special character.";
    }

    private string PasswordMatch(string arg)
    {
        if (string.IsNullOrWhiteSpace(arg))
            return "Password confirmation is required.";
        else if (_pwField1.Value != arg)
            return "Passwords do not match.";
        return null;
    }
}
