@page "/attemptlogin"

@inject NavigationManager Navigation

<PageTitle>TaskFocus</PageTitle>

@code {
    [CascadingParameter]
    public Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var returnUrl = SignInRedirect.GetReturnUrl(Navigation);
        var authState = await AuthState;
        var destination = authState.User.Identity?.IsAuthenticated == true
            ? returnUrl ?? "/inbox"
            : SignInRedirect.LoginUrl(returnUrl);
        Navigation.NavigateTo(destination, replace: true);
    }
}
