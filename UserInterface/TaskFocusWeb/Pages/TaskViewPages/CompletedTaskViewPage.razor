@page "/completed"
@using TaskFocusUI.Library.Data.Services
@using TaskFocusUI.Library.Data.Services.Access
@using TaskFocusUI.Library.Data.State
@inherits _TaskViewPageBase
@inject IDataService DataService

<PageTitle>TaskFocus: Completed</PageTitle>

@if (IsLocalDataLoaded())
{
    if (_completedTasks!.Count() > 0)
    {
        <MudTreeView T="TaskContainerComponent" Width="100%">

            <MudTreeViewItem T="TaskContainerComponent"
            Expanded="true"
            Icon="@Icons.Material.Filled.Checklist"
            Text="Completed"
            TextTypo="Typo.button">

                <TaskContainerComponent ContainerTaskItemsParam="@_completedTasks"
                ContainerIdentifierParam="Completed"
                CanReorderParam="false"
                ContainerItemsSelectorParam="@ItemsSelector"
                ContainerProjectsParam="@LocalProjects"
                ContainerContextsParam="@LocalContexts" />
            </MudTreeViewItem>
        </MudTreeView>
    }
    else
    {
        <MudTreeView T="MudContainer" Width="75%">

            <MudTreeViewItem T="MudContainer"
            Expanded="true"
            Icon="@Icons.Material.Filled.Checklist"
            Text="Completed"
            TextTypo="Typo.button">

                <MudContainer MaxWidth="MaxWidth.Medium">
                    <MudPaper Elevation="25" Class="pa-0 my-2">
                        <MudText Class="pa-4" Align="Align.Center">
                            Completed tasks will appear here until deleted. 
                            <br />
                            Adjust automatic deletion interval in Settings (current: <strong>@_currentDeletionIntervalSettingStr</strong>).
                            <br />
                            <br />
                            Completed tasks will <strong>also</strong> remain displayed in other views, until cleaned up. 
                            <br />
                            Adjust automatic clean up interval in Settings (current: <strong>@_currentCleanUpIntervalSettingStr</strong>).
                        </MudText>
                    </MudPaper>
                </MudContainer>

            </MudTreeViewItem>
        </MudTreeView>
    }
}

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-6">

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <MudAlert Class="mt-6" Elevation="25" Severity="_alertSeverity">@_alertMessage</MudAlert>
    }

</MudContainer>

@code {
    private List<TaskDisplayModel>? _completedTasks;
    private string _currentDeletionIntervalSettingStr = string.Empty;
    private string _currentCleanUpIntervalSettingStr = string.Empty;

    protected override void CustomAuthenticatedOnInit()
    {
        LoadAllLocalData();
        LoadCurrentSettingsStrings();
    }

    protected override bool IsLocalDataLoaded()
    {
        return _completedTasks != null && LocalProjects != null && LocalContexts != null;
    }

    protected override void LoadLocalTaskData()
    {
        if (DataState.IsDataLoaded())
        {
            List<TaskDisplayModel> unorderedCompletedTasks = DataService.GetDataStateTasks()!.Where(x => x.Completed).ToList();      
            _completedTasks = unorderedCompletedTasks.OrderBy(x => x.DateCompleted).ToList();
            SubscribeToTaskPropertyChangedEvents(_completedTasks);
        }
    }

    public override void Dispose()
    {
        // unsubscribe from event handlers
        base.Dispose(); // for -= AppStateChanged; -= DataStateChanged;
        UnsubscribeFromTaskPropertyChangedEvents(_completedTasks);
    }

    private void LoadCurrentSettingsStrings()
    {
        if (DataState.IsDataLoaded())
        {
            string dayStr = DataState.UserSettings!.DeleteDelayDays > 1 ? " days" : " day";
            _currentDeletionIntervalSettingStr = DataState.UserSettings.DeleteDelayDays.ToString() + dayStr;

            if (DataState.UserSettings.CleanUpImmediately) { _currentCleanUpIntervalSettingStr = "immediate"; }
            else
            {
                dayStr = DataState.UserSettings.CleanUpDelayDays > 1 ? " days" : " day";
                _currentCleanUpIntervalSettingStr = DataState.UserSettings.CleanUpDelayDays.ToString() + dayStr;
            }
        }
    }

    protected override bool HandleDataStateChanged(string propertyName, IDataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName)) return false;
        
        if (AppState.CanRefresh)
        {
            LoadAllLocalData();
            LoadCurrentSettingsStrings();
            Console.WriteLine($"CompletedTaskViewPage: returned true on HandleDataStateChanged. changed property causing True return: {propertyName}");
        }

        return AppState.CanRefresh;
    }
}
