@page "/completed"
@inherits _TaskViewPageBase

<PageTitle>TaskFocus: Completed</PageTitle>

@if (IsLocalDataLoaded())
{
    if (LocalTasks!.Count() > 0)
    {
        <MudTreeView T="TaskContainerComponent" Width="100%">
            <MudTreeViewItem T="TaskContainerComponent"
                             Expanded="true"
                             Icon="@Icons.Material.Filled.Checklist"
                             Text="Completed"
                             TextTypo="Typo.button">

                <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks"
                                        ContainerIdentifierParam="Completed"
                                        CanReorderParam="false"
                                        ContainerItemsSelectorParam="@ItemsSelector"
                                        ContainerProjectsParam="@LocalProjects"
                                        ContainerContextsParam="@LocalContexts" />
            </MudTreeViewItem>
        </MudTreeView>
    }
    else
    {
        <MudTreeView T="MudContainer" Width="75%">
            <MudTreeViewItem T="MudContainer"
                             Expanded="true"
                             Icon="@Icons.Material.Filled.Checklist"
                             Text="Completed"
                             TextTypo="Typo.button">

                <MudContainer MaxWidth="MaxWidth.Medium">
                    <MudPaper Elevation="25" Class="pa-0 my-2">
                        <MudText Class="pa-4" Align="Align.Center">
                            Completed tasks will appear here until deleted. Adjust automatic deletion interval in Settings (current: {30} days).
                        </MudText>
                    </MudPaper>
                </MudContainer>

            </MudTreeViewItem>
        </MudTreeView>
    }
}

@code {

    // TODO: bind 0 completed items {30} days to an actual settings variable, once implemented!

    protected override void CustomAuthenticatedOnInit()
    {
        LoadAllLocalData();
    }

    protected override void LoadLocalTaskData()
    {
        if (DataState.IsDataLoaded())
        {
            List<TaskDisplayModel> completedTasks = DataState.Tasks!.Where(x => x.Completed).ToList();
            
            completedTasks.OrderBy(x => x.DateCompleted);
            LocalTasks = completedTasks;
            foreach (TaskDisplayModel task in LocalTasks!)
            {
                //Console.WriteLine($"{task.TaskName}: {task.InboxIndex.ToString()}");
                task.PropertyChanged += OnExistingTaskPropertyChanged!; // subscribe to property changed event
            }
        }
    }

    public override bool ItemsSelector(TaskDisplayModel item, string dropzone)
    {
        return true;
    }

    protected override bool HandleDataStateChanged(string propertyName, DataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            //Console.WriteLine("InboxTaskPage: returned true on HandleDataStateChanged!");
            LoadAllLocalData();
        }

        return AppState.CanRefresh;
    }
}
