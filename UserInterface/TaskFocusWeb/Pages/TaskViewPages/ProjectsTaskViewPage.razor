@page "/projects"
@inherits _TaskViewPageBase

<PageTitle>TaskFocus: Projects</PageTitle>

<MudStack Row="true">
    @if (IsLocalDataLoaded())
    {
        @if (_focusedProject is { Id: int focusedId } focusedProject)
        {
            <MudTreeView @key="focusedId" T="TaskContainerComponent" Width="100%">

                <MudTreeViewItem T="TaskContainerComponent" 
                Expanded="true" 
                Icon="@Icons.Material.Filled.Assignment" 
                Text="@focusedProject.ProjectName" TextTypo="Typo.button">

                    <TaskContainerComponent 
                    ContainerTaskItemsParam="@LocalTasks!.GetProjectTasks(focusedId)"
                    ContainerIdentifierParam="@focusedId.ToString()"
                    ContainerOrderingTypeParam="Project"
                    ContainerItemsSelectorParam="@((item, _) => item.ProjectId == focusedId)"
                    ContainerProjectsParam="@LocalProjects"
                    ContainerContextsParam="@LocalContexts" />
                </MudTreeViewItem>
            </MudTreeView>
        }
        else if (LocalProjects!.Count > 0) // all projects view
        {
            <MudTreeView T="TaskContainerComponent" Width="100%">
                @foreach (ProjectDisplayModel project in LocalProjects!)
                {
                    <MudTreeViewItem T="TaskContainerComponent" 
                    Expanded="true" 
                    Icon="@Icons.Material.Filled.Assignment" 
                    Text="@project.ProjectName" 
                    TextTypo="Typo.button">

                        <TaskContainerComponent 
                        ContainerTaskItemsParam="@(project.Id is int id ? LocalTasks!.GetProjectTasks(id) : [])"
                        ContainerIdentifierParam="@(project.Id?.ToString() ?? $"pending-{project.TempLocalId}")"
                        ContainerOrderingTypeParam="Project"
                        ContainerItemsSelectorParam="@((item, _) => item.ProjectId == project.Id)"
                        ContainerProjectsParam="@LocalProjects"
                        ContainerContextsParam="@LocalContexts" />
                    </MudTreeViewItem>  
                }
            </MudTreeView>
        }
        else
        {
            <MudTreeView T="MudContainer" Width="75%">

                <MudTreeViewItem T="MudContainer"
                Expanded="true"
                Icon="@Icons.Material.Filled.Assignment"
                Text=""
                TextTypo="Typo.button">

                    <MudContainer MaxWidth="MaxWidth.Medium">
                        <MudPaper Elevation="25" Class="pa-0 my-2">
                            <MudText Class="pa-4" Align="Align.Center">
                                Group related or dependent tasks by creating and assigning <strong>Projects</strong>, which will appear here.
                            </MudText>
                        </MudPaper>
                    </MudContainer>

                </MudTreeViewItem>
            </MudTreeView>
        }
    }
</MudStack>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-6">

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <MudAlert Class="mt-6" Elevation="25" Severity="_alertSeverity">@_alertMessage</MudAlert>
    }

</MudContainer>

@code {
    private ProjectDisplayModel? _focusedProject;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!AppState.ShowProjectSubMenu) AppState.ShowProjectSubMenu = true;
    }

    protected override void CustomAuthenticatedOnInit()
    {
        LoadAllLocalData();
        ResolveFocusedProject();
    }

    protected override bool IsLocalDataLoaded()
    {
        return LocalTasks != null && LocalProjects != null && LocalContexts != null;
    }

    private void ResolveFocusedProject()
    {
        var selectedId = AppState.FocusedProjectIdStr;
        _focusedProject = int.TryParse(selectedId, out var id)
            ? LocalProjects?.Find(x => x.Id == id)
            : null;

        if (selectedId != null && LocalProjects != null && _focusedProject == null)
        {
            AppState.FocusedProjectIdStr = null;
        }
    }

    protected override bool HandleAppStateChanged(string propertyName, AppState appState)
    {
        if (propertyName == nameof(AppState.FocusedProjectIdStr) ||
            propertyName == nameof(AppState.RequestManualRefresh) ||
            propertyName == nameof(AppState.CanRefresh))
        {
            if (!AppState.CanRefresh) return false;
            if (propertyName != nameof(AppState.FocusedProjectIdStr)) LoadAllLocalData();

            ResolveFocusedProject();
            return true;
        }

        return base.HandleAppStateChanged(propertyName, appState);
    }

    protected override bool HandleDataStateChanged(string propertyName, IDataState dataState)
    {
        if (!base.HandleDataStateChanged(propertyName, dataState)) return false;

        ResolveFocusedProject();
        return true;
    }
}