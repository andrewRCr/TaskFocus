@page "/projects"
@inherits _TaskViewPageBase
@inject IDataService DataService

<PageTitle>TaskFocus: Projects</PageTitle>

<MudStack Row="true">
    @if (IsLocalDataLoaded())
    {
        @if (_focusedProjectIdStr != null && ProjectParam != null)
        {
            <MudTreeView T="TaskContainerComponent" Width="100%">

                <MudTreeViewItem T="TaskContainerComponent" 
                Expanded="true" 
                Icon="@Icons.Material.Filled.Assignment" 
                Text="@ProjectParam.ProjectName" TextTypo="Typo.button">

                    <TaskContainerComponent 
                    ContainerTaskItemsParam="@DataService.GetDataStateTasks()!.Where(
                        x => (x.ProjectId != null) && (x.ProjectId == ProjectParam.Id) && !x.CleanedUp).ToList()"
                    ContainerIdentifierParam="@ProjectParam.ProjectName"
                    ContainerOrderingTypeParam="Project"
                    ContainerItemsSelectorParam="@((item, dropzone) => item.ProjectName == dropzone)"
                    ContainerProjectsParam="@LocalProjects"
                    ContainerContextsParam="@LocalContexts" />
                </MudTreeViewItem>
            </MudTreeView>
        }
        else if (LocalProjects!.Count > 0) // all projects view
        {
            <MudTreeView T="TaskContainerComponent" Width="100%">
                @foreach (ProjectDisplayModel project in LocalProjects!)
                {
                    <MudTreeViewItem T="TaskContainerComponent" 
                    Expanded="true" 
                    Icon="@Icons.Material.Filled.Assignment" 
                    Text="@project.ProjectName" 
                    TextTypo="Typo.button">

                        <TaskContainerComponent 
                        ContainerTaskItemsParam="@DataService.GetDataStateTasks()!.Where(
                            x => (x.ProjectId != null) && (x.ProjectId == project.Id) && !x.CleanedUp).ToList()"
                        ContainerIdentifierParam="@project.ProjectName"
                        ContainerOrderingTypeParam="Project"
                        ContainerItemsSelectorParam="@((item, dropzone) => item.ProjectName == dropzone)"
                        ContainerProjectsParam="@LocalProjects"
                        ContainerContextsParam="@LocalContexts" />
                    </MudTreeViewItem>  
                }
            </MudTreeView>
        }
        else
        {
            <MudTreeView T="MudContainer" Width="75%">

                <MudTreeViewItem T="MudContainer"
                Expanded="true"
                Icon="@Icons.Material.Filled.Assignment"
                Text=""
                TextTypo="Typo.button">

                    <MudContainer MaxWidth="MaxWidth.Medium">
                        <MudPaper Elevation="25" Class="pa-0 my-2">
                            <MudText Class="pa-4" Align="Align.Center">
                                Group related or dependent tasks by creating and assigning <strong>Projects</strong>, which will appear here.
                            </MudText>
                        </MudPaper>
                    </MudContainer>

                </MudTreeViewItem>
            </MudTreeView>
        }
    }
</MudStack>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-6">

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <MudAlert Class="mt-6" Elevation="25" Severity="_alertSeverity">@_alertMessage</MudAlert>
    }

</MudContainer>

@code {
    private string? _focusedProjectIdStr = null;
    public ProjectDisplayModel ProjectParam { get; set; } = default!;
    bool isValid = false;
    int integerProjectId;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!AppState.ShowProjectSubMenu) { AppState.ShowProjectSubMenu = true; }
    }

    protected override void CustomAuthenticatedOnInit()
    {
        LoadAllLocalData();
        _focusedProjectIdStr = AppState.FocusedProjectIdStr;
    }

    protected override bool IsLocalDataLoaded()
    {
        return LocalTasks != null && LocalProjects != null & LocalContexts != null;
    }

    protected void GetProjectFromId()
    {
        isValid = int.TryParse(_focusedProjectIdStr, out integerProjectId);
        if (isValid)
        {
            ProjectParam = DataService.GetDataStateProjects()!.Find(x => x.Id == integerProjectId)!;
        }
    }

    public bool ProjectItemsSelector(ProjectDisplayModel item, string dropzone)
    {
        return true;
    }

    protected override bool HandleAppStateChanged(string propertyName, AppState appState)
    {
        if (propertyName != nameof(AppState.FocusedProjectIdStr) && !appRefreshTriggers.Contains(propertyName))
        {
            return false;     
        }

        if (AppState.CanRefresh)
        {
            _focusedProjectIdStr = AppState.FocusedProjectIdStr;
            LoadAlertMessage();

            if (_focusedProjectIdStr != null)
            {
                GetProjectFromId();
            }
        }

        return AppState.CanRefresh;
    }

    protected override bool HandleDataStateChanged(String propertyName, IDataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))
        {
        
            Console.WriteLine($"ProjectsViewPageBase: returned FALSE on HandleDataStateChanged. changed property causing FALSE return: {propertyName}");
            return false;
        }

        if (AppState.CanRefresh)
        {
            LoadAllLocalData();
            Console.WriteLine($"ProjectsViewPageBase: returned true on HandleDataStateChanged. changed property causing True return: {propertyName}");
        }

        return AppState.CanRefresh;
    }
}