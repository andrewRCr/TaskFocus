@inherits AllProjectsTaskViewPage
@inject IProjectEndpoint ProjectEndpoint

@if (ProjectParam != null && IsLocalDataLoaded())
{
    <MudStack Style="width:100%;">

        <MudPaper Square Class="mud-background-gray" Elevation="25">
            <MudButton Disabled Class="mx-2">@ProjectParam.ProjectName</MudButton>
        </MudPaper>

        <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks" ContainerIdentifierParam="@ProjectParam.ProjectName" ContainerItemsSelectorParam="@ItemsSelector"
                                ContainerProjectsParam="@LocalProjects" ContainerContextsParam="@LocalContexts" />
    </MudStack>


}
@* #929296, #7e6fff  *@
<style>
    .mud-button {
        &:disabled
        {
            color: #7e6fff !important;
            cursor: default;
            pointer-events: none;
        }
    }
</style>

@code {
    [Parameter]
    public string ProjectId { get; set; } = default!;

    public ProjectDisplayModel ProjectParam { get; set; } = default!;

    bool isValid = false;
    int integerProjectId;

    protected override void OnParametersSet()
    {
        GetProjectFromId();
    }

    protected void GetProjectFromId()
    {
        isValid = int.TryParse(ProjectId, out integerProjectId);
        if (isValid)
        {
            ProjectParam = DataState.Projects!.Find(x => x.Id == integerProjectId)!;
        }  
    }

    public override bool ItemsSelector(TaskDisplayModel item, string dropzone)
    {
        return item.ProjectName == dropzone;
    }

    protected override bool HandleDataStateChanged(string propertyName, DataState dataState)
    {
        if (propertyName != nameof(DataState.Projects))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            LoadAllLocalData();
            GetProjectFromId();
            //Console.WriteLine("ProjectTaskViewPage: returned true on HandleDataStateChanged!");
        }

        return AppState.CanRefresh;
    }
}
