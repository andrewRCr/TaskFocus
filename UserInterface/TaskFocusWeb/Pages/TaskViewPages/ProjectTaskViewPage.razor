@page "/projects/{ProjectId}"
@inherits _TaskViewPageBase
@inject IProjectEndpoint ProjectEndpoint

<PageTitle>TaskFocus: Projects</PageTitle>

<MudStack Row="true">

    <ProjectSubMenu />

    @if (Project != null && Tasks != null)
    {
        <TaskContainerComponent ContainerTaskItemsParam="@Tasks" ContainerIdentifierParam="@Project.ProjectName" ContainerItemsSelectorParam="@ItemsSelector"
                                ContainerProjectsParam="@Projects" ContainerContextsParam="@Contexts" />
    }

</MudStack>

@code {
    [Parameter]
    public string ProjectId { get; set; } = default!;

    public ProjectModel Project { get; set; } = default!;

    bool isValid = false;
    int integerProjectId;

    protected override async Task OnParametersSetAsync()
    {
        await GetProjectFromId();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        //StateHasChanged();
    }

    protected async Task GetProjectFromId()
    {
        isValid = int.TryParse(ProjectId, out integerProjectId);
        if (isValid)
        {
            Project = await ProjectEndpoint.GetProjectById(integerProjectId);
        }  
    }

    public override bool ItemsSelector(TaskModel item, string dropzone)
    {
        return item.ProjectName == dropzone;
    }
}
