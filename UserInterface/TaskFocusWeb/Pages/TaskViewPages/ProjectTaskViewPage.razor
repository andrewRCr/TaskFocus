@inherits AllProjectsTaskViewPage
@inject IProjectEndpoint ProjectEndpoint

@if (ProjectParam != null && IsLocalDataLoaded())
{

    <MudExpansionPanel Style="background-color: #32333d;" IsInitiallyExpanded="true" Class="" >
        <TitleContent>
            <MudPaper Class="mud-background-gray pa-3" Elevation="25" MaxWidth="98%;">
                <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Style="color: #919195;" />
                <MudText Class="mx-2" Color="Color.Primary" Typo="Typo.button">@ProjectParam.ProjectName</MudText>
            </MudPaper>
        </TitleContent>
        <ChildContent>
            <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks"
                                    ContainerIdentifierParam="@ProjectParam.ProjectName"
                                    ContainerOrderingTypeParam="Project"
                                    ContainerItemsSelectorParam="@ItemsSelector"
                                    ContainerProjectsParam="@LocalProjects"
                                    ContainerContextsParam="@LocalContexts" />
        </ChildContent>
        </MudExpansionPanel>



