@inherits AllProjectsTaskViewPage
@inject IProjectEndpoint ProjectEndpoint

@if (ProjectParam != null && IsLocalDataLoaded())
{
    <MudTreeView T="TaskContainerComponent" Width="100%">
        <MudTreeViewItem T="TaskContainerComponent"
                         Expanded="true"
                         Icon="@Icons.Material.Filled.Assignment"
                         Text="@ProjectParam.ProjectName"
                         TextTypo="Typo.button">

            <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks"
                                    ContainerIdentifierParam="@ProjectParam.ProjectName"
                                    ContainerOrderingTypeParam="Project"
                                    ContainerItemsSelectorParam="@ItemsSelector"
                                    ContainerProjectsParam="@LocalProjects"
                                    ContainerContextsParam="@LocalContexts" />
        </MudTreeViewItem>
    </MudTreeView>
}

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-6">

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <MudAlert Class="mt-6" Elevation="25" Severity="_alertSeverity">@_alertMessage</MudAlert>
    }

</MudContainer>

@code {
    [Parameter]
    public string ProjectId { get; set; } = default!;

    public ProjectDisplayModel ProjectParam { get; set; } = default!;

    bool isValid = false;
    int integerProjectId;

    protected override void LoadLocalTaskData()
    {
        if (DataState.IsDataLoaded())
        {
            List<TaskDisplayModel> projectTasks = DataState.Tasks!.Where(x => (x.ProjectId == int.Parse(ProjectId)) && !x.CleanedUp).ToList();
            projectTasks = projectTasks.OrderBy(x => x.ProjectIndex).ToList();
            LocalTasks = projectTasks;

            foreach (TaskDisplayModel task in LocalTasks!)
            {
                //Console.WriteLine($"{task.TaskName}: {task.ProjectIndex.ToString()}");
                task.PropertyChanged += OnExistingTaskPropertyChanged!; // subscribe to property changed event
            }
        }
    }

    protected override void OnParametersSet()
    {
        GetProjectFromId();
        LoadAllLocalData();
    }

    protected void GetProjectFromId()
    {
        isValid = int.TryParse(ProjectId, out integerProjectId);
        if (isValid)
        {
            ProjectParam = DataState.Projects!.Find(x => x.Id == integerProjectId)!;
        }  
    }

    public override bool ItemsSelector(TaskDisplayModel item, string dropzone)
    {
        return item.ProjectName == dropzone;
    }

    protected override bool HandleAppStateChanged(string propertyName, AppState appState)
    {
        if (!appRefreshTriggers.Contains(propertyName)) { return false; }
        if (AppState.CanRefresh) { LoadAlertMessage(); }

        return AppState.CanRefresh;
    }

    protected override bool HandleDataStateChanged(string propertyName, DataState dataState)
    {
        if (propertyName != nameof(DataState.Projects))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            LoadAllLocalData();
            GetProjectFromId();
            //Console.WriteLine("ProjectTaskViewPage: returned true on HandleDataStateChanged!");
        }

        return AppState.CanRefresh;
    }
}
