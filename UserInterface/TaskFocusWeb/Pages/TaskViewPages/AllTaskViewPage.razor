@page "/all"
@inherits _TaskViewPageBase

<PageTitle>TaskFocus: All Tasks</PageTitle>

@if (IsLocalDataLoaded())
{

    <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks" ContainerIdentifierParam="All Tasks" ContainerItemsSelectorParam="@ItemsSelector"
                            ContainerProjectsParam="@LocalProjects" ContainerContextsParam="@LocalContexts" />
}


@code {
    public override bool ItemsSelector(TaskDisplayModel item, string dropzone)
    {
        return true;
    }
}
