@page "/all"
@inherits _TaskViewPageBase

<PageTitle>TaskFocus: All Tasks</PageTitle>

@if (Tasks != null)
{

    <TaskContainerComponent ContainerTaskItemsParam="@Tasks" ContainerIdentifierParam="All Tasks" ContainerItemsSelectorParam="@ItemsSelector"
                            ContainerProjectsParam="@Projects" ContainerContextsParam="@Contexts" />
}


@code {
    public override bool ItemsSelector(TaskModel item, string dropzone)
    {
        return true;
    }
}
