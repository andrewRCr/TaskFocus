@page "/today"
@inherits _TaskViewPageBase
@inject IDataService DataService

<PageTitle>TaskFocus: Today</PageTitle>

@if (IsLocalDataLoaded())
{
    if (LocalTasks!.Count() > 0)
    {
        <MudTreeView T="TaskContainerComponent" Width="100%">
            <MudTreeViewItem T="TaskContainerComponent"
                             Expanded="true"
                             Icon="@Icons.Material.Filled.Today"
                             Text="Today"
                             TextTypo="Typo.button">

                <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks" 
                                        ContainerIdentifierParam="Today" 
                                        ContainerOrderingTypeParam="Today"
                                        ContainerItemsSelectorParam="@ItemsSelector"
                                        ContainerProjectsParam="@LocalProjects" 
                                        ContainerContextsParam="@LocalContexts" />
            </MudTreeViewItem>
        </MudTreeView>
    }
    else
    {
        <MudTreeView T="MudContainer" Width="75%">
            <MudTreeViewItem T="MudContainer"
                             Expanded="true"
                             Icon="@Icons.Material.Filled.Today"
                             Text="Today"
                             TextTypo="Typo.button">

                <MudContainer MaxWidth="MaxWidth.Medium">
                    <MudPaper Elevation="25" Class="pa-0 my-2">
                        <MudText Class="pa-4" Align="Align.Center">
                            Tasks that have been <strong>Starred</strong>, or whose assigned Due Date is <strong>today or earlier</strong>, will appear here.
                        </MudText>
                    </MudPaper>
                </MudContainer>

            </MudTreeViewItem>
        </MudTreeView>
    }
}

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-6">

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <MudAlert Class="mt-6" Elevation="25" Severity="_alertSeverity">@_alertMessage</MudAlert>
    }

</MudContainer>

@code {
    protected override void CustomAuthenticatedOnInit()
    {
        LoadAllLocalData();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // remove TodayIndex from any completed (but not CleanedUp) tasks from view if completed > 1 day ago
        var oldCompletedTodayTasks = DataState.Tasks!.Where(x => x.TodayIndex != null && x.Completed && (x.DateCompleted < DateTime.Now.Date)).ToList();
        foreach (TaskDisplayModel task in oldCompletedTodayTasks)
        {
            // force update: will detect and remove TodayIndex, as well as shift other task indices accordingly if needed
            await DataService.UpdateTaskData(task, true);
        }
    }

    protected override void LoadLocalTaskData()
    {
        if (DataState.IsDataLoaded())
        {
            List<TaskDisplayModel> dueTasks = DataState.Tasks!.Where(x => 
                (x.DueDate <= DateTime.Now.Date) && !x.CleanedUp && (x.DateCompleted == null || x.DateCompleted == DateTime.Now.Date)).ToList();
            List<TaskDisplayModel> starredTasks = DataState.Tasks!.Where(x => 
                (x.Starred == true) && !x.CleanedUp && (x.DateCompleted == null || x.DateCompleted == DateTime.Now.Date)).ToList();
            List<TaskDisplayModel> todayTasks = dueTasks.Concat(starredTasks).ToList();

            // ensure any newly due/overdue tasks have a TodayIndex
            int todayTasksWithTodayIndexCount = todayTasks.Where(x => x.TodayIndex != null).ToList().Count();
            foreach (TaskDisplayModel task in todayTasks)
            {
                if (task.DueDate <= DateTime.Now.Date && task.TodayIndex == null)
                {
                    task.TodayIndex = todayTasksWithTodayIndexCount;
                    todayTasksWithTodayIndexCount++;
                }
            }

            todayTasks = todayTasks.OrderBy(x => x.TodayIndex).ToList();
            LocalTasks = todayTasks;
            foreach (TaskDisplayModel task in LocalTasks!)
            {
                task.PropertyChanged += OnExistingTaskPropertyChanged!; // subscribe to property changed event
            }
        }
    }

    public override bool ItemsSelector(TaskDisplayModel item, string dropzone)
    {
        return true;
    }

    protected override bool HandleAppStateChanged(string propertyName, AppState appState)
    {
        if (!appRefreshTriggers.Contains(propertyName)) { return false; }
        if (AppState.CanRefresh) { LoadAlertMessage(); }

        return AppState.CanRefresh;
    }

    protected override bool HandleDataStateChanged(string propertyName, IDataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            //Console.WriteLine("TodayTaskPage: returned true on HandleDataStateChanged!");
            LoadAllLocalData();
        }

        return AppState.CanRefresh;
    }
}
