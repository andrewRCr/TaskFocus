@page "/today"
@inherits _TaskViewPageBase

<PageTitle>TaskFocus: Today</PageTitle>

@if (IsLocalDataLoaded())
{
    if (LocalTasks!.Count() > 0)
    {
        <MudTreeView T="TaskContainerComponent" Width="100%">
            <MudTreeViewItem T="TaskContainerComponent"
                             Expanded="true"
                             Icon="@Icons.Material.Filled.Today"
                             Text="Today"
                             TextTypo="Typo.button">

                <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks" 
                                        ContainerIdentifierParam="Today" 
                                        ContainerOrderingTypeParam="Today"
                                        ContainerItemsSelectorParam="@ItemsSelector"
                                        ContainerProjectsParam="@LocalProjects" 
                                        ContainerContextsParam="@LocalContexts" />
            </MudTreeViewItem>
        </MudTreeView>
    }
    else
    {
        <MudTreeView T="MudContainer" Width="75%">
            <MudTreeViewItem T="MudContainer"
                             Expanded="true"
                             Icon="@Icons.Material.Filled.Today"
                             Text="Today"
                             TextTypo="Typo.button">

                <MudContainer>
                        <MudPaper Elevation="25" Class="pa-0 my-2">
                        <MudText Class="pa-4" Align="Align.Center">
                            Tasks that have been Starred or whose assigned Due Date is today will appear here.
                        </MudText>
                    </MudPaper>
                </MudContainer>

            </MudTreeViewItem>
        </MudTreeView>
    }
}

@code {
    protected override void CustomAuthenticatedOnInit()
    {
        LoadAllLocalData();
    }

    protected override void LoadLocalTaskData()
    {
        if (DataState.IsDataLoaded())
        {
            List<TaskDisplayModel> dueTasks = DataState.Tasks!.Where(x => x.DueDate <= DateTime.Now.Date).ToList();
            List<TaskDisplayModel> starredTasks = DataState.Tasks!.Where(x => x.Starred == true).ToList();
            List<TaskDisplayModel> todayTasks = dueTasks.Concat(starredTasks).ToList();

            // ensure any newly due/overdue tasks have a TodayIndex
            int todayTasksWithTodayIndexCount = todayTasks.Where(x => x.TodayIndex != null).ToList().Count();
            foreach (TaskDisplayModel task in dueTasks)
            {
                if (task.TodayIndex == null)
                {
                    task.TodayIndex = todayTasksWithTodayIndexCount;
                    todayTasksWithTodayIndexCount++;
                }
            }

            todayTasks = todayTasks.OrderBy(x => x.TodayIndex).ToList();
            LocalTasks = todayTasks;
            foreach (TaskDisplayModel task in LocalTasks!)
            {
                //Console.WriteLine($"{task.TaskName}: {task.InboxIndex.ToString()}");
                task.PropertyChanged += OnExistingTaskPropertyChanged!; // subscribe to property changed event
            }
        }
    }

    public override bool ItemsSelector(TaskDisplayModel item, string dropzone)
    {
        return true;
    }

    protected override bool HandleDataStateChanged(string propertyName, DataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            //Console.WriteLine("TodayTaskPage: returned true on HandleDataStateChanged!");
            LoadAllLocalData();
        }

        return AppState.CanRefresh;
    }
}
