@page "/today"
@using TaskFocusUI.Library.Data.Services
@using TaskFocusUI.Library.Data.Services.Access
@inherits _TaskViewPageBase
@inject IDataService DataService

<PageTitle>TaskFocus: Today</PageTitle>

@if (IsLocalDataLoaded())
{
    if (_todayTasks!.Count() > 0)
    {
        <MudTreeView T="TaskContainerComponent" Width="100%">

            <MudTreeViewItem T="TaskContainerComponent"
            Expanded="true"
            Icon="@Icons.Material.Filled.Today"
            Text="Today"
            TextTypo="Typo.button">

                <TaskContainerComponent ContainerTaskItemsParam="@_todayTasks" 
                ContainerIdentifierParam="Today" 
                ContainerOrderingTypeParam="Today"
                ContainerItemsSelectorParam="@ItemsSelector"
                ContainerProjectsParam="@LocalProjects" 
                ContainerContextsParam="@LocalContexts" />
            </MudTreeViewItem>
        </MudTreeView>
    }
    else
    {
        <MudTreeView T="MudContainer" Width="75%">
            <MudTreeViewItem T="MudContainer"
            Expanded="true"
            Icon="@Icons.Material.Filled.Today"
            Text="Today"
            TextTypo="Typo.button">

                <MudContainer MaxWidth="MaxWidth.Medium">
                    <MudPaper Elevation="25" Class="pa-0 my-2">
                        <MudText Class="pa-4" Align="Align.Center">
                            Tasks that have been <strong>Starred</strong>, or whose assigned Due Date is <strong>today or earlier</strong>, will appear here.
                        </MudText>
                    </MudPaper>
                </MudContainer>

            </MudTreeViewItem>
        </MudTreeView>
    }
}

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-6">

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <MudAlert Class="mt-6" Elevation="25" Severity="_alertSeverity">@_alertMessage</MudAlert>
    }

</MudContainer>

@code {

    private List<TaskDisplayModel>? _todayTasks;

    protected override void CustomAuthenticatedOnInit()
    {
        LoadAllLocalData();
    }

    protected override bool IsLocalDataLoaded()
    {
        return _todayTasks != null && LocalProjects != null && LocalContexts != null;
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // remove TodayIndex from any completed (but not CleanedUp) tasks from view if completed > 1 day ago
        var oldCompletedTodayTasks = DataService.GetDataStateTasks()!.Where(x => x.TodayIndex != null && x.Completed && (x.DateCompleted < DateTime.Now.Date)).ToList();
        foreach (TaskDisplayModel task in oldCompletedTodayTasks)
        {
            // force update: will detect and remove TodayIndex, as well as shift other task indices accordingly if needed
            await DataService.UpdateTaskData(task, true);
        }
    }

    protected override void LoadLocalTaskData()
    {
        if (DataState.IsDataLoaded())
        {
            List<TaskDisplayModel> dueTasks = DataService.GetDataStateTasks()!.Where(x => 
                (x.DueDate <= DateTime.Now.Date) && !x.CleanedUp && 
                (x.DateCompleted == null || x.DateCompleted == DateTime.Now.Date)).ToList();
            List<TaskDisplayModel> starredTasks = DataService.GetDataStateTasks()!.Where(x =>
                (x.Starred == true) && !x.CleanedUp && 
                (x.DateCompleted == null || x.DateCompleted == DateTime.Now.Date)).ToList();
            List<TaskDisplayModel> combinedTodayTasks = dueTasks.Union(starredTasks).ToList();

            // ensure any newly due/overdue tasks have a TodayIndex
            int todayTasksWithTodayIndexCount = combinedTodayTasks.Where(x => x.TodayIndex != null).ToList().Count();
            foreach (TaskDisplayModel task in combinedTodayTasks)
            {
                if (task.DueDate <= DateTime.Now.Date && task.TodayIndex == null)
                {
                    task.TodayIndex = todayTasksWithTodayIndexCount;
                    todayTasksWithTodayIndexCount++;
                }
            }

            _todayTasks = combinedTodayTasks.OrderBy(x => x.TodayIndex).ToList();
            SubscribeToTaskPropertyChangedEvents(_todayTasks);
        }
    }

    public override void Dispose()
    {
        // unsubscribe from event handlers
        base.Dispose(); // for -= AppStateChanged; -= DataStateChanged;
        UnsubscribeFromTaskPropertyChangedEvents(_todayTasks);
    }
}
