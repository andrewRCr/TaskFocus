@inherits AllContextsTaskViewPage
@inject IContextEndpoint ContextEndpoint

@if (ContextParam != null && IsLocalDataLoaded())
{
    <MudStack Style="width:100%;">

        <MudPaper Square Class="mud-background-gray" Elevation="25">
            <MudButton Disabled Class="mx-2">@ContextParam.ContextName</MudButton>
        </MudPaper>

        <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks" ContainerIdentifierParam="@ContextParam.ContextName" ContainerItemsSelectorParam="@ItemsSelector"
                                ContainerProjectsParam="@LocalProjects" ContainerContextsParam="@LocalContexts" />
    </MudStack>
}

<style>
    .mud-button {
        &:disabled
        {
            color: #7e6fff !important;
            cursor: default;
            pointer-events: none;
        }
    }
</style>

@code {
    [Parameter]
    public string ContextId { get; set; } = default!;

    public ContextDisplayModel ContextParam { get; set; } = default!;

    bool isValid = false;
    int integerContextId;

    protected override void OnParametersSet()
    {
       GetContextFromId();
    }

    protected void GetContextFromId()
    {
        isValid = int.TryParse(ContextId, out integerContextId);
        if (isValid)
        {
            ContextParam = DataState.Contexts!.Find(x => x.Id == integerContextId)!;
        }
    }

    public override bool ItemsSelector(TaskDisplayModel item, string dropzone)
    {
        return item.ContextName == dropzone;
    }

    protected override bool HandleDataStateChanged(string propertyName, DataState dataState)
    {
        if (propertyName != nameof(DataState.Contexts))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            LoadAllLocalData();
            GetContextFromId();
            //Console.WriteLine("ProjectTaskViewPage: returned true on HandleDataStateChanged!");
        }

        return AppState.CanRefresh;
    }
}