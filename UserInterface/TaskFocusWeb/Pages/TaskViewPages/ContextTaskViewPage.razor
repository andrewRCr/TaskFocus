@page "/contexts/{ContextId}"
@inherits _TaskViewPageBase
@inject IContextEndpoint ContextEndpoint

<PageTitle>TaskFocus: Contexts</PageTitle>

<MudStack Row="true">

    <ContextSubMenu />

    @if (Context != null && Tasks != null)
    {
        <TaskContainerComponent ContainerTaskItemsParam="@Tasks" ContainerIdentifierParam="@Context.ContextName" ContainerItemsSelectorParam="@ItemsSelector"
                                ContainerProjectsParam="@Projects" ContainerContextsParam="@Contexts" />
    }

</MudStack>

@code {
    [Parameter]
    public string ContextId { get; set; } = default!;

    public ContextModel Context { get; set; } = default!;

    bool isValid = false;
    int integerContextId;

    protected override async Task OnParametersSetAsync()
    {
        await GetContextFromId();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        //StateHasChanged();
    }

    protected async Task GetContextFromId()
    {
        isValid = int.TryParse(ContextId, out integerContextId);
        if (isValid)
        {
            Context = await ContextEndpoint.GetContextById(integerContextId);
        }
    }

    public override bool ItemsSelector(TaskModel item, string dropzone)
    {
        return item.ContextName == dropzone;
    }
}