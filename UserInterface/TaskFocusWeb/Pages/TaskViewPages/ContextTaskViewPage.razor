@inherits AllContextsTaskViewPage
@inject IContextEndpoint ContextEndpoint

@if (ContextParam != null && IsLocalDataLoaded())
{
    <MudTreeView T="TaskContainerComponent" Width="100%">
        <MudTreeViewItem T="TaskContainerComponent" 
                         Expanded="true" 
                         Icon="@Icons.Material.Filled.AutoAwesomeMotion" 
                         Text="@ContextParam.ContextName" 
                         TextTypo="Typo.button">

            <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks" 
                                    ContainerIdentifierParam="@ContextParam.ContextName"
                                    ContainerOrderingTypeParam="Context"
                                    ContainerItemsSelectorParam="@ItemsSelector"
                                    ContainerProjectsParam="@LocalProjects" 
                                    ContainerContextsParam="@LocalContexts" />
        </MudTreeViewItem>
 </MudTreeView>
}

@code {
    [Parameter]
    public string ContextId { get; set; } = default!;

    public ContextDisplayModel ContextParam { get; set; } = default!;

    bool isValid = false;
    int integerContextId;

    protected override void LoadLocalTaskData()
    {
        if (DataState.IsDataLoaded())
        {
            List<TaskDisplayModel> contextTasks = DataState.Tasks!.Where(x => x.ContextId == int.Parse(ContextId)).ToList();
            contextTasks.OrderBy(x => x.ContextIndex);
            LocalTasks = contextTasks;

            foreach (TaskDisplayModel task in LocalTasks!)
            {
                //Console.WriteLine($"{task.TaskName}: {task.ProjectIndex.ToString()}");
                task.PropertyChanged += OnExistingTaskPropertyChanged!; // subscribe to property changed event
            }
        }
    }

    protected override void OnParametersSet()
    {
        GetContextFromId();
        LoadAllLocalData();
    }

    protected void GetContextFromId()
    {
        isValid = int.TryParse(ContextId, out integerContextId);
        if (isValid)
        {
            ContextParam = DataState.Contexts!.Find(x => x.Id == integerContextId)!;
        }
    }

    public override bool ItemsSelector(TaskDisplayModel item, string dropzone)
    {
        return item.ContextName == dropzone;
    }

    protected override bool HandleDataStateChanged(string propertyName, DataState dataState)
    {
        if (propertyName != nameof(DataState.Contexts))
        {
            return false;
        }

        if (AppState.CanRefresh)
        {
            LoadAllLocalData();
            GetContextFromId();
            //Console.WriteLine("ProjectTaskViewPage: returned true on HandleDataStateChanged!");
        }

        return AppState.CanRefresh;
    }
}