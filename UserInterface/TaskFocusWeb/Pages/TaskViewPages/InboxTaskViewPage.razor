@page "/inbox"
@inherits _TaskViewPageBase

<PageTitle>TaskFocus: Inbox</PageTitle>
<h3>Inbox</h3>

<div class="container-fluid">
    <div class="row">

        @if (Tasks != null)
        {
            @foreach (TaskModel task in Tasks)
            {
                @if (task.ProjectId == null || task.ContextId == null)
                {
                    <TaskItemComponent TaskParam="@task" ProjectsParam="@Projects" ContextsParam="@Contexts" />
                }
            }
        }

    </div>

    <div class="row">
        <p>Add new:</p>
        <TaskItemComponent TaskParam="@NewInboxTask" ProjectsParam="@Projects" ContextsParam="@Contexts" />
    </div>
</div>

@code {
    private TaskModel _newInboxTask;
    public TaskModel NewInboxTask
    {
        get { return _newInboxTask; }
        set { _newInboxTask = value; }
    }

    public InboxTaskViewPage()
    {
        _newInboxTask = new();
    }

    protected override async Task LoadTasks()
    {
        await base.LoadTasks();

        // new inbox task input placeholder
        NewInboxTask = new();
    }
}
