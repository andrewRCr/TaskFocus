    <MudButton Color="Color.Primary" Class="mx-2">Inbox</MudButton>
</MudPaper>

<MudDivider /> *@

@if (IsLocalDataLoaded())
{
    <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks" ContainerIdentifierParam="Inbox" ContainerItemsSelectorParam="@ItemsSelector"
                            ContainerProjectsParam="@LocalProjects" ContainerContextsParam="@LocalContexts" />
}

@code {
    private TaskModel _newInboxTask;
    public TaskModel NewInboxTask
    {
        get { return _newInboxTask; }
        set { _newInboxTask = value; }
    }

    public InboxTaskViewPage()
    {
        _newInboxTask = new();
    }

    protected override void CustomAuthenticatedOnInit()
    {
        LoadLocalInboxTaskData();
        LoadLocalProjectData();
        LoadLocalContextData();

        // debug
        // if (DataState.IsDataLoaded() && IsLocalDataLoaded())
        // {
