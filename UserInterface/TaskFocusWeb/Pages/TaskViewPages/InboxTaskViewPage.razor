@page "/inbox"
@inherits _TaskViewPageBase

<PageTitle>TaskFocus: Inbox</PageTitle>

@if (Tasks != null)
{
    <MudDropContainer T="TaskModel" Items="@Tasks" ItemsSelector="@((item, dropzone) => true)" Class="d-flex flex-wrap flex-grow-1">
        <ChildContent>
            <MudDropZone T="TaskModel" Identifier="Inbox" AllowReorder="true" Class="rounded mud-background-gray pa-6 ma-8 flex-grow-1">
                <MudText Typo="Typo.h6" Class="mb-4">Inbox</MudText>
            </MudDropZone>
        </ChildContent>
        <ItemRenderer>
            <MudPaper Elevation="25" Class="pa-0 my-2">
                <TaskItemComponent TaskParam="@context" ProjectsParam="@Projects" ContextsParam="@Contexts" />
            </MudPaper>
        </ItemRenderer>
    </MudDropContainer>
}

@code {
    private TaskModel _newInboxTask;
    public TaskModel NewInboxTask
    {
        get { return _newInboxTask; }
        set { _newInboxTask = value; }
    }

    public InboxTaskViewPage()
    {
        _newInboxTask = new();
    }

    protected override async Task LoadTasks(bool inboxOnly)
    {
        await base.LoadTasks(inboxOnly = true);

        // new inbox task input placeholder
        NewInboxTask = new();
    }
}
