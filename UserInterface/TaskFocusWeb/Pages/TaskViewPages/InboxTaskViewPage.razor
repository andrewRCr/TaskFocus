@page "/inbox"
@inherits _TaskViewPageBase

<PageTitle>TaskFocus: Inbox</PageTitle>

<MudButton Color="Color.Inherit" Class="mx-4 mt-1">Inbox</MudButton>

@if (Tasks != null)
{
    <TaskContainerComponent ContainerTaskItemsParam="@Tasks" ContainerIdentifierParam="Inbox" ContainerItemsSelectorParam="@ItemsSelector"
        ContainerProjectsParam="@Projects" ContainerContextsParam="@Contexts" />
}

@code {
    private TaskModel _newInboxTask;
    public TaskModel NewInboxTask
    {
        get { return _newInboxTask; }
        set { _newInboxTask = value; }
    }

    public InboxTaskViewPage()
    {
        _newInboxTask = new();
    }

    protected override async Task LoadTasks(bool inboxOnly)
    {
        await base.LoadTasks(inboxOnly = true);

        // new inbox task input placeholder
        NewInboxTask = new();
    }

    public override bool ItemsSelector(TaskDisplayModel item, string dropzone)
    {
        return true;
    }
}
