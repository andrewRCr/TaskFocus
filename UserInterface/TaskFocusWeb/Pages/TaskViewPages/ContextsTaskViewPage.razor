@page "/contexts"
@inherits _TaskViewPageBase

<PageTitle>TaskFocus: Contexts</PageTitle>

<MudStack Row="true">
    @if (IsLocalDataLoaded())
    {
        @if (_focusedContext is { Id: int focusedId } focusedContext)
        {
            <MudTreeView @key="focusedId" T="TaskContainerComponent" Width="100%">

                <MudTreeViewItem T="TaskContainerComponent" 
                                 Expanded="true" 
                                 Icon="@Icons.Material.Filled.AutoAwesomeMotion" 
                                 Text="@focusedContext.ContextName" TextTypo="Typo.button">

                    <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks!.GetContextTasks(focusedId)"
                                            ContainerIdentifierParam="@focusedId.ToString()"
                                            ContainerOrderingTypeParam="Context"
                                            ContainerItemsSelectorParam="@((item, _) => item.ContextId == focusedId)"
                                            ContainerProjectsParam="@LocalProjects"
                                            ContainerContextsParam="@LocalContexts" />
                </MudTreeViewItem>
           
            </MudTreeView>
        }
        else if (LocalContexts!.Count > 0) // all contexts view
        {
            <MudTreeView T="TaskContainerComponent" Width="100%">
                @foreach (ContextDisplayModel context in LocalContexts!)
                {
                    <MudTreeViewItem T="TaskContainerComponent" 
                                     Expanded="true" 
                                     Icon="@Icons.Material.Filled.AutoAwesomeMotion" 
                                     Text="@context.ContextName" 
                                     TextTypo="Typo.button">

                        <TaskContainerComponent ContainerTaskItemsParam="@(context.Id is int id
                                                    ? LocalTasks!.GetContextTasks(id)
                                                    : LocalTasks!.Where(x => x.ContextId == null && x.ContextName == context.ContextName && !x.CleanedUp).ToList())"
                                                ContainerIdentifierParam="@(context.Id?.ToString() ?? $"pending-{context.TempLocalId}")"
                                                ContainerOrderingTypeParam="Context"
                                                ContainerItemsSelectorParam="@((item, _) => item.ContextId == context.Id)"
                                                ContainerProjectsParam="@LocalProjects"
                                                ContainerContextsParam="@LocalContexts" />
                    </MudTreeViewItem>              
                }
            </MudTreeView>
        }
        else
        {
            <MudTreeView T="MudContainer" Width="75%">

                <MudTreeViewItem T="MudContainer"
                                 Expanded="true"
                                 Icon="@Icons.Material.Filled.AutoAwesomeMotion"
                                 Text=""
                                 TextTypo="Typo.button">

                    <MudContainer MaxWidth="MaxWidth.Medium">
                        <MudPaper Elevation="25" Class="pa-0 my-2">
                            <MudText Class="pa-4" Align="Align.Center">
                                Group tasks that will be performed in similar conditions by creating and assigning <strong>Contexts</strong>, which will appear here.
                            </MudText>
                        </MudPaper>
                    </MudContainer>

                </MudTreeViewItem>
            </MudTreeView>
        }
    }
</MudStack>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-6">

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <MudAlert Class="mt-6" Elevation="25" Severity="_alertSeverity">@_alertMessage</MudAlert>
    }

</MudContainer>

@code {
    private ContextDisplayModel? _focusedContext;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!AppState.ShowContextSubMenu) { AppState.ShowContextSubMenu = true; }
    }

    protected override void CustomAuthenticatedOnInit()
    {
        LoadAllLocalData();
        ResolveFocusedContext();
    }

    protected override bool IsLocalDataLoaded()
    {
        return LocalTasks != null && LocalProjects != null && LocalContexts != null;
    }

    private void ResolveFocusedContext()
    {
        var selectedId = AppState.FocusedContextIdStr;
        _focusedContext = int.TryParse(selectedId, out var id)
            ? LocalContexts?.Find(x => x.Id == id)
            : null;

        if (selectedId != null && LocalContexts != null && _focusedContext == null)
        {
            AppState.FocusedContextIdStr = null;
        }
    }

    protected override bool HandleAppStateChanged(string propertyName, AppState appState)
    {
        if (propertyName == nameof(AppState.FocusedContextIdStr) ||
            propertyName == nameof(AppState.RequestManualRefresh) ||
            propertyName == nameof(AppState.CanRefresh))
        {
            if (!AppState.CanRefresh) return false;
            if (propertyName != nameof(AppState.FocusedContextIdStr)) LoadAllLocalData();

            ResolveFocusedContext();
            return true;
        }

        return base.HandleAppStateChanged(propertyName, appState);
    }

    protected override bool HandleDataStateChanged(string propertyName, IDataState dataState)
    {
        if (!base.HandleDataStateChanged(propertyName, dataState)) return false;

        ResolveFocusedContext();
        return true;
    }
}
