@page "/contexts"
@inherits _TaskViewPageBase
@inject IDataService DataService

<PageTitle>TaskFocus: Contexts</PageTitle>

<MudStack Row="true">
    @if (IsLocalDataLoaded())
    {
        @if (_focusedContextIdStr != null && ContextParam != null)
        {
            <MudTreeView T="TaskContainerComponent" Width="100%">

                <MudTreeViewItem T="TaskContainerComponent" 
                                 Expanded="true" 
                                 Icon="@Icons.Material.Filled.AutoAwesomeMotion" 
                                 Text="@ContextParam.ContextName" TextTypo="Typo.button">

                    <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks!.Where(x=>(x.ContextId == ContextParam.Id) && !x.CleanedUp).ToList()"
                                            ContainerIdentifierParam="@ContextParam.ContextName"
                                            ContainerOrderingTypeParam="Context"
                                            ContainerItemsSelectorParam="@((item, dropzone) => item.ContextName == dropzone)"
                                            ContainerProjectsParam="@LocalProjects"
                                            ContainerContextsParam="@LocalContexts" />
                </MudTreeViewItem>
           
            </MudTreeView>
        }
        else if (LocalContexts!.Count > 0) // all contexts view
        {
            <MudTreeView T="TaskContainerComponent" Width="100%">
                @foreach (ContextDisplayModel context in LocalContexts!)
                {
                    <MudTreeViewItem T="TaskContainerComponent" 
                                     Expanded="true" 
                                     Icon="@Icons.Material.Filled.AutoAwesomeMotion" 
                                     Text="@context.ContextName" 
                                     TextTypo="Typo.button">

                        <TaskContainerComponent ContainerTaskItemsParam="@LocalTasks!.Where(x=>(x.ContextId == context.Id) && !x.CleanedUp).ToList()"
                                                ContainerIdentifierParam="@context.ContextName"
                                                ContainerOrderingTypeParam="Context"
                                                ContainerItemsSelectorParam="@((item, dropzone) => item.ContextName == dropzone)"
                                                ContainerProjectsParam="@LocalProjects"
                                                ContainerContextsParam="@LocalContexts" />
                    </MudTreeViewItem>              
                }
            </MudTreeView>
        }
        else
        {
            <MudTreeView T="MudContainer" Width="75%">

                <MudTreeViewItem T="MudContainer"
                                 Expanded="true"
                                 Icon="@Icons.Material.Filled.AutoAwesomeMotion"
                                 Text=""
                                 TextTypo="Typo.button">

                    <MudContainer MaxWidth="MaxWidth.Medium">
                        <MudPaper Elevation="25" Class="pa-0 my-2">
                            <MudText Class="pa-4" Align="Align.Center">
                                Group tasks that will be performed in similar conditions by creating and assigning <strong>Contexts</strong>, which will appear here.
                            </MudText>
                        </MudPaper>
                    </MudContainer>

                </MudTreeViewItem>
            </MudTreeView>
        }
    }
</MudStack>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-6">

    @if (!string.IsNullOrEmpty(_alertMessage))
    {
        <MudAlert Class="mt-6" Elevation="25" Severity="_alertSeverity">@_alertMessage</MudAlert>
    }

</MudContainer>

@code {
    private string? _focusedContextIdStr = null;
    public ContextDisplayModel ContextParam { get; set; } = default!;
    bool isValid = false;
    int integerContextId;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!AppState.ShowContextSubMenu) { AppState.ShowContextSubMenu = true; }
    }

    protected override void CustomAuthenticatedOnInit()
    {
        LoadAllLocalData();
        _focusedContextIdStr = AppState.FocusedContextIdStr;
    }

    protected override bool IsLocalDataLoaded()
    {
        return LocalTasks != null && LocalProjects != null & LocalContexts != null;
    }

    protected void GetContextFromId()
    {
        isValid = int.TryParse(_focusedContextIdStr, out integerContextId);
        if (isValid)
        {
            ContextParam = DataService.GetDataStateContexts()!.Find(x => x.Id == integerContextId)!;
        }
    }

    public bool ContextItemsSelector(ContextDisplayModel item, string dropzone)
    {
        return true;
    }

    protected override bool HandleAppStateChanged(String propertyName, AppState appState)
    {
        if (propertyName == nameof(AppState.RequestManualRefresh))
        {
            if (AppState.CanRefresh)
            {
                StateHasChanged();
                return true;
            }
        }
        else if (propertyName != nameof(AppState.FocusedContextIdStr) && !appRefreshTriggers.Contains(propertyName))
        {
            return false;
        }
        else if (AppState.CanRefresh)
        {
            _focusedContextIdStr = appState.FocusedContextIdStr;
            LoadAlertMessage();

            if (_focusedContextIdStr != null)
            {
                GetContextFromId();
            }
        }

        return AppState.CanRefresh;
    }

    protected override bool HandleDataStateChanged(String propertyName, IDataState dataState)
    {
        if (!dataRefreshTriggers.Contains(propertyName)) return false;
        else if (AppState.CanRefresh) LoadAllLocalData();

        return AppState.CanRefresh;
    }
}
