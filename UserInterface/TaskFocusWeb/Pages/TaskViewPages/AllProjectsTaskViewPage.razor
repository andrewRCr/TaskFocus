@page "/projects"
@inherits _TaskViewPageBase
@inject IProjectEndpoint ProjectEndpoint

<MudStack Row="true">

    <ProjectSubMenu />

    @if (Projects != null && Tasks != null)
    {
        <MudDropContainer T="TaskModel" Items="Tasks" ItemsSelector="@((item, dropzone) => item.ProjectName == dropzone)" Class="flex-grow-1">
            <ChildContent>
                <ProjectContainerComponent ContainerProjectItemsParam="@Projects" ContainerItemsSelectorParam="@ProjectItemsSelector" IsExpanded=@_isProjectExpanded />
            </ChildContent>
            <ItemRenderer>
                <MudPaper Class="pa-0 my-2">
                    <TaskItemComponent TaskParam="@context" ProjectsParam="@Projects" ContextsParam="@Contexts" />
                </MudPaper>
            </ItemRenderer>
        </MudDropContainer>
    }

</MudStack>

@code {
    private bool _isProjectExpanded = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        //StateHasChanged();
    }

    public bool ProjectItemsSelector(ProjectModel item, string dropzone)
    {
        return true;
    }
}