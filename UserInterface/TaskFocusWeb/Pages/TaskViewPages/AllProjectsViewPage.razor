@page "/projects"
@inherits _TaskViewPageBase
@inject IProjectEndpoint ProjectEndpoint

@if (Projects != null && Tasks != null)
{
    <MudDropContainer T="TaskModel" Items="Tasks" ItemsSelector="@((item, dropzone) => item.ProjectName == dropzone)" Class="4 flex-grow-1">
        <ChildContent>
            <MudExpansionPanels DisableBorders="true" Elevation="0">
                    <MudDropContainer T="ProjectModel" Items="Projects" ItemsSelector="@((item, dropzone) => true)" Class="5">
                        <ChildContent>
                            <MudDropZone T="ProjectModel" AllowReorder Class="6 rounded mud-background-gray px-4 py-1 ma-4" />
                        </ChildContent>
                        <ItemRenderer>
                            <MudPaper Class="pa-4 my-4">

                                <MudExpansionPanel IsExpanded="@_isExpanded">
                                    <TitleContent>
                                        <div class="d-flex">
                                            <MudText Typo="Typo.h6">@context.ProjectName</MudText>
                                        </div>
                                    </TitleContent>
                                    <ChildContent>
                                        <MudDropZone T="TaskModel" Identifier="@context.ProjectName" AllowReorder Class="rounded mud-background-gray px-4 py-1 ma-4" />
                                    </ChildContent>
                                </MudExpansionPanel>    

                            </MudPaper>
                        </ItemRenderer>
                    </MudDropContainer>
            </MudExpansionPanels>
        </ChildContent>
        <ItemRenderer>
            <MudPaper Class="pa-4 my-4">
                <TaskItemComponent TaskParam="@context" ProjectsParam="@Projects" ContextsParam="@Contexts" />
            </MudPaper>
        </ItemRenderer>
    </MudDropContainer>
}

@code {
    bool _isExpanded = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        StateHasChanged();
    }
}
