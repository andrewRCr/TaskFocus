<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".blat" />
      <remove fileExtension=".dat" />
      <remove fileExtension=".dll" />
      <remove fileExtension=".webcil" />
      <remove fileExtension=".json" />
      <remove fileExtension=".wasm" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".blat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dll" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".webcil" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff" />

      <!-- Sidecars use the MIME type of the original file. -->
      <mimeMap fileExtension=".dat.br" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dat.gz" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".js.br" mimeType="application/javascript" />
      <mimeMap fileExtension=".js.gz" mimeType="application/javascript" />
      <mimeMap fileExtension=".json.br" mimeType="application/json" />
      <mimeMap fileExtension=".json.gz" mimeType="application/json" />
      <mimeMap fileExtension=".wasm.br" mimeType="application/wasm" />
      <mimeMap fileExtension=".wasm.gz" mimeType="application/wasm" />
    </staticContent>
    <urlCompression doStaticCompression="false" doDynamicCompression="true" />
    <httpProtocol>
      <customHeaders>
        <add name="Vary" value="Accept-Encoding" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <rules>
        <rule name="Serve subdir">
          <match url=".*" />
          <action type="Rewrite" url="wwwroot\{R:0}" />
        </rule>
        <!-- An explicit encoding overrides wildcard acceptance. A zero quality excludes an encoding. -->
        <rule name="Serve Brotli sidecar" stopProcessing="true">
          <match url="^wwwroot[\\/]_framework[\\/].*\.(?:dat|js|json|wasm)$" />
          <conditions>
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="(?:(?:^|,)\s*br|^(?!.*(?:^|,)\s*br\s*(?:[;,]|$)).*(?:^|,)\s*\*)\s*(?:;\s*q\s*=\s*(?:1(?:\.0{0,3})?|0\.(?=[0-9]{0,2}[1-9])[0-9]{1,3}))?\s*(?:,|$)" />
            <add input="{REQUEST_FILENAME}.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:0}.br" />
        </rule>
        <rule name="Serve Gzip sidecar" stopProcessing="true">
          <match url="^wwwroot[\\/]_framework[\\/].*\.(?:dat|js|json|wasm)$" />
          <conditions>
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="(?:(?:^|,)\s*gzip|^(?!.*(?:^|,)\s*gzip\s*(?:[;,]|$)).*(?:^|,)\s*\*)\s*(?:;\s*q\s*=\s*(?:1(?:\.0{0,3})?|0\.(?=[0-9]{0,2}[1-9])[0-9]{1,3}))?\s*(?:,|$)" />
            <add input="{REQUEST_FILENAME}.gz" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:0}.gz" />
        </rule>
        <rule name="SPA fallback routing" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="wwwroot\index.html" />
        </rule>
      </rules>
      <outboundRules rewriteBeforeCache="true">
        <rule name="Set Brotli encoding" preCondition="Brotli sidecar response" stopProcessing="true">
          <match serverVariable="RESPONSE_Content_Encoding" pattern=".*" />
          <action type="Rewrite" value="br" />
        </rule>
        <rule name="Set Gzip encoding" preCondition="Gzip sidecar response" stopProcessing="true">
          <match serverVariable="RESPONSE_Content_Encoding" pattern=".*" />
          <action type="Rewrite" value="gzip" />
        </rule>
        <preConditions>
          <preCondition name="Brotli sidecar response">
            <add input="{HTTP_URL}" pattern="^[^?]*\.br(?:\?|$)" />
            <add input="{RESPONSE_STATUS}" pattern="^(?:200|206|304)\b" />
          </preCondition>
          <preCondition name="Gzip sidecar response">
            <add input="{HTTP_URL}" pattern="^[^?]*\.gz(?:\?|$)" />
            <add input="{RESPONSE_STATUS}" pattern="^(?:200|206|304)\b" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
  </system.webServer>
  <!-- Framework sidecars already contain encoded bytes. -->
  <location path="wwwroot/_framework">
    <system.webServer>
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    </system.webServer>
  </location>
  <!-- Worker updates need fresh scripts, and other unversioned app files must revalidate. -->
  <location path="wwwroot/service-worker.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-store" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="wwwroot/service-worker-assets.js">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-store" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="wwwroot/index.html">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="DisableCache" /></staticContent>
    </system.webServer>
  </location>
  <location path="wwwroot/css/app.css">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="DisableCache" /></staticContent>
    </system.webServer>
  </location>
  <location path="wwwroot/TaskFocusWeb.styles.css">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="DisableCache" /></staticContent>
    </system.webServer>
  </location>
  <location path="wwwroot/appsettings.json">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="DisableCache" /></staticContent>
    </system.webServer>
  </location>
  <location path="wwwroot/manifest.json">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="DisableCache" /></staticContent>
    </system.webServer>
  </location>
  <location path="wwwroot/img/favicon">
    <system.webServer>
      <staticContent><clientCache cacheControlMode="DisableCache" /></staticContent>
    </system.webServer>
  </location>
</configuration>
