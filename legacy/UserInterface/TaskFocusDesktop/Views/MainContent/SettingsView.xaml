<UserControl x:Class="TaskFocusDesktop.Views.MainContent.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views.MainContent"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:components="clr-namespace:TaskFocusDesktop.Views.Components"   
             xmlns:customControls="clr-namespace:TaskFocusDesktop.CustomControls"
             xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities" 
             xmlns:maincontent="clr-namespace:TaskFocusDesktop.ViewModels.MainContent" 
             d:DataContext="{d:DesignInstance Type=maincontent:SettingsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200"
             Style="{StaticResource BaseMainContentViewStyle}" >

    <Grid x:Name="MainGridBackground" 
          Focusable="True" 
          Background="Transparent" 
          PreviewMouseDown="MainGridBackground_PreviewMouseDown" >

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- preferences header  -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="10 10 0 10" >

            <materialDesign:PackIcon Kind="Cog"
                                     VerticalAlignment="Center"
                                     Margin="10 0 10 0"
                                     Foreground="{StaticResource ForegroundMainBrush}"
                                     Height="24"
                                     Width="24" />

            <TextBlock Style="{StaticResource HeaderTextStyle}"
                       VerticalAlignment="Center" Margin="0 2 0 0"
                       Text="PREFERENCES" />

        </StackPanel>

        <!-- PREFERENCE CONTROLS -->
        <StackPanel Grid.Row="1" 
                    Orientation="Vertical"
                    Margin="55 10 0 0" >

            <TextBlock TextWrapping="Wrap"
                       FontSize="14" 
                       Margin="0 0 0 5"
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center"
                       utilities:TextBlockHelper.TrimRuns="True" >

                <TextBlock.Inlines>
                    <Run Text="Automatically  "/>
                    <Run FontWeight="Bold" Text="clean up" />
                    <Run Text="  completed tasks:" />
                </TextBlock.Inlines>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Height="30" Margin="0 0 0 15">

                <RadioButton IsChecked="{Binding LocalSettings.CleanUpImmediately}"
                             Margin="0 0 15 0" >
                    <RadioButton.Content>
                        <TextBlock Text="Immediately"
                                   FontSize="14" >

                            <TextBlock.Style>
                                <Style>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=LocalSettings.CleanUpImmediately}"
                                                     Value="False" >
                                            <DataTrigger.Setters>
                                                <Setter Property="TextBlock.Foreground" Value="{StaticResource ForegroundTertiaryBrush}" />

                                            </DataTrigger.Setters>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>

                        </TextBlock>
                    </RadioButton.Content>
                </RadioButton>

                <RadioButton x:Name="nonImmediateCleanUpRadio"
                             IsChecked="{Binding Path=LocalSettings.CleanUpImmediately,
                                         Converter={StaticResource InverseBooleanConverter}}" />

                <customControls:NumericUpDown Value="{Binding LocalSettings.CleanUpDelayDays, Mode=TwoWay}"
                                              Maximum="90"
                                              Minimum="1"
                                              IsEnabled="{Binding LocalSettings.CleanUpImmediately,
                                              Converter={StaticResource InverseBooleanConverter}}"
                                              EnabledButtonColor="{StaticResource ForegroundHighlightBrush}"
                                              DisabledButtonColor="{StaticResource WindowsFrameBrush}" />

                <TextBlock Text="{Binding CleanDaysTextStr}"
                           Margin="8 0 0 0"
                           FontSize="14"
                           VerticalAlignment="Center" >

                    <TextBlock.Style>
                        <Style>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=LocalSettings.CleanUpImmediately}"
                                             Value="True" >
                                    <DataTrigger.Setters>
                                        <Setter Property="TextBlock.Foreground" Value="{StaticResource ForegroundTertiaryBrush}" />

                                    </DataTrigger.Setters>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>

                </TextBlock>

            </StackPanel>

            <TextBlock TextWrapping="Wrap"
                       FontSize="14" 
                       Margin="0 0 0 5"
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center"
                       utilities:TextBlockHelper.TrimRuns="True" >

                <TextBlock.Inlines>
                    <Run Text="Automatically  "/>
                    <Run FontWeight="Bold" Text="delete" />
                    <Run Text="  completed tasks:" />
                </TextBlock.Inlines>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Height="30" >

                <customControls:NumericUpDown Value="{Binding LocalSettings.DeleteDelayDays, Mode=TwoWay}"
                                              Margin="0 0 0 0"
                                              Minimum="1"
                                              Maximum="90"
                                              EnabledButtonColor="{StaticResource ForegroundHighlightBrush}"
                                              DisabledButtonColor="{StaticResource WindowsFrameBrush}" />

                <TextBlock Text="{Binding DeleteDaysTextStr}"
                           Margin="8 0 0 0"
                           FontSize="14"
                           VerticalAlignment="Center" />

            </StackPanel>

        </StackPanel>

        <!-- account/profile header  -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="10 40 0 10" >

            <materialDesign:PackIcon Kind="AccountCircle"
                                     VerticalAlignment="Center"
                                     Margin="10 0 10 0"
                                     Foreground="{StaticResource ForegroundMainBrush}"
                                     Height="24"
                                     Width="24" />

            <TextBlock Style="{StaticResource HeaderTextStyle}"
                       VerticalAlignment="Center" Margin="0 2 0 0"
                       Text="PROFILE" />

        </StackPanel>

        <!-- ACCOUNT CONTROLS -->
        <StackPanel Grid.Row="3" 
                    Orientation="Vertical"
                    Margin="55 10 0 0" >

            <StackPanel Orientation="Horizontal">

                <TextBox x:Name="firstNameInput"
                         Text="{Binding LocalCurrentUser.FirstName}"
                         Margin="0 0 15 20"
                         Width="150"
                         FontSize="14"
                         materialDesign:HintAssist.HelperTextFontSize="12"
                         materialDesign:HintAssist.HelperText="First Name" />

                <TextBox x:Name="lastNameInput"
                         Text="{Binding LocalCurrentUser.LastName}"
                         Margin="0 0 00 20"
                         Width="150"
                         FontSize="14"
                         materialDesign:HintAssist.HelperTextFontSize="12"
                         materialDesign:HintAssist.HelperText="Last Name" />

            </StackPanel>

            <TextBox x:Name="emailAddressPlaceholder"
                     Text="{Binding LocalCurrentUser.Email}"
                     IsReadOnly="True"
                     Margin="0 10 0 20"
                     Width="315"
                     HorizontalAlignment="Left"
                     FontSize="14"
                     materialDesign:HintAssist.HelperTextFontSize="12"
                     materialDesign:HintAssist.HelperText="Email Address" />

            <StackPanel Orientation="Horizontal" Margin="0 15 0 0">

                <Button Content="UPDATE EMAIL"
                        Command="{Binding RequestUpdateEmailDialogCommand}"
                        Style="{StaticResource dialogSubmitButtonStyle}"
                        Margin="0 0 15 0" />

                <Button Content="CHANGE PASSWORD"
                        Command="{Binding RequestChangePasswordDialogCommand}"
                        Style="{StaticResource dialogSubmitButtonStyle}" />

            </StackPanel>
       
        </StackPanel>

        <!-- sync header  -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="10 40 0 10" >

            <materialDesign:PackIcon Kind="Sync"
                                     VerticalAlignment="Center"
                                     Margin="10 0 10 0"
                                     Foreground="{StaticResource ForegroundMainBrush}"
                                     Height="24"
                                     Width="24" />

            <TextBlock Style="{StaticResource HeaderTextStyle}"
                       VerticalAlignment="Center" Margin="0 2 0 0"
                       Text="DATA SYNCHRONIZATION" />

        </StackPanel>

        <!-- SYNC METADATA  -->
        <StackPanel Grid.Row="5" 
                    Orientation="Vertical"
                    Margin="55 10 0 0" >

            <StackPanel Orientation="Vertical">

                <TextBlock FontSize="14" 
                           Margin="0 0 0 0"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center"
                           utilities:TextBlockHelper.TrimRuns="True" >

                    <TextBlock.Inlines>
                        <Run Text="Last synchronized:  "/>
                        <Run Text="{Binding LastSyncStr}" />
                    </TextBlock.Inlines>
                </TextBlock>

                <TextBlock FontSize="14" 
                           Margin="0 0 0 8"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center"
                           utilities:TextBlockHelper.TrimRuns="True" >

                    <TextBlock.Inlines>
                        <Run Text="Last sync result:  "/>
                        <Run Text="{Binding LastSyncResultStr}" />
                    </TextBlock.Inlines>
                </TextBlock>

                <TextBlock FontSize="14" 
                           Margin="0 0 0 5"
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center"
                           utilities:TextBlockHelper.TrimRuns="True" >

                    <TextBlock.Inlines>
                        <Run Text="Next automatic background sync:  "/>
                        <Run Text="{Binding NextSyncStr}" />
                    </TextBlock.Inlines>
                </TextBlock>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 15 0 0">

                <Button Content="MANUAL SYNC"
                        IsEnabled="{Binding EnableManualSyncButton}"
                        Command="{Binding RequestManualDataSyncCommand}"
                        Style="{StaticResource dialogSubmitButtonStyle}"
                        Margin="0 0 15 0" />


            </StackPanel>

        </StackPanel>

    </Grid>

</UserControl>
