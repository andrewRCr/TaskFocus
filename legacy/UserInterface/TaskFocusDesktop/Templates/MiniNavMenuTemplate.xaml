<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:utilities="clr-namespace:TaskFocusDesktop.Utilities" >
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Styles/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <utilities:ActiveMainViewToVisibilityConverter x:Key="ActiveMainViewToVisibilityConverter" />

    <Style TargetType="materialDesign:PackIcon" x:Key="MiniNavMenuIconStyle">
        <Setter Property="Height" Value="24" />
        <Setter Property="Width" Value="24" />

        <Setter Property="Foreground">
            <Setter.Value>
                <Binding Path="DataContext.MiniNavIconColor" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}" />
            </Setter.Value>
        </Setter>

    </Style>

    <!-- // MiniNavMenu MenuItem template // -->
    <ControlTemplate x:Key="MiniNavMenuItem_Template"
                     TargetType="{x:Type MenuItem}" >

        <Border x:Name="MenuItemBorder"              
                BorderThickness="0"
                Height="50"
                Width="60" >

            <Grid>
                
                <!-- icon --> 
                <ContentPresenter x:Name="Icon"
                                  ContentSource="Icon"
                                  HorizontalAlignment="Center"  
                                  Margin="0,0,0,0"
                                  VerticalAlignment="Center" />

                <!-- selected indicator (background) -->
                <Border x:Name="SelectedIndicatorBorder" 
                        Panel.ZIndex="-1"
                        Height="50"
                        Width="60" 
                        Margin="0"
                        Background="{StaticResource BackgroundMidGreyBrush}" >

                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource ActiveMainViewToVisibilityConverter}">
                            <Binding Path="Header" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type MenuItem}}"/>
                            <Binding Path="DataContext.ActiveMainContentView" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}"/>
                        </MultiBinding>
                    </Border.Visibility>
                </Border>

            </Grid>

        </Border>

        <ControlTemplate.Triggers>

            <Trigger Property="IsHighlighted"
                     Value="True">
                <Setter TargetName="MenuItemBorder"
                        Property="Background"
                        Value="{StaticResource BackgroundMidGreyBrush}" />
            </Trigger>

        </ControlTemplate.Triggers>

    </ControlTemplate>

    <!-- // MiniNavMenu template // -->
    <ControlTemplate x:Key="MiniNavMenu_Template" TargetType="Menu">

        <Menu Margin="0 0 0 0" >

            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>

            <MenuItem Header="Inbox" 
                      Foreground="{StaticResource ForegroundMainBrush}"
                      Template="{StaticResource MiniNavMenuItem_Template}"
                      Command="{Binding SwitchToInboxViewCommand}" >

                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Inbox" Style="{StaticResource MiniNavMenuIconStyle}" />
                </MenuItem.Icon>

            </MenuItem>

            <MenuItem Header="Today"
                      Foreground="{StaticResource ForegroundMainBrush}"
                      Template="{StaticResource MiniNavMenuItem_Template}"
                      Command="{Binding SwitchToTodayViewCommand}" >

                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="CalendarToday" Style="{StaticResource MiniNavMenuIconStyle}" />
                </MenuItem.Icon>

            </MenuItem>

            <MenuItem Header="Projects" 
                      Foreground="{StaticResource ForegroundMainBrush}"
                      Template="{StaticResource MiniNavMenuItem_Template}"
                      Command="{Binding SwitchToProjectsViewCommand}">

                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ClipboardText" Style="{StaticResource MiniNavMenuIconStyle}" />
                </MenuItem.Icon>

            </MenuItem>

            <MenuItem Header="Contexts" 
                      Foreground="{StaticResource ForegroundMainBrush}"
                      Template="{StaticResource MiniNavMenuItem_Template}"
                      Command="{Binding SwitchToContextsViewCommand}">

                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Animation" Style="{StaticResource MiniNavMenuIconStyle}" />
                </MenuItem.Icon>

            </MenuItem>

            <MenuItem Header="Completed" 
                      Foreground="{StaticResource ForegroundCompletedBrush}"
                      Template="{StaticResource MiniNavMenuItem_Template}"
                      Command="{Binding SwitchToCompletedViewCommand}">

                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="PlaylistCheck" Foreground="{StaticResource ForegroundCompletedBrush}" Style="{StaticResource MiniNavMenuIconStyle}" />
                </MenuItem.Icon>

            </MenuItem>

        </Menu>

    </ControlTemplate>

</ResourceDictionary>