<UserControl x:Class="TaskFocusDesktop.Views.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views"
             mc:Ignorable="d" Background="White" FontSize="14" FontFamily="Bahnschrift"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- view title -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,50" 
                   Grid.RowSpan="2" FontSize="18">Inbox</TextBlock>

        <!-- for each task in Inbox: -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0"
                    Grid.ColumnSpan="3" Margin="5 5 5 5">

            <!--<Button x:Name="ReorderButton" Height="auto" Margin="0 0 0 0">:</Button>-->

            <!-- completion checkbox -->
            <CheckBox Padding="3" Margin="10 0 0 3" VerticalAlignment="Center" />

            <!-- task Name value-->
            <TextBlock Text="TaskName" Margin="15 5 5 5" MinWidth="135" VerticalAlignment="Center" />

            <!-- project dropdown -->
            <ComboBox Text="Project" Margin="5 5 5 5" MinWidth="150" VerticalAlignment="Center"
                      IsEditable="True">
                <!-- for each project user has:-->
                <ComboBoxItem>ProjectName</ComboBoxItem>
            </ComboBox>

            <!-- context dropdown -->
            <ComboBox Text="Context" Margin="10 5 5 5" MinWidth="150" VerticalAlignment="Center"
                      IsEditable="True">
                <!-- for each context user has:-->
                <ComboBoxItem>ContextName</ComboBoxItem>
            </ComboBox>

            <!-- due date datepicker -->
            <DatePicker Text="Due" Margin="10 5 5 4" VerticalAlignment="Center" />

        </StackPanel>

    </Grid>
</UserControl>
