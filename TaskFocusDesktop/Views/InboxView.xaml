<UserControl x:Class="TaskFocusDesktop.Views.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskFocusDesktop.Views"
             mc:Ignorable="d" Background="White" FontSize="14" FontFamily="Bahnschrift"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <DataTemplate x:Key="TaskItem">
            <StackPanel Orientation="Horizontal" Margin="5 5 5 5">

                <!-- completion checkbox -->
                <CheckBox IsChecked="{Binding Completed}" Padding="3" Margin="10 0 0 3" VerticalAlignment="Center" />

                <!-- task Name value-->
                <TextBox Text="{Binding TaskName}" Margin="15 5 5 5" MinWidth="200" MaxWidth="250" VerticalAlignment="Center"
                         TextWrapping="Wrap" BorderThickness="0"/>

                <!-- project dropdown -->
                <ComboBox Text="{Binding ProjectName}" Margin="5 5 5 5" MinWidth="150" VerticalAlignment="Center"
                      IsEditable="True" Visibility="Visible" 
                      ItemsSource="{Binding DataContext.Projects, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      DisplayMemberPath="ProjectName" />

                <!-- context dropdown -->
                <ComboBox Text="Context" Margin="10 5 5 5" MinWidth="150" VerticalAlignment="Center"
                      IsEditable="True" BorderThickness="0">
                    <!-- for each context user has:-->
                    <ComboBoxItem>ContextName</ComboBoxItem>
                </ComboBox>

                <!-- due date datepicker -->
                <DatePicker Text="Due" Margin="10 5 5 4" VerticalAlignment="Center" BorderThickness="0" />

            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>
    
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- view title -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,0,50" 
                   Grid.RowSpan="1" FontSize="18">Inbox</TextBlock>
        
        <!-- inbox tasks -->
        <ListBox ItemsSource="{Binding Path=Tasks}"
                 ItemTemplate="{StaticResource TaskItem}"
                 SelectedItem="{Binding SelectedTask}"
                 Grid.Row="1" Grid.Column="0"
                 Grid.ColumnSpan="2"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

    </Grid>
    
</UserControl>
